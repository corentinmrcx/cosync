# Copiez ce fichier en .env.local et ajustez les valeurs
# cp .env.local.example .env.local

APP_SECRET=une_chaine_aleatoire_32_caracteres_min

# Google Drive Service Account (contenu JSON encodé en base64 ou chemin vers le fichier)
GOOGLE_DRIVE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
GOOGLE_DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# HelloAsso — utiliser la sandbox en local
# HelloAsso refuse les URLs de retour en http:// : pour tester le paiement en local,
# passer par un tunnel HTTPS (cloudflared tunnel --url http://localhost:8080).
HELLOASSO_API_BASE_URL=https://api.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=

# En prod : remplacer par Brevo ou SMTP Gmail
# MAILER_DSN=smtp://user:password@smtp.gmail.com:587
