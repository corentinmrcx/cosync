# Modèle de .env.local — secrets de développement, jamais committés.
# cp .env.local.example .env.local
#
# Rappel de l'ordre de chargement Symfony (le dernier gagne) :
#   .env → .env.local → .env.dev → .env.dev.local
# Inutile de définir APP_SECRET ici : .env.dev fournit déjà un secret de dev
# et serait chargé après. En prod, tout vient de .env.prod (cf. .env.prod.example).

# Google Drive Service Account : chemin vers le JSON, ou contenu JSON inline
GOOGLE_DRIVE_CREDENTIALS_JSON=/chemin/vers/google-drive.json
GOOGLE_DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# HelloAsso — utiliser la sandbox en local
# HelloAsso refuse les URLs de retour en http:// : pour tester le paiement en local,
# passer par un tunnel HTTPS (cloudflared tunnel --url http://localhost:8080).
HELLOASSO_API_BASE_URL=https://api.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=

# Email du super-admin : accès à /admin/diagnostic + destinataire des mails
# redirigés en mode beta
DIAG_EMAIL=

# Par défaut les mails partent vers Mailpit (smtp://localhost:1025, cf. .env).
# Décommenter pour tester un vrai SMTP :
# MAILER_DSN=smtp://user:password@smtp.gmail.com:587
