# Copier en .env.prod sur le VPS (jamais commité)
# cp .env.prod.example .env.prod

APP_ENV=prod
APP_SECRET=                          # openssl rand -hex 32
DEFAULT_URI=https://cosync.mondomaine.fr

POSTGRES_DB=cosync
POSTGRES_USER=cosync
POSTGRES_PASSWORD=                   # mot de passe fort
DATABASE_URL="postgresql://cosync:POSTGRES_PASSWORD@database:5432/cosync?serverVersion=16&charset=utf8"

# Brevo (ex-Sendinblue) ou SMTP Gmail
MAILER_DSN=smtp://user:password@smtp.brevo.com:587

GOOGLE_DRIVE_CREDENTIALS_JSON=       # contenu JSON du service account
GOOGLE_DRIVE_FOLDER_ID=              # ID du dossier Drive racine

# HelloAsso — paiement en ligne des cotisations
HELLOASSO_API_BASE_URL=https://api.helloasso.com
HELLOASSO_CLIENT_ID=                 # espace HelloAsso > Intégrations et API
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=                  # slug de l'asso, ex: foyer-de-soudron
HELLOASSO_WEBHOOK_SECRET=            # optionnel, comptes partenaires uniquement
# URL de notification à déclarer côté HelloAsso : https://<domaine>/webhook/helloasso

# Diagnostic / Beta — email du super-admin (toi seul)
# Donne accès à /admin/diagnostic et reçoit les mails redirigés en mode beta
DIAG_EMAIL=                          # ex: corentinmarcoux51@gmail.com
