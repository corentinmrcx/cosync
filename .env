# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
DEFAULT_URI=http://localhost:8080
###< symfony/framework-bundle ###

###> database ###
POSTGRES_DB=cosync
POSTGRES_USER=cosync
POSTGRES_PASSWORD=cosync
DATABASE_URL="postgresql://cosync:cosync@127.0.0.1:5432/cosync?serverVersion=16&charset=utf8"
###< database ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> google drive ###
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=
###< google drive ###

###> helloasso ###
# Paiement en ligne des cotisations (HelloAsso Checkout)
# Sandbox : https://api.helloasso-sandbox.com — Prod : https://api.helloasso.com
HELLOASSO_API_BASE_URL=https://api.helloasso.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
# Optionnel : signature des notifications, réservée aux comptes partenaires.
# Vide = vérification de signature ignorée (l'authenticité est de toute façon
# revalidée en rappelant l'API HelloAsso avant tout enregistrement).
HELLOASSO_WEBHOOK_SECRET=
###< helloasso ###

###> diagnostic / beta ###
# Email du super-admin : seul cet utilisateur a accès à la page diagnostic
# En mode beta, tous les mails réels sont redirigés vers cet email
DIAG_EMAIL=
###< diagnostic / beta ###
