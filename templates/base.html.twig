<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}CoSync — {{ club_nom }}{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg">
        <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png">
        <link rel="shortcut icon" href="/images/favicon/favicon.ico">
        <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
        <link rel="manifest" href="/images/favicon/site.webmanifest">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block head %}{% endblock %}
    </head>
    <body>
        <div id="loader-bar" class="loader-bar"></div>

        {# Les pages publiques vident ces trois blocs : elles n'ont ni navbar admin,
           ni la même coquille de contenu. #}
        {% block navbar %}{% include 'components/navbar.html.twig' %}{% endblock %}

        {% block corps %}
            <main class="main-content">
                {% block body %}{% endblock %}
            </main>
        {% endblock %}

        {% block footer %}{% include 'components/footer.html.twig' %}{% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        {% block scripts %}{% endblock %}
    </body>
</html>
