{% extends 'base.html.twig' %}

{% block title %}Inscription confirmée – FC Soudron{% endblock %}

{% block body %}
<div class="min-h-screen" style="background-color: var(--color-bg-subtle);">

    <header class="px-4 py-4 shadow-sm" style="background-color: var(--color-primary); color: white;">
        <p class="font-bold text-lg">FC Soudron</p>
        <p class="text-sm opacity-75">Formulaire d'inscription {{ licencie.season.label }}</p>
    </header>

    <div class="max-w-lg mx-auto px-4 py-8 text-center">

        <div class="text-4xl mb-4">✅</div>
        <h1 class="text-xl font-bold mb-2" style="color: var(--color-text-base);">
            Merci {{ licencie.prenom }} !
        </h1>
        <p class="text-sm mb-6" style="color: var(--color-text-body);">
            Votre formulaire d'inscription a bien été enregistré.
        </p>

        {% if dossier.paymentIntention %}
            <div class="text-left p-4 rounded border mb-6" style="border-color: var(--color-border); background-color: var(--color-bg-page);">
                <p class="text-sm font-semibold mb-2" style="color: var(--color-text-base);">
                    Récapitulatif du paiement
                </p>
                <p class="text-sm mb-1" style="color: var(--color-text-body);">
                    Montant : <strong>{{ montant }} €</strong>
                </p>
                <p class="text-sm" style="color: var(--color-text-body);">
                    Mode choisi : <strong>{{ dossier.paymentIntention.label() }}</strong>
                </p>

                {% if dossier.paymentIntention.value == 'virement' %}
                    <div class="mt-3 pt-3 text-sm" style="border-top: 1px solid var(--color-border); color: var(--color-text-body);">
                        <p>IBAN : <strong>FR76 XXXX XXXX XXXX XXXX XXXX XXX</strong></p>
                        <p>BIC : <strong>XXXXXXXX</strong></p>
                        <p class="mt-1">Libellé : <strong>COTISATION {{ licencie.nom }} {{ licencie.season.label }}</strong></p>
                    </div>
                {% elseif dossier.paymentIntention.value in ['cheque', 'especes', 'pass_sport', 'caf', 'ancv'] %}
                    <p class="mt-3 text-sm pt-3" style="border-top: 1px solid var(--color-border); color: var(--color-text-muted);">
                        À remettre à un dirigeant du club ou lors d'une permanence.
                    </p>
                {% elseif dossier.paymentIntention.value == 'cb_online' %}
                    <p class="mt-3 text-sm pt-3" style="border-top: 1px solid var(--color-border); color: var(--color-text-muted);">
                        Le lien de paiement SumUp vous sera transmis par le club.
                    </p>
                {% endif %}
            </div>
        {% endif %}

        <p class="text-xs" style="color: var(--color-text-muted);">
            Votre inscription sera définitivement validée dès réception du paiement.<br>
            Pour toute question, contactez le club directement.
        </p>
    </div>

</div>
{% endblock %}
