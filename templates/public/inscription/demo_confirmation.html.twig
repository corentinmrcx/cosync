{% extends 'public/layout.html.twig' %}

{% block title %}Démonstration terminée – Foyer de Soudron{% endblock %}

{% block entete_extra %}
    {% include 'components/_progression.html.twig' with { total: 5 } only %}
{% endblock %}

{% block contenu %}
    <div class="inscription-demo-banner">
        Mode démonstration — aucune donnée n'a été enregistrée.
    </div>


    <div class="inscription-card">
        <div class="inscription-confirm-icon">✅</div>
        <h1 class="inscription-confirm-title">Démonstration terminée !</h1>
        <p class="inscription-confirm-text">
            Voici à quoi ressemble la fin du parcours d'inscription.
            Dans la vraie inscription, le formulaire serait enregistré et le règlement
            signé archivé sur le Drive du club.
        </p>
        <p class="inscription-confirm-text">
            Ici, <strong>rien n'a été enregistré</strong> : ni en base de données, ni sur le Drive.
        </p>

        <a href="{{ path('public_inscription_demo_show') }}" class="inscription-btn-start" style="margin-top: 1.5rem; text-align: center;">
            Recommencer la démo
        </a>
    </div>
{% endblock %}
