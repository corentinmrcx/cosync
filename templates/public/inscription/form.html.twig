{% extends 'public/layout.html.twig' %}

{% block title %}Inscription – Foyer de Soudron{% endblock %}

{% block head %}
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js" defer></script>
{% endblock %}

{% block body %}
<div class="inscription-page"
     x-data="inscriptionForm({ isEcoleFoot: {{ licencie.category.isEcoleFoot ? 'true' : 'false' }}, montant: {{ montant }} })">

    {# — Header — #}
    <header class="inscription-header">
        <div class="inscription-header-top">
            <span class="inscription-header-club">Foyer de Soudron</span>
            <span class="inscription-header-step" x-text="`Étape ${step} sur 5`"></span>
        </div>
        <div class="inscription-progress">
            {% for i in 1..5 %}
                <div class="inscription-progress-segment"
                     :class="step >= {{ i }} ? 'inscription-progress-segment-done' : ''"></div>
            {% endfor %}
        </div>
    </header>

    {# — Flash — #}
    {% for message in app.flashes('error') %}
        <div class="inscription-flash-error">{{ message }}</div>
    {% endfor %}

    <main class="inscription-main">
        <div class="inscription-container">

            <form method="post" action="{{ path('public_inscription_submit', {uuid: licencie.uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('inscription_submit') }}">
                <input type="hidden" name="signature_data" :value="signatureData">

                {# ── Étape 1 : Bienvenue ── #}
                <div x-show="step === 1" class="inscription-card">
                    {% if licencie.category.isJeune %}
                        <h1 class="inscription-welcome-name">Bonjour 👋</h1>
                        <p class="inscription-welcome-text">
                            Inscription de <strong>{{ licencie.prenom }}</strong> au <strong>Foyer de Soudron</strong> pour la saison <strong>{{ licencie.season.label }}</strong>.
                        </p>
                    {% else %}
                        <h1 class="inscription-welcome-name">Bonjour {{ licencie.prenom }} 👋</h1>
                        <p class="inscription-welcome-text">
                            Bienvenue dans le formulaire d'inscription au <strong>Foyer de Soudron</strong> pour la saison <strong>{{ licencie.season.label }}</strong>.
                        </p>
                    {% endif %}
                    <p class="inscription-welcome-text">
                        Ce formulaire vous prendra environ <strong>3 minutes</strong>. Vous renseignerez vos tailles d'équipement, vos autorisations et signerez le règlement intérieur.
                    </p>
                    <button type="button" @click="next" class="inscription-btn-start">
                        Commencer →
                    </button>
                </div>

                {# ── Étape 2 : Équipement ── #}
                <div x-show="step === 2" class="inscription-card">
                    <h2 class="inscription-step-title">Tailles d'équipement</h2>
                    <div class="inscription-fields">

                        <div class="inscription-field">
                            <label class="inscription-label" for="taille_haut">Taille haut *</label>
                            <select id="taille_haut" name="taille_haut" x-model="tailleHaut" required class="inscription-select">
                                <option value="">— Choisir —</option>
                                <optgroup label="Tailles enfants">
                                    <option value="6 ans">6 ans</option>
                                    <option value="8 ans">8 ans</option>
                                    <option value="10 ans">10 ans</option>
                                    <option value="12 ans">12 ans</option>
                                    <option value="14 ans">14 ans</option>
                                    <option value="16 ans">16 ans</option>
                                </optgroup>
                                <optgroup label="Tailles adultes">
                                    <option value="XS">XS</option>
                                    <option value="S">S</option>
                                    <option value="M">M</option>
                                    <option value="L">L</option>
                                    <option value="XL">XL</option>
                                    <option value="XXL">XXL</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="inscription-field">
                            <label class="inscription-label" for="taille_bas">Taille bas *</label>
                            <select id="taille_bas" name="taille_bas" x-model="tailleBas" required class="inscription-select">
                                <option value="">— Choisir —</option>
                                <optgroup label="Tailles enfants">
                                    <option value="6 ans">6 ans</option>
                                    <option value="8 ans">8 ans</option>
                                    <option value="10 ans">10 ans</option>
                                    <option value="12 ans">12 ans</option>
                                    <option value="14 ans">14 ans</option>
                                    <option value="16 ans">16 ans</option>
                                </optgroup>
                                <optgroup label="Tailles adultes">
                                    <option value="XS">XS</option>
                                    <option value="S">S</option>
                                    <option value="M">M</option>
                                    <option value="L">L</option>
                                    <option value="XL">XL</option>
                                    <option value="XXL">XXL</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="inscription-field">
                            <label class="inscription-label" for="pointure">Pointure *</label>
                            <select id="pointure" name="pointure" x-model="pointure" required class="inscription-select">
                                <option value="">— Choisir —</option>
                                {% for p in range(28, 48) %}
                                    <option value="{{ p }}">{{ p }}</option>
                                {% endfor %}
                            </select>
                        </div>

                    </div>
                </div>

                {# ── Étape 3 : Autorisations ── #}
                <div x-show="step === 3" class="inscription-card">
                    <h2 class="inscription-step-title">Autorisations</h2>
                    <div class="inscription-fields">

                        <div class="inscription-question-block">
                            <span class="inscription-question-label">Droit à l'image *</span>
                            <span class="inscription-question-hint">Autorisation de diffuser des photos/vidéos du licencié sur les supports du club.</span>
                            <div class="inscription-radio-group">
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_photo" value="1" x-model="autorisationPhoto">
                                    <span class="inscription-radio-label">Oui</span>
                                </label>
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_photo" value="0" x-model="autorisationPhoto">
                                    <span class="inscription-radio-label">Non</span>
                                </label>
                            </div>
                        </div>

                        <template x-if="isEcoleFoot">
                            <div class="inscription-fields">
                                <hr class="inscription-question-divider">

                                <div class="inscription-question-block">
                                    <span class="inscription-question-label">Transport par les dirigeants *</span>
                                    <span class="inscription-question-hint">Autorisation que votre enfant soit transporté par les dirigeants du club lors des déplacements.</span>
                                    <div class="inscription-radio-group">
                                        <label class="inscription-radio-option">
                                            <input type="radio" name="autorisation_transport_dirigeants" value="1" x-model="autorisationTransportDirigeants">
                                            <span class="inscription-radio-label">Oui</span>
                                        </label>
                                        <label class="inscription-radio-option">
                                            <input type="radio" name="autorisation_transport_dirigeants" value="0" x-model="autorisationTransportDirigeants">
                                            <span class="inscription-radio-label">Non</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="inscription-question-block">
                                    <span class="inscription-question-label">Transport par d'autres parents *</span>
                                    <span class="inscription-question-hint">Autorisation que votre enfant soit transporté par d'autres parents lors des déplacements.</span>
                                    <div class="inscription-radio-group">
                                        <label class="inscription-radio-option">
                                            <input type="radio" name="autorisation_transport_parents" value="1" x-model="autorisationTransportParents">
                                            <span class="inscription-radio-label">Oui</span>
                                        </label>
                                        <label class="inscription-radio-option">
                                            <input type="radio" name="autorisation_transport_parents" value="0" x-model="autorisationTransportParents">
                                            <span class="inscription-radio-label">Non</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </template>

                    </div>
                </div>

                {# ── Étape 4 : Règlement + Signature ── #}
                <div x-show="step === 4" class="inscription-card">
                    <h2 class="inscription-step-title">Règlement intérieur</h2>

                    <div class="inscription-reglement">
                        {% if licencie.season.reglementText %}
                            {{ licencie.season.reglementText|raw }}
                        {% else %}
                            <p class="inscription-reglement-empty">Aucun règlement n'a encore été défini pour cette saison. Contactez le club.</p>
                        {% endif %}
                    </div>

                    <label class="inscription-checkbox-row">
                        <input type="checkbox" x-model="hasRead">
                        <span class="inscription-checkbox-text">J'ai lu et j'accepte le règlement intérieur du Foyer de Soudron.</span>
                    </label>

                    <div x-show="hasRead">
                        <p class="inscription-signature-label">Signature *</p>
                        <p class="inscription-signature-hint">Signez dans le cadre ci-dessous avec votre doigt ou votre souris.</p>
                        <div class="inscription-signature-wrap">
                            <canvas class="inscription-signature-canvas" x-ref="signatureCanvas"></canvas>
                            <div class="inscription-signature-bar">
                                <button type="button" @click="clearSignature" class="inscription-signature-clear">
                                    Effacer
                                </button>
                                <span class="inscription-signature-saved" x-show="signatureData !== ''">
                                    ✓ Signature enregistrée
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Étape 5 : Paiement ── #}
                <div x-show="step === 5" class="inscription-card">
                    <h2 class="inscription-step-title">Mode de paiement</h2>

                    <p class="inscription-montant">Cotisation : <strong x-text="montant + ' €'"></strong></p>
                    <p class="inscription-warning">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        Votre inscription ne sera validée qu'à réception du paiement.
                    </p>

                    <div class="inscription-payment-options">
                        {% set modes = [
                            { value: 'virement',   label: 'Virement bancaire' },
                            { value: 'cheque',     label: 'Chèque' },
                            { value: 'especes',    label: 'Espèces' },
                            { value: 'cb_online',  label: 'Carte bancaire en ligne (SumUp)' },
                            { value: 'pass_sport', label: "Pass'Sport" },
                            { value: 'caf',        label: 'Chèque CAF' },
                            { value: 'ancv',       label: 'ANCV / Chèques Vacances' },
                        ] %}
                        {% for mode in modes %}
                            <label class="inscription-payment-option">
                                <input type="radio" name="payment_intention" value="{{ mode.value }}" x-model="paymentMode">
                                <span class="inscription-payment-label">{{ mode.label }}</span>
                            </label>
                        {% endfor %}
                    </div>

                    <div x-show="paymentMode === 'virement'" class="inscription-payment-info">
                        <p><strong>Coordonnées bancaires du club</strong></p>
                        <p>IBAN : <strong>FR76 XXXX XXXX XXXX XXXX XXXX XXX</strong></p>
                        <p>BIC : <strong>XXXXXXXX</strong></p>
                        <p>Libellé : <strong>COTISATION {{ licencie.nom }} {{ licencie.season.label }}</strong></p>
                    </div>
                    <div x-show="paymentMode === 'cheque'" class="inscription-payment-info">
                        Chèque à l'ordre de <strong>Foyer de Soudron</strong>, à remettre au local lors d'une permanence ou à un dirigeant.
                    </div>
                    <div x-show="paymentMode === 'especes'" class="inscription-payment-info">
                        Espèces à remettre au local lors d'une permanence ou à un dirigeant.
                    </div>
                    <div x-show="paymentMode === 'cb_online'" class="inscription-payment-info">
                        <p>Paiement sécurisé par carte bancaire via SumUp.</p>
                        <p style="color: var(--color-text-muted); font-size: var(--font-size-xs);">Des frais de traitement peuvent s'appliquer (+1,5%). Le lien de paiement vous sera transmis par le club.</p>
                    </div>
                    <div x-show="['pass_sport', 'caf', 'ancv'].includes(paymentMode)" class="inscription-payment-info">
                        Document à remettre en main propre à un dirigeant du club.
                    </div>
                </div>

                {# ── Navigation ── #}
                <div class="inscription-nav">
                    <template x-if="step > 1">
                        <button type="button" @click="prev" class="inscription-btn-prev">
                            ← Précédent
                        </button>
                    </template>

                    <template x-if="step > 1 && step < 5">
                        <button type="button" @click="next" :disabled="!canGoNext" class="inscription-btn-next">
                            Suivant →
                        </button>
                    </template>

                    <template x-if="step === 5">
                        <button type="submit" :disabled="!canGoNext" class="inscription-btn-submit">
                            Valider mon inscription ✓
                        </button>
                    </template>
                </div>

            </form>

        </div>
    </main>

    {% include 'components/footer.html.twig' %}

</div>
{% endblock %}
