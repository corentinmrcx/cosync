{% extends 'public/layout.html.twig' %}

{% block title %}Inscription – Foyer de Soudron{% endblock %}

{% block page_attributs %} x-data="inscriptionForm({{ config|json_encode }})"{% endblock %}

{% block entete_droite %}
    <span class="inscription-header-step" x-text="`Étape ${displayStep} sur ${totalSteps}`"></span>
{% endblock %}

{% block entete_extra %}
    <div class="inscription-progress">
        <template x-for="n in totalSteps" :key="n">
            <div class="inscription-progress-segment"
                 :class="displayStep >= n ? 'inscription-progress-segment-done' : ''"></div>
        </template>
    </div>
{% endblock %}

{% block contenu %}
    {% if demo|default(false) %}
<div class="inscription-demo-banner">
    Mode démonstration — aucune donnée ne sera enregistrée.
</div>
    {% endif %}

    {# — Header — #}

    <form method="post"
          {% if demo|default(false) %}@submit.prevent="demoSubmit()"{% else %}action="{{ path('public_inscription_submit', {uuid: licencie.uuid}) }}" @submit="submitting = true"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token('inscription_submit') }}">
        <input type="hidden" name="attestation_signature_data" :value="signatureDataAttestation">

        {# ── Étape 1 : Bienvenue ── #}
        <div x-show="step === 1" class="inscription-card">
            {% if licencie.category.isJeune %}
                <h1 class="inscription-welcome-name">Bonjour 👋</h1>
                <p class="inscription-welcome-text">
                    Inscription de <strong>{{ licencie.prenom }}</strong> au <strong>Foyer de Soudron</strong> pour la saison <strong>{{ licencie.season.label }}</strong>.
                </p>
            {% else %}
                <h1 class="inscription-welcome-name">Bonjour {{ licencie.prenom }} 👋</h1>
                <p class="inscription-welcome-text">
                    Bienvenue dans le formulaire d'inscription au <strong>Foyer de Soudron</strong> pour la saison <strong>{{ licencie.season.label }}</strong>.
                </p>
            {% endif %}
            <p class="inscription-welcome-text">
                Ce formulaire vous prendra moins de <strong>5 minutes</strong>. Vous renseignerez vos tailles d'équipement, vos autorisations et signerez le règlement intérieur.
            </p>
            {% include 'public/_rgpd_note.html.twig' %}
            <button type="button" @click="next" class="btn btn-primary btn-block">
                Commencer →
            </button>
        </div>

        {# ── Étape 2 : Équipement ── #}
        <div x-show="step === 2" class="inscription-card">
            <h2 class="inscription-step-title">Tailles d'équipement</h2>
            <div class="inscription-fields">

                <div class="field">
                    <label class="field-label">Taille haut *</label>
                    <div x-data="{
                        open: false, top: 0, left: 0, width: 0,
                        toggle() {
                            if (!this.open) {
                                const r = this.$refs.trigger.getBoundingClientRect();
                                this.top = (window.innerHeight - r.bottom < 230) ? r.top - 230 - 4 : r.bottom + 4;
                                this.left = r.left; this.width = r.width;
                            }
                            this.open = !this.open;
                        }
                    }" @click.outside="open = false" class="cselect">
                        <button x-ref="trigger" type="button" @click="toggle()" :class="{'cselect-trigger-open': open}" class="cselect-trigger">
                            <span x-text="tailleHaut || '— Choisir —'" :class="{'cselect-placeholder': !tailleHaut}"></span>
                            <svg class="cselect-chevron" :class="{'cselect-chevron-open': open}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <ul x-show="open" x-cloak class="cselect-dropdown" :style="`top:${top}px;left:${left}px;width:${width}px`">
                            <li class="cselect-optgroup-label">Tailles enfants</li>
                            {% for t in tailles_enfant() %}
                                <li @mousedown.prevent="tailleHaut = '{{ t }}'; open = false" :class="{'cselect-option-active': tailleHaut === '{{ t }}'}" class="cselect-option">{{ t }}</li>
                            {% endfor %}
                            <li class="cselect-optgroup-label">Tailles adultes</li>
                            {% for t in tailles_adulte() %}
                                <li @mousedown.prevent="tailleHaut = '{{ t }}'; open = false" :class="{'cselect-option-active': tailleHaut === '{{ t }}'}" class="cselect-option">{{ t }}</li>
                            {% endfor %}
                        </ul>
                        <input type="hidden" name="taille_haut" :value="tailleHaut">
                    </div>
                </div>

                <div class="field">
                    <label class="field-label">Taille bas *</label>
                    <div x-data="{
                        open: false, top: 0, left: 0, width: 0,
                        toggle() {
                            if (!this.open) {
                                const r = this.$refs.trigger.getBoundingClientRect();
                                this.top = (window.innerHeight - r.bottom < 230) ? r.top - 230 - 4 : r.bottom + 4;
                                this.left = r.left; this.width = r.width;
                            }
                            this.open = !this.open;
                        }
                    }" @click.outside="open = false" class="cselect">
                        <button x-ref="trigger" type="button" @click="toggle()" :class="{'cselect-trigger-open': open}" class="cselect-trigger">
                            <span x-text="tailleBas || '— Choisir —'" :class="{'cselect-placeholder': !tailleBas}"></span>
                            <svg class="cselect-chevron" :class="{'cselect-chevron-open': open}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <ul x-show="open" x-cloak class="cselect-dropdown" :style="`top:${top}px;left:${left}px;width:${width}px`">
                            <li class="cselect-optgroup-label">Tailles enfants</li>
                            {% for t in tailles_enfant() %}
                                <li @mousedown.prevent="tailleBas = '{{ t }}'; open = false" :class="{'cselect-option-active': tailleBas === '{{ t }}'}" class="cselect-option">{{ t }}</li>
                            {% endfor %}
                            <li class="cselect-optgroup-label">Tailles adultes</li>
                            {% for t in tailles_adulte() %}
                                <li @mousedown.prevent="tailleBas = '{{ t }}'; open = false" :class="{'cselect-option-active': tailleBas === '{{ t }}'}" class="cselect-option">{{ t }}</li>
                            {% endfor %}
                        </ul>
                        <input type="hidden" name="taille_bas" :value="tailleBas">
                    </div>
                </div>

                <div class="field">
                    <label class="field-label">Pointure *</label>
                    <div x-data="{
                        open: false, top: 0, left: 0, width: 0,
                        toggle() {
                            if (!this.open) {
                                const r = this.$refs.trigger.getBoundingClientRect();
                                this.top = (window.innerHeight - r.bottom < 230) ? r.top - 230 - 4 : r.bottom + 4;
                                this.left = r.left; this.width = r.width;
                            }
                            this.open = !this.open;
                        }
                    }" @click.outside="open = false" class="cselect">
                        <button x-ref="trigger" type="button" @click="toggle()" :class="{'cselect-trigger-open': open}" class="cselect-trigger">
                            <span x-text="pointure || '— Choisir —'" :class="{'cselect-placeholder': !pointure}"></span>
                            <svg class="cselect-chevron" :class="{'cselect-chevron-open': open}" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <ul x-show="open" x-cloak class="cselect-dropdown" :style="`top:${top}px;left:${left}px;width:${width}px`">
                            {% for p in pointures() %}
                                <li @mousedown.prevent="pointure = '{{ p }}'; open = false" :class="{'cselect-option-active': pointure === '{{ p }}'}" class="cselect-option">{{ p }}</li>
                            {% endfor %}
                        </ul>
                        <input type="hidden" name="pointure" :value="pointure">
                    </div>
                </div>

                {% if dotationGroupes|default([]) is not empty or dotationAutos|default([]) is not empty %}
                    <hr class="inscription-question-divider">
                    <p class="inscription-section-title">Votre dotation</p>
                    <p class="inscription-section-hint">Les équipements que le club vous remet cette saison.</p>
                {% endif %}

                {% for grp in dotationGroupes|default([]) %}
                    <div class="inscription-question-block">
                        <span class="inscription-question-label">{{ grp.groupe }} *</span>
                        <span class="inscription-question-hint">Choisissez l'article souhaité pour votre dotation.</span>
                        <div class="inscription-radio-group">
                            {% for opt in grp.options %}
                                <label class="inscription-radio-option">
                                    <input type="radio" name="dotation_choix[{{ grp.groupe }}]" value="{{ opt.stockItem.id }}" x-model="dotationChoix['{{ grp.groupe|e('js') }}']">
                                    <span class="inscription-radio-label">{{ opt.stockItem.nom }}</span>
                                </label>
                            {% endfor %}
                        </div>

                        {# Champ de flocage : rendu seulement pour les options qui l'exigent, et
                           désactivé — donc non soumis — tant que l'option n'est pas sélectionnée. #}
                        {% for opt in grp.options|filter(o => o.personnalisationRequise) %}
                            <div class="inscription-flocage-field"
                                 x-show="dotationChoix['{{ grp.groupe|e('js') }}'] === '{{ opt.stockItem.id }}'" x-cloak>
                                {% include 'public/inscription/_flocage_input.html.twig' with {
                                    cle: grp.groupe,
                                    ligne: opt,
                                    maxDefaut: personnalisationMaxDefaut,
                                    conditionnel: true,
                                    valeurAttendue: opt.stockItem.id,
                                } only %}
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}

                {# Personnalisations dues sans question de choix : groupe à option unique
                   (nouveau licencié) ou article fixe personnalisé. #}
                {% for auto in dotationAutos|default([]) %}
                    <div class="inscription-question-block">
                        {% include 'public/inscription/_flocage_input.html.twig' with {
                            cle: auto.cle,
                            ligne: auto.ligne,
                            maxDefaut: personnalisationMaxDefaut,
                            conditionnel: false,
                            valeurAttendue: null,
                        } only %}
                    </div>
                {% endfor %}

                {# Récapitulatif : le texte tel qu'il sera imprimé, à confirmer avant de continuer. #}
                <div class="inscription-flocage-recap" x-show="flocagesActifs.length > 0" x-cloak>
                    <p class="inscription-flocage-recap-title">Vérifiez l'orthographe avant de continuer</p>
                    <template x-for="f in flocagesActifs" :key="f.cle">
                        <div class="inscription-flocage-item">
                            <span class="inscription-flocage-article" x-text="f.article"></span>
                            <div class="inscription-flocage-preview" x-text="f.texte || '…'"></div>
                        </div>
                    </template>
                    <label class="inscription-flocage-check">
                        <input type="checkbox" name="flocage_confirme" value="1" x-model="flocageConfirme">
                        <span>Je confirme l'orthographe. Le texte sera imprimé tel quel et ne pourra plus être modifié.</span>
                    </label>
                </div>

            </div>
        </div>

        {# ── Étape 3 : Autorisations ── #}
        <div x-show="step === 3" class="inscription-card">
            <h2 class="inscription-step-title">Autorisations</h2>
            <div class="inscription-fields">

                <div class="inscription-question-block">
                    <span class="inscription-question-label">Droit à l'image *</span>
                    <span class="inscription-question-hint">Autorisation de diffuser des photos/vidéos du licencié sur les supports du club.</span>
                    <div class="inscription-radio-group">
                        <label class="inscription-radio-option">
                            <input type="radio" name="autorisation_photo" value="1" x-model="autorisationPhoto">
                            <span class="inscription-radio-label">Oui</span>
                        </label>
                        <label class="inscription-radio-option">
                            <input type="radio" name="autorisation_photo" value="0" x-model="autorisationPhoto">
                            <span class="inscription-radio-label">Non</span>
                        </label>
                    </div>
                </div>

                <template x-if="isJeune">
                    <div class="inscription-fields">
                        <hr class="inscription-question-divider">

                        <div class="inscription-question-block">
                            <span class="inscription-question-label">Autorisation en cas d'accident *</span>
                            <span class="inscription-question-hint">J'autorise les dirigeants du club à prendre toutes les mesures nécessaires en cas d'accident survenu dans le cadre de la pratique du football.</span>
                            <div class="inscription-radio-group">
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_accident" value="1" x-model="autorisationAccident">
                                    <span class="inscription-radio-label">Oui</span>
                                </label>
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_accident" value="0" x-model="autorisationAccident">
                                    <span class="inscription-radio-label">Non</span>
                                </label>
                            </div>
                        </div>

                        <div class="inscription-question-block">
                            <span class="inscription-question-label">Transport par les dirigeants *</span>
                            <span class="inscription-question-hint">Autorisation que votre enfant soit transporté par les dirigeants du club lors des déplacements.</span>
                            <div class="inscription-radio-group">
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_transport_dirigeants" value="1" x-model="autorisationTransportDirigeants">
                                    <span class="inscription-radio-label">Oui</span>
                                </label>
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_transport_dirigeants" value="0" x-model="autorisationTransportDirigeants">
                                    <span class="inscription-radio-label">Non</span>
                                </label>
                            </div>
                        </div>

                        <div class="inscription-question-block">
                            <span class="inscription-question-label">Transport par d'autres parents *</span>
                            <span class="inscription-question-hint">Autorisation que votre enfant soit transporté par d'autres parents lors des déplacements.</span>
                            <div class="inscription-radio-group">
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_transport_parents" value="1" x-model="autorisationTransportParents">
                                    <span class="inscription-radio-label">Oui</span>
                                </label>
                                <label class="inscription-radio-option">
                                    <input type="radio" name="autorisation_transport_parents" value="0" x-model="autorisationTransportParents">
                                    <span class="inscription-radio-label">Non</span>
                                </label>
                            </div>
                        </div>

                        <div class="inscription-question-block">
                            <span class="inscription-question-label">Volontaire pour le transport *</span>
                            <span class="inscription-question-hint">Acceptez-vous de transporter occasionnellement d'autres enfants lors des déplacements du club ?</span>
                            <div class="inscription-radio-group">
                                <label class="inscription-radio-option">
                                    <input type="radio" name="volontaire_transport" value="1" x-model="volontaireTransport">
                                    <span class="inscription-radio-label">Oui</span>
                                </label>
                                <label class="inscription-radio-option">
                                    <input type="radio" name="volontaire_transport" value="0" x-model="volontaireTransport">
                                    <span class="inscription-radio-label">Non</span>
                                </label>
                            </div>
                        </div>

                    </div>
                </template>

            </div>
        </div>

        {# ── Étape 4 : Attestation transport (uniquement si volontaire) ── #}
        <div x-show="step === 4" class="inscription-card">
            <h2 class="inscription-step-title">Attestation de transport</h2>
            <p class="inscription-attestation-intro">Merci de votre engagement ! Ces informations sont nécessaires pour assurer la sécurité des enfants transportés. Elles ne seront pas conservées en base de données — seul le document signé sera archivé.</p>

            <div class="inscription-fields">

                <div class="field">
                    <label class="field-label">Nom *</label>
                    <input type="text" name="attestation_nom_conducteur" x-model="nomConducteur"
                           class="field-input" placeholder="NOM" autocomplete="family-name">
                </div>

                <div class="field">
                    <label class="field-label">Prénom *</label>
                    <input type="text" name="attestation_prenom_conducteur" x-model="prenomConducteur"
                           class="field-input" placeholder="Prénom" autocomplete="given-name">
                </div>

                <div class="field">
                    <label class="field-label">Numéro de permis de conduire *</label>
                    <input type="text" name="attestation_num_permis" x-model="numPermis"
                           class="field-input" placeholder="Ex : 01AA00000" autocomplete="off">
                </div>

                <div class="field">
                    <label class="field-label">Nom et adresse de l'assurance *</label>
                    <textarea name="attestation_assurance" x-model="assuranceNomAdresse"
                              class="field-input" rows="3"
                              placeholder="Ex : Macif — 12 rue de la Paix, 75001 Paris"></textarea>
                </div>

                <label class="inscription-checkbox-row">
                    <input type="checkbox" name="attestation_vehicule_neuf" value="1" x-model="vehiculeNeuf">
                    <span class="inscription-checkbox-text">Véhicule neuf, sans contrôle technique à ce jour</span>
                </label>

                <div class="field" x-show="!vehiculeNeuf">
                    <label class="field-label">Date du dernier contrôle technique *</label>
                    <input type="date" name="attestation_date_ct" x-model="dateCT"
                           class="field-input" :class="dateCTFuture ? 'inscription-input-error' : ''"
                           max="{{ 'now'|date('Y-m-d') }}">
                    <p x-show="dateCTFuture" class="inscription-field-error">
                        La date du contrôle technique ne peut pas être dans le futur.
                    </p>
                </div>

                <label class="inscription-checkbox-row">
                    <input type="checkbox" name="attestation_engagement" value="1" x-model="engagementAttestation">
                    <span class="inscription-checkbox-text">Je m'engage à prévenir le club en cas de changement de situation (retrait de permis, résiliation d'assurance, défaut de contrôle technique).</span>
                </label>

                <div>
                    <p class="inscription-signature-label">Signature *</p>
                    <p class="inscription-signature-hint">Signez dans le cadre ci-dessous avec votre doigt ou votre souris.</p>
                    <div class="inscription-signature-wrap">
                        <canvas class="inscription-signature-canvas" x-ref="signatureCanvasAttestation"></canvas>
                        <div class="inscription-signature-bar">
                            <button type="button" @click="clearAttestationSignature" class="inscription-signature-clear">
                                Effacer
                            </button>
                            <span class="inscription-signature-saved" x-show="signatureDataAttestation !== ''">
                                ✓ Signature enregistrée
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        {# ── Étapes 5+ : un document à lire et signer par étape ── #}
        {% for doc in documents %}
            {% include 'public/_document_signature_step.html.twig' with {
                doc: doc,
                index: loop.index0,
                stepShow: 'step === ' ~ (5 + loop.index0)
            } only %}
        {% endfor %}

        {# ── Dernière étape : Paiement ── #}
        <div x-show="step === paymentStep" class="inscription-card">
            <h2 class="inscription-step-title">Mode de paiement</h2>

            <p class="inscription-montant">Cotisation : <strong x-text="montant + ' €'"></strong></p>
            <p class="inscription-warning">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                Votre inscription ne sera validée qu'à réception du paiement.
            </p>

            {# Paiement par carte — mis en avant #}
            <input type="hidden" name="pay_online" value="0" x-ref="payOnlineFlag">

            <div class="inscription-cb-block" x-show="!multiPayment">
                <button type="button" class="btn btn-primary btn-block" :disabled="submitting" @click="payByCard($el)">
                    Payer — <span x-text="montant + ' €'"></span>
                </button>
                <p class="inscription-cb-note">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Paiement 100 % sécurisé via HelloAsso
                </p>
                <p class="inscription-cb-hint">Votre inscription est enregistrée, puis vous êtes redirigé vers HelloAsso.</p>
            </div>

            <div class="inscription-payment-separator" x-show="!multiPayment">
                <span>ou régler autrement</span>
            </div>

            {# Toggle plusieurs moyens de paiement #}
            <label class="inscription-multi-toggle">
                <input type="checkbox" name="multi_payment" value="1" x-model="multiPayment"
                       @change="paymentMode = ''; paymentModes = [];">
                <span class="inscription-multi-toggle-text">Je souhaite régler avec plusieurs moyens de paiement</span>
            </label>

            {# Le virement n'est proposé que si le club a renseigné un IBAN :
               l'annoncer sans pouvoir donner les coordonnées enverrait le licencié dans le mur. #}
            {% set modes = (licencie.season.accepteVirement
                ? [{ value: 'virement', label: 'Virement bancaire' }]
                : []) | merge([
                { value: 'cheque',     label: 'Chèque' },
                { value: 'especes',    label: 'Espèces' },
                { value: 'pass_sport', label: "Pass'Sport" },
                { value: 'caf',        label: 'Chèque CAF' },
                { value: 'ancv',       label: 'ANCV / Chèques Vacances' },
            ]) %}

            {# Paiement unique → radios #}
            <div x-show="!multiPayment" class="inscription-payment-options">
                {% for mode in modes %}
                    <label class="inscription-payment-option">
                        <input type="radio" name="payment_intention" value="{{ mode.value }}" x-model="paymentMode">
                        <span class="inscription-payment-label">{{ mode.label }}</span>
                    </label>
                {% endfor %}
            </div>

            {# Paiement multiple → checkboxes #}
            <div x-show="multiPayment" class="inscription-payment-options">
                {% for mode in modes %}
                    <label class="inscription-payment-option">
                        <input type="checkbox" name="payment_intentions[]" value="{{ mode.value }}"
                               :checked="paymentModes.includes('{{ mode.value }}')"
                               @change="togglePaymentMode('{{ mode.value }}')">
                        <span class="inscription-payment-label">{{ mode.label }}</span>
                    </label>
                {% endfor %}
            </div>

            {# Blocs info — s'affichent selon le mode sélectionné (unique ou multiple) #}
            <div class="inscription-payment-infos">
                {% if licencie.season.accepteVirement %}
                    <div x-show="isPaymentModeActive('virement')" class="inscription-payment-info">
                        {% include 'components/_coordonnees_bancaires.html.twig' with {
                            season:  licencie.season,
                            libelle: libelleVirement,
                        } only %}
                    </div>
                {% endif %}
                <div x-show="isPaymentModeActive('cheque')" class="inscription-payment-info">
                    Chèque à l'ordre de <strong>{{ licencie.season.titulaireCompte|default('Foyer de Soudron') }}</strong>, à remettre à un dirigeant.
                </div>
                <div x-show="isPaymentModeActive('especes')" class="inscription-payment-info">
                    Espèces à remettre à un dirigeant.
                </div>
                <div x-show="isPaymentModeActive('pass_sport') || isPaymentModeActive('caf') || isPaymentModeActive('ancv')" class="inscription-payment-info">
                    Document à remettre en main propre à un dirigeant du club.
                </div>
            </div>
        </div>

        {# ── Navigation ── #}
        <div class="inscription-nav">
            <template x-if="step > 1">
                <button type="button" @click="prev" class="btn btn-ghost">
                    ← Précédent
                </button>
            </template>

            <template x-if="step > 1 && displayStep < totalSteps">
                <button type="button" @click="next" :disabled="!canGoNext" class="btn btn-primary btn-block">
                    Suivant →
                </button>
            </template>

            <template x-if="displayStep === totalSteps">
                <button type="submit" :disabled="!canGoNext || submitting" class="btn btn-primary btn-block">
                    Valider mon inscription ✓
                </button>
            </template>
        </div>

    </form>
{% endblock %}

{% block hors_flux %}
    {% include 'components/_overlay_chargement.html.twig' with { visible: 'submitting', titre: "{% if demo|default(false) %}Enregistrement dans le Drive…{% else %}Validation de votre inscription…{% endif %}" } only %}
{% endblock %}
