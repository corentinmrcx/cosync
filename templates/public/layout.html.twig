{% extends 'base.html.twig' %}

{# Coquille commune aux pages publiques : en-tête club, messages, carte centrale, pied de page.
   Une page publique ne remplit que `contenu`. #}

{% block title %}{{ club_nom }}{% endblock %}

{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block corps %}
    <div class="inscription-page"{% block page_attributs %}{% endblock %}>

        <header class="inscription-header">
            <div class="inscription-header-top">
                <span class="inscription-header-club">{{ club_nom }}</span>
                {% block entete_droite %}{% endblock %}
            </div>
            {% block entete_extra %}{% endblock %}
        </header>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="inscription-flash inscription-flash-{{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <main class="inscription-main">
            <div class="inscription-container">
                {% block contenu %}{% endblock %}
            </div>
        </main>

        {% include 'components/footer.html.twig' %}

        {# Hors du flux : overlays et modales plein écran. #}
        {% block hors_flux %}{% endblock %}

    </div>
{% endblock %}
