{% extends 'public/layout.html.twig' %}

{% block title %}Lien expiré – {{ club_nom }}{% endblock %}

{% block contenu %}
    <div class="inscription-card">
        <div class="inscription-expired-icon">⏰</div>
        <h1 class="inscription-expired-title">Lien expiré ou invalide</h1>
        <p class="inscription-expired-text">
            {{ message|default('Ce lien n\'est plus valide.') }}<br>
            Contactez le club pour recevoir un nouveau lien.
        </p>
    </div>
{% endblock %}
