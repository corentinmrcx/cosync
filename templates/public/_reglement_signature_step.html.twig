{# ──────────────────────────────────────────────────────────────────────────
   Étape « Règlement intérieur + signature » — partagée entre le formulaire
   licencié et le formulaire dirigeant.
   Paramètres attendus :
     - season   : la saison dont on affiche le règlement (season.reglementText)
     - stepShow : expression Alpine du x-show (ex : 'step === 5')
   Variables Alpine utilisées (fournies par le composant hôte via le mixin) :
     reglementScrolled, hasRead, signatureData, onReglementScroll, clearSignature
   Références x-ref : reglementEl, signatureCanvas
─────────────────────────────────────────────────────────────────────────── #}
<div x-show="{{ stepShow }}" class="inscription-card">
    <h2 class="inscription-step-title">Règlement intérieur</h2>

    <div class="inscription-reglement"
         x-ref="reglementEl"
         @scroll="onReglementScroll($event)">
        {% if season.reglementText %}
            {{ season.reglementText|raw }}
        {% else %}
            <p class="inscription-reglement-empty">Aucun règlement n'a encore été défini pour cette saison. Contactez le club.</p>
        {% endif %}
    </div>

    <p class="inscription-reglement-scroll-hint" x-show="!reglementScrolled">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        Faites défiler le règlement jusqu'en bas pour continuer.
    </p>

    <label class="inscription-checkbox-row" :class="{ 'inscription-checkbox-disabled': !reglementScrolled }">
        <input type="checkbox" x-model="hasRead" :disabled="!reglementScrolled">
        <span class="inscription-checkbox-text">J'ai lu et j'accepte le règlement intérieur du Foyer de Soudron.</span>
    </label>

    <div x-show="hasRead">
        <p class="inscription-signature-label">Signature *</p>
        <p class="inscription-signature-hint">Signez dans le cadre ci-dessous avec votre doigt ou votre souris.</p>
        <div class="inscription-signature-wrap">
            <canvas class="inscription-signature-canvas" x-ref="signatureCanvas"></canvas>
            <div class="inscription-signature-bar">
                <button type="button" @click="clearSignature" class="inscription-signature-clear">
                    Effacer
                </button>
                <span class="inscription-signature-saved" x-show="signatureData !== ''">
                    ✓ Signature enregistrée
                </span>
            </div>
        </div>
    </div>
</div>
