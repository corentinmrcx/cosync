{% extends 'public/layout.html.twig' %}

{% block title %}Attestation signée — Foyer de Soudron{% endblock %}

{% block entete_extra %}
    {% include 'components/_progression.html.twig' with { total: 1 } only %}
{% endblock %}

{% block contenu %}
    <div class="inscription-card">
        <div class="inscription-expired-icon">✅</div>
        <h1 class="inscription-expired-title">Attestation signée !</h1>
        <p class="inscription-expired-text">
            Merci {{ detenteur.prenom }}, votre attestation de remise de clés pour la
            saison {{ season.label }} a bien été enregistrée le
            {{ attestation.signedAt|date('d/m/Y') }}.
        </p>

        <p style="margin-top: 1.5rem; font-size: 0.8125rem; color: var(--color-text-disabled); line-height: 1.6;">
            Le document signé est archivé par le club et peut être transmis à la mairie sur
            demande. Pour toute question, contactez le club directement.
        </p>
    </div>
{% endblock %}
