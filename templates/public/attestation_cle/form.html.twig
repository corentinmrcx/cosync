{% extends 'public/layout.html.twig' %}

{% block title %}Attestation de remise de clés — Foyer de Soudron{% endblock %}

{% block head %}
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js" defer></script>
{% endblock %}

{% block body %}
<div class="inscription-page" x-data="attestationCleForm()">

    {# — Header — #}
    <header class="inscription-header">
        <div class="inscription-header-top">
            <span class="inscription-header-club">Foyer de Soudron</span>
            <span class="inscription-header-step">Saison {{ dirigeant.season.label }}</span>
        </div>
        <div class="inscription-progress">
            <div class="inscription-progress-segment inscription-progress-segment-done"></div>
        </div>
    </header>

    {# — Flash — #}
    {% for message in app.flashes('error') %}
        <div class="inscription-flash-error">{{ message }}</div>
    {% endfor %}

    <main class="inscription-main">
        <div class="inscription-container">

            <form method="post" action="{{ path('public_attestation_cle_submit', {uuid: dirigeant.uuid}) }}"
                  @submit="submitting = true">
                <input type="hidden" name="_token" value="{{ csrf_token('attestation_cle_submit') }}">
                <input type="hidden" name="signature_data" :value="signatureData">

                <div class="inscription-card">
                    <h1 class="inscription-step-title">Attestation de remise de clés</h1>

                    {# — Ce que la personne atteste, repris du registre — #}
                    <p class="attestation-cle-statement">
                        Je soussigné·e <strong>{{ dirigeant.prenom }} {{ dirigeant.nom }}</strong>,
                        reconnais avoir reçu <strong>{{ nbCles }} clé{{ nbCles > 1 ? 's' : '' }}</strong>
                        du club house du Foyer de Soudron{% if remiseLe %} le <strong>{{ remiseLe|date('d/m/Y') }}</strong>{% endif %}.
                    </p>

                    {% if dirigeant.season.attestationCleText %}
                        <div class="attestation-cle-engagement">
                            {{ dirigeant.season.attestationCleText|raw }}
                        </div>
                    {% endif %}

                    <label class="inscription-checkbox-row">
                        <input type="checkbox" x-model="hasRead">
                        <span class="inscription-checkbox-text">
                            J'atteste l'exactitude de ce qui précède et m'engage à respecter ces conditions.
                        </span>
                    </label>

                    <div x-show="hasRead">
                        <p class="inscription-signature-label">Signature *</p>
                        <p class="inscription-signature-hint">Signez dans le cadre ci-dessous avec votre doigt ou votre souris.</p>
                        <div class="inscription-signature-wrap">
                            <canvas class="inscription-signature-canvas" x-ref="signatureCanvas"></canvas>
                            <div class="inscription-signature-bar">
                                <button type="button" @click="clearSignature" class="inscription-signature-clear">
                                    Effacer
                                </button>
                                <span class="inscription-signature-saved" x-show="signatureData !== ''">
                                    ✓ Signature enregistrée
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="inscription-nav">
                    <button type="submit" :disabled="!canSubmit || submitting" class="inscription-btn-submit">
                        Signer ✓
                    </button>
                </div>

            </form>

        </div>
    </main>

    {% include 'components/footer.html.twig' %}

    {# — Overlay de chargement pendant la soumission — #}
    <div class="inscription-overlay" x-show="submitting" x-cloak>
        <div class="inscription-overlay-box">
            <div class="inscription-overlay-spinner"></div>
            <p class="inscription-overlay-title">Enregistrement de votre signature…</p>
            <p class="inscription-overlay-text">Merci de patienter quelques secondes, ne fermez pas cette page.</p>
        </div>
    </div>

</div>
{% endblock %}
