{% extends 'public/layout.html.twig' %}

{% block title %}Attestation de remise de clés — Foyer de Soudron{% endblock %}

{% block page_attributs %} x-data="attestationCleForm()"{% endblock %}

{% block entete_droite %}
    <span class="inscription-header-step">Saison {{ season.label }}</span>
{% endblock %}

{% block entete_extra %}
    {% include 'components/_progression.html.twig' with { total: 1 } only %}
{% endblock %}

{% block contenu %}
    {# — Header — #}

    <form method="post" action="{{ path('public_attestation_cle_submit', {uuid: attestation.uuid}) }}"
          @submit="submitting = true">
        <input type="hidden" name="_token" value="{{ csrf_token('attestation_cle_submit') }}">
        <input type="hidden" name="signature_data" :value="signatureData">

        <div class="inscription-card">
            <h1 class="inscription-step-title">Attestation de remise de clés</h1>
            <p class="inscription-step-intro">
                Voici le document que vous vous apprêtez à signer. Il sera archivé par le club
                et peut être transmis à la mairie sur demande.
            </p>

            {# L'engagement rédigé par le club vient en premier : c'est ce qui se lit,
               la formule reprise du registre venant le conclure juste au-dessus de la
               signature. #}
            <div class="attestation-cle-document">
                <p class="attestation-cle-document-titre">
                    Attestation de remise de clés — saison {{ season.label }}
                </p>

                {% if season.attestationCleText %}
                    <div class="attestation-cle-engagement">
                        {{ season.attestationCleText|raw }}
                    </div>
                {% endif %}

                <p class="attestation-cle-statement">
                    Je soussigné·e <strong>{{ detenteur.prenom }} {{ detenteur.nom }}</strong>,
                    reconnais avoir reçu <strong>{{ nbCles }} clé{{ nbCles > 1 ? 's' : '' }}</strong>
                    du local du Foyer de Soudron{% if remiseLe %} le <strong>{{ remiseLe|date('d/m/Y') }}</strong>{% endif %},
                    pour la saison <strong>{{ season.label }}</strong>.
                </p>
            </div>

            <label class="inscription-checkbox-row">
                <input type="checkbox" x-model="hasRead">
                <span class="inscription-checkbox-text">
                    {# Sans engagement rédigé par le club, ne pas faire accepter des conditions invisibles. #}
                    {{ season.attestationCleText
                        ? "J'atteste l'exactitude de ce qui précède et m'engage à respecter ces conditions."
                        : "J'atteste l'exactitude de ce qui précède." }}
                </span>
            </label>

            <div class="inscription-signature-block" x-show="hasRead">
                <p class="inscription-signature-label">Signature *</p>
                <p class="inscription-signature-hint">Signez dans le cadre ci-dessous avec votre doigt ou votre souris.</p>
                <div class="inscription-signature-wrap">
                    <canvas class="inscription-signature-canvas" x-ref="signatureCanvas"></canvas>
                    <div class="inscription-signature-bar">
                        <button type="button" @click="clearSignature" class="inscription-signature-clear">
                            Effacer
                        </button>
                        <span class="inscription-signature-saved" x-show="signatureData !== ''">
                            ✓ Signature enregistrée
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="inscription-nav">
            <button type="submit" :disabled="!canSubmit || submitting" class="btn btn-primary btn-block">
                Signer ✓
            </button>
        </div>

    </form>
{% endblock %}

{% block hors_flux %}
    {% include 'components/_overlay_chargement.html.twig' with { visible: 'submitting', titre: "Enregistrement de votre signature…" } only %}
{% endblock %}
