{% extends 'public/layout.html.twig' %}

{% block title %}Fiche complétée — Foyer de Soudron{% endblock %}

{% block entete_extra %}
    {% include 'components/_progression.html.twig' with { total: 2 } only %}
{% endblock %}

{% block contenu %}
    <div class="inscription-card">
        <div class="inscription-expired-icon">✅</div>
        <h1 class="inscription-expired-title">Dossier complété !</h1>
        <p class="inscription-expired-text">
            Merci {{ dirigeant.prenom }}, votre dossier dirigeant a bien été enregistré.
        </p>

        <dl style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.875rem;">
            {% if dirigeant.tailleHaut %}
            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
                <span style="color: #6b7280; font-weight: 500;">Taille haut</span>
                <span style="font-weight: 600;">{{ dirigeant.tailleHaut }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
                <span style="color: #6b7280; font-weight: 500;">Taille bas</span>
                <span style="font-weight: 600;">{{ dirigeant.tailleBas }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
                <span style="color: #6b7280; font-weight: 500;">Pointure</span>
                <span style="font-weight: 600;">{{ dirigeant.pointure }}</span>
            </div>
            {% endif %}
            {% if dirigeant.autorisationPhoto is not null %}
            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb;">
                <span style="color: #6b7280; font-weight: 500;">Droit à l'image</span>
                <span style="font-weight: 600;">{{ dirigeant.autorisationPhoto ? 'Accordé' : 'Refusé' }}</span>
            </div>
            {% endif %}
            <div style="display: flex; justify-content: space-between; padding: 0.5rem 0;">
                <span style="color: #6b7280; font-weight: 500;">Transport des licenciés</span>
                <span style="font-weight: 600;">{{ dirigeant.volontaireTransport ? 'Oui' : 'Non' }}</span>
            </div>
        </dl>

        <p style="margin-top: 1.5rem; font-size: 0.8125rem; color: #9ca3af; line-height: 1.6;">
            Pour toute question, contactez le club directement.
        </p>
    </div>
{% endblock %}
