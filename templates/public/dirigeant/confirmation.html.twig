{% extends 'public/layout.html.twig' %}

{% block title %}Fiche complétée — Foyer de Soudron{% endblock %}

{% block entete_extra %}
    {% include 'components/_progression.html.twig' with { total: 2 } only %}
{% endblock %}

{% block contenu %}
    <div class="inscription-card">
        <div class="inscription-expired-icon">✅</div>
        <h1 class="inscription-expired-title">Dossier complété !</h1>
        <p class="inscription-expired-text">
            Merci {{ dirigeant.prenom }}, votre dossier dirigeant a bien été enregistré.
        </p>

        <dl class="recap">
            {% if dirigeant.tailleHaut %}
                {% include 'components/_recap_ligne.html.twig' with { libelle: 'Taille haut', valeur: dirigeant.tailleHaut } only %}
                {% include 'components/_recap_ligne.html.twig' with { libelle: 'Taille bas', valeur: dirigeant.tailleBas } only %}
                {% include 'components/_recap_ligne.html.twig' with { libelle: 'Pointure', valeur: dirigeant.pointure } only %}
            {% endif %}
            {% if dirigeant.autorisationPhoto is not null %}
                {% include 'components/_recap_ligne.html.twig' with {
                    libelle: "Droit à l'image",
                    valeur: dirigeant.autorisationPhoto ? 'Accordé' : 'Refusé',
                } only %}
            {% endif %}
            {% include 'components/_recap_ligne.html.twig' with {
                libelle: 'Transport des licenciés',
                valeur: dirigeant.volontaireTransport ? 'Oui' : 'Non',
            } only %}
        </dl>

        <p class="recap-note">Pour toute question, contactez le club directement.</p>
    </div>
{% endblock %}
