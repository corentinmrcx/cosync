{% import 'components/_stock_item_label.html.twig' as article %}
{# Désignation d'un article dans un contexte de commande.

   Le nom seul ne suffit à personne devant un catalogue fournisseur : le club a six articles
   nommés « Chaussettes », et celui qui passe la commande doit savoir lequel (§7.6 ter). La
   référence et le lien, quand ils sont renseignés, épargnent la recherche dans le catalogue —
   c'est le geste concret que cet écran sert.

   Deuxième ligne discrète, à dessein : elle aide à commander, elle n'est pas ce qu'on lit
   pour reconnaître l'article.

   `item` = App\Entity\StockItem.
   `taille` = étiquette du carton, quand l'article ne se décline qu'une fois et qu'elle n'a
   donc pas de ligne à elle — elle se lit alors au ras du nom, pas sous la référence. #}
<span class="cmd-article-ligne">
    <span class="cmd-article-nom">{{ article.label(item) }}</span>
    {% if taille|default(null) %}<span class="dot-item-taille">{{ taille }}</span>{% endif %}
</span>

{% if item.refCatalogue or item.lienAchat %}
    <span class="cmd-article-meta">
        {%- if item.refCatalogue %}réf. {{ item.refCatalogue }}{% endif -%}
        {%- if item.refCatalogue and item.lienAchat %} · {% endif -%}
        {%- if item.lienAchat -%}
            <a href="{{ item.lienAchat }}" target="_blank" rel="noopener noreferrer"
               class="cmd-article-lien">Fiche produit ↗</a>
        {%- endif -%}
    </span>
{% endif %}
