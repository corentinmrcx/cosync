{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Commandes{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Dotations', route: 'admin_dotations_dashboard' },
    { label: 'Commandes' }
] } %}

<div class="dot-page">

    {# Les trois sorties de l'approvisionnement tiennent dans l'en-tête, l'étape du moment en
       clair et le reste au « ⋯ ». La liste de flocage est de celles-là : elle part chez le
       floqueur au moment où l'on commande, pas quand on remplit les sacs. #}
    <div class="dot-header">
        <div>
            <h1 class="dot-title">Commandes</h1>
            <p class="dot-subtitle">À commander = besoins « à donner » − stock − commandes en attente.</p>
        </div>
        <div class="dot-header-actions">
            {% if aCommander is not empty and peut_acceder('admin_commandes_generer') %}
                <form method="post" action="{{ path('admin_commandes_generer') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('commande_generer') }}">
                    <button type="submit" class="btn btn-primary">Générer les bons de commande</button>
                </form>
            {% endif %}

            {% embed 'components/_menu_actions.html.twig' with { label: 'Autres sorties de l\'écran' } %}
                {% block items %}
                    {# Un `embed` est un template à lui seul : les macros importées par la page
                       ne descendent pas dans ses blocs, celui-ci refait son import. #}
                    {% import 'components/_icon.html.twig' as ui %}
                    {# Le justificatif reste proposé même sans rien à commander : « le stock couvre
                       toute la saison » est une conclusion qui se prouve devant un conseil, au même
                       titre qu'un achat. #}
                    {% if peut_acceder('admin_commandes_justificatif') %}
                        <form method="post" action="{{ path('admin_commandes_justificatif') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('commande_justificatif') }}">
                            <button type="submit" class="fiche-menu-item">
                                {{ ui.icon('file-text', 15) }}
                                Justificatif de commande
                            </button>
                        </form>
                    {% endif %}
                    {% if peut_acceder('admin_dotations_flocage') %}
                        <a href="{{ path('admin_dotations_flocage') }}" class="fiche-menu-item">
                            {{ ui.icon('tag', 15) }}
                            Liste de flocage
                        </a>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# — À commander — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">À commander</h2>
        </div>

        {% if aCommander is empty %}
            <p class="dot-empty">Rien à commander : tous les besoins sont couverts par le stock ou des commandes en attente.</p>
        {% else %}
            {# Un article, ses tailles dessous, une quantité — l'écran sert à recopier une
               commande chez un fournisseur, rien d'autre.

               Ni besoin, ni stock, ni « en attente » : ils entrent dans le calcul (le
               sous-titre le dit) mais ce sont des faits d'inventaire, et ils ont leur écrit,
               le justificatif de commande. Ici, une colonne de plus est une question de plus.

               Deux colonnes tiennent sur un téléphone : pas de `resp-table`, qui imposerait
               une largeur minimale et remettrait la page à défiler de côté. #}
            {% for fournisseur in aCommander %}
                <div class="cmd-fourn-block">
                    <h3 class="cmd-fourn-title">{{ fournisseur.nom }}</h3>
                    <div class="table-wrapper">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th class="cmd-qte">À commander</th>
                                </tr>
                            </thead>
                            {# Un tbody par article : c'est lui qui tient l'article et ses
                               tailles ensemble, et le filet de séparation ne tombe qu'entre
                               deux articles. #}
                            {% for article in fournisseur.articles %}
                                <tbody class="cmd-groupe">
                                    <tr>
                                        <td>
                                            {# Une seule déclinaison : sa taille monte sur la ligne de
                                               l'article. Sur cet écran la taille n'est pas un détail,
                                               c'est ce qu'on écrit au fournisseur. #}
                                            {% include 'admin/commandes/_article_cell.html.twig' with {
                                                item: article.article,
                                                taille: article.tailleUnique,
                                            } only %}
                                        </td>
                                        <td class="cmd-qte"><strong>{{ article.quantite }}</strong></td>
                                    </tr>
                                    {% if article.detaille %}
                                        {% for taille in article.tailles %}
                                            <tr class="cmd-detail">
                                                {# L'étiquette du carton (« 37-40 »), pas le libellé du
                                                   stock : un « 37 » seul se lisait comme une pointure. #}
                                                <td><span class="dot-item-taille">{{ taille.etiquette }}</span></td>
                                                <td class="cmd-qte">{{ taille.quantite }}</td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            {% endfor %}
                            <tbody>
                                <tr class="cmd-total">
                                    <td>Total {{ fournisseur.nom }}</td>
                                    <td class="cmd-qte">{{ fournisseur.total }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    {# — Commandes — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Bons de commande</h2>
            <span class="dot-card-count">{{ commandes|length }}</span>
        </div>

        {% if commandes is empty %}
            <p class="dot-empty">Aucune commande pour cette saison.</p>
        {% else %}
            <div class="table-wrapper">
                <table class="table resp-table">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Fournisseur</th>
                            <th>Articles</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                            <tr>
                                <td><span class="dot-item-nom">CMD-{{ commande.id }}</span></td>
                                <td>{{ commande.fournisseurLabel }}</td>
                                <td>{{ commande.quantiteTotale }}</td>
                                <td><span class="cmd-badge cmd-badge-{{ commande.statut.value }}">{{ commande.statut.label }}</span></td>
                                <td>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y') : '—' }}</td>
                                <td class="dot-table-action"><a href="{{ path('admin_commandes_show', {id: commande.id}) }}" class="btn btn-secondary btn-sm">Ouvrir</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
