{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Commandes{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Dotations', route: 'admin_dotations_dashboard' },
    { label: 'Commandes' }
] } %}

<div class="dot-page">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">Commandes</h1>
            <p class="dot-subtitle">À commander = besoins « à donner » − stock − commandes en attente.</p>
        </div>
    </div>

    {# — À commander — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">À commander</h2>
            <div class="cmd-card-actions">
                {# Reste proposé même sans rien à commander : « le stock couvre toute la saison »
                   est une conclusion qui se prouve devant un conseil, au même titre qu'un achat. #}
                {% if peut_acceder('admin_commandes_justificatif') %}
                    <form method="post" action="{{ path('admin_commandes_justificatif') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('commande_justificatif') }}">
                        <button type="submit" class="btn btn-secondary">Justificatif de commande</button>
                    </form>
                {% endif %}
                {% if aCommander is not empty and peut_acceder('admin_commandes_generer') %}
                    <form method="post" action="{{ path('admin_commandes_generer') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('commande_generer') }}">
                        <button type="submit" class="btn btn-primary">Générer les bons de commande</button>
                    </form>
                {% endif %}
            </div>
        </div>

        {% if aCommander is empty %}
            <p class="dot-empty">Rien à commander : tous les besoins sont couverts par le stock ou des commandes en attente.</p>
        {% else %}
            {% for groupe in aCommander %}
                <div class="cmd-fourn-block">
                    <h3 class="cmd-fourn-title">{{ groupe.fournisseurNom }}</h3>
                    <div class="table-wrapper">
                        <table class="table resp-table">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Taille</th>
                                    <th>Besoin</th>
                                    <th>Stock</th>
                                    <th>En attente</th>
                                    <th>À commander</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ligne in groupe.lignes %}
                                    <tr>
                                        <td>
                                            {% include 'admin/commandes/_article_cell.html.twig' with { item: ligne.stockItem } only %}
                                        </td>
                                        {# L'étiquette du carton (« 37-40 »), pas le libellé du stock : un « 37 » seul
                                           se lisait comme une pointure. #}
                                        <td>{% if ligne.taille %}<span class="dot-item-taille">{{ taille_carton(ligne.stockItem, ligne.taille) }}</span>{% else %}—{% endif %}</td>
                                        <td>{{ ligne.besoin }}</td>
                                        <td>{{ ligne.stock }}</td>
                                        <td>{{ ligne.enAttente }}</td>
                                        <td><strong>{{ ligne.aCommander }}</strong></td>
                                    </tr>
                                    {# Un stock à 0 pendant que l'article dort sous d'autres libellés est
                                       un motif, pas un fait : la ligne le dit au lieu de laisser commander
                                       du neuf par-dessus un carton plein (CLAUDE.md §5, l'action injouable
                                       affiche son motif). #}
                                    {% if ligne.motif %}
                                        <tr>
                                            <td colspan="6" class="cmd-motif">
                                                {{ ligne.motif }}
                                                {% if ligne.sansGrille %}
                                                    Aucune grille de tailles n'est rattachée à cet article : ce
                                                    que le licencié déclare sort tel quel, sans passer par
                                                    l'étiquette du fournisseur.
                                                    {% if peut_acceder('admin_grilles_index') %}
                                                        <a href="{{ path('admin_grilles_index') }}" class="cmd-motif-lien">Grilles de tailles</a>
                                                    {% endif %}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    {# — Commandes — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Bons de commande</h2>
            <span class="dot-card-count">{{ commandes|length }}</span>
        </div>

        {% if commandes is empty %}
            <p class="dot-empty">Aucune commande pour cette saison.</p>
        {% else %}
            <div class="table-wrapper">
                <table class="table resp-table">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Fournisseur</th>
                            <th>Articles</th>
                            <th>Statut</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commande in commandes %}
                            <tr>
                                <td><span class="dot-item-nom">CMD-{{ commande.id }}</span></td>
                                <td>{{ commande.fournisseurLabel }}</td>
                                <td>{{ commande.quantiteTotale }}</td>
                                <td><span class="cmd-badge cmd-badge-{{ commande.statut.value }}">{{ commande.statut.label }}</span></td>
                                <td>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y') : '—' }}</td>
                                <td class="dot-table-action"><a href="{{ path('admin_commandes_show', {id: commande.id}) }}" class="btn btn-secondary btn-sm">Ouvrir</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
