{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Corriger l'identité de {{ licencie.nomPrenom }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Licenciés', route: 'admin_licencies_list' },
    { label: licencie.nomPrenom, route: 'admin_licencies_show', params: { uuid: licencie.uuid } },
    { label: 'Corriger l\'identité' }
] } %}

<div class="season-form-page">

    {{ form_start(form, { attr: { class: 'season-form-card licencie-new-card' } }) }}

        <h1 class="season-form-header">Corriger l'identité</h1>
        <p class="licencie-new-intro">
            Ces données seront automatiquement mises à jour lors du prochain import FootClubs si le numéro de licence est renseigné.
        </p>

        <hr class="season-form-divider">

        <p class="licencie-edit-section">Identité</p>

        <div class="season-form-row">
            <div class="season-form-field">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="season-form-field">
                {{ form_label(form.prenom) }}
                {{ form_widget(form.prenom) }}
                {{ form_errors(form.prenom) }}
            </div>
        </div>

        <div class="season-form-row">
            <div class="season-form-field">
                {{ form_label(form.dateNaissance) }}
                {{ form_widget(form.dateNaissance) }}
                {{ form_errors(form.dateNaissance) }}
            </div>
            <div class="season-form-field">
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                {{ form_errors(form.category) }}
            </div>
        </div>

        <div class="season-form-field">
            {{ form_label(form.numLicence) }}
            {{ form_widget(form.numLicence) }}
            {{ form_errors(form.numLicence) }}
            <p class="licencie-new-hint">Si renseigné, le prochain import FootClubs retrouvera ce licencié et mettra à jour ses données automatiquement.</p>
        </div>

        <hr class="season-form-divider">

        <p class="licencie-edit-section">Contact</p>

        <div class="season-form-row">
            <div class="season-form-field">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
            </div>
            <div class="season-form-field">
                {{ form_label(form.telephone) }}
                {{ form_widget(form.telephone) }}
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="season-form-actions">
            <a href="{{ path('admin_licencies_show', { uuid: licencie.uuid }) }}" class="season-form-cancel">Annuler</a>
            <button type="submit" class="season-form-submit">Enregistrer</button>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
