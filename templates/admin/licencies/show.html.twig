{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ licencie.nomPrenom }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Licenciés', route: 'admin_licencies_list' },
    { label: licencie.nomPrenom }
] } %}

{# Form caché pour "Valider quand même" — hors de la modale pour éviter l'imbrication <form> #}
{% if licencie.dossierClub and licencie.dossierClub.status.value != 'validated' %}
<form id="validate-manually-form-{{ licencie.uuid }}"
      method="post"
      action="{{ path('admin_licencies_validate_manually', {uuid: licencie.uuid}) }}"
      style="display:none">
    <input type="hidden" name="_token" value="{{ csrf_token('validate_manually_' ~ licencie.uuid) }}">
</form>
{% endif %}

<div class="licencie-show-page"
     x-data="{
        paymentsModal: {{ app.request.query.get('paymentsModal') == '1' ? 'true' : 'false' }},
        addMode: '{{ paymentModes[0].value ?? '' }}',
        addMontant: {{ remainingAmount|number_format(2, '.', '') }},
        addDate: '{{ 'now'|date('Y-m-d') }}',
        addReference: '',
        addNote: ''
     }">

    {# — Modale gestion des paiements — #}
    <div x-show="paymentsModal" class="licencie-modal-backdrop" @click.self="paymentsModal = false" x-cloak>
        <div class="licencie-modal licencie-modal-wide">
            <div class="licencie-modal-header">
                <h2 class="licencie-modal-title">Gestion des paiements</h2>
                <button type="button" @click="paymentsModal = false" class="licencie-modal-close">✕</button>
            </div>

            {# Bilan #}
            <div class="licencie-payments-bilan">
                <div class="licencie-payments-bilan-item">
                    <span class="licencie-payments-bilan-label">Attendu</span>
                    <span class="licencie-payments-bilan-value">{{ montant }} €</span>
                </div>
                <div class="licencie-payments-bilan-sep"></div>
                <div class="licencie-payments-bilan-item">
                    <span class="licencie-payments-bilan-label">Payé</span>
                    <span class="licencie-payments-bilan-value licencie-payments-bilan-paid">{{ totalPaid|number_format(2, ',', ' ') }} €</span>
                </div>
                <div class="licencie-payments-bilan-sep"></div>
                <div class="licencie-payments-bilan-item">
                    <span class="licencie-payments-bilan-label">Reste</span>
                    {% if remainingAmount > 0 %}
                        <span class="licencie-payments-bilan-value licencie-payments-bilan-remaining">{{ remainingAmount|number_format(2, ',', ' ') }} €</span>
                    {% else %}
                        <span class="licencie-payments-bilan-value licencie-payments-bilan-ok">Soldé ✓</span>
                    {% endif %}
                </div>
            </div>

            {# Liste des paiements existants #}
            {% if transactions is not empty %}
            <ul class="licencie-payments-list">
                {% for t in transactions %}
                <li class="licencie-payment-row">
                    <div class="licencie-payment-main">
                        <span class="licencie-payment-date">{{ t.datePaiement|date('d/m/Y') }}</span>
                        <span class="licencie-payment-mode">{{ t.mode.label() }}</span>
                        <span class="licencie-payment-amount">{{ t.montant }} €</span>
                    </div>
                    {% if t.reference or t.note %}
                    <div class="licencie-payment-meta">
                        {% if t.reference %}<span class="licencie-payment-ref">Réf : {{ t.reference }}</span>{% endif %}
                        {% if t.note %}<span class="licencie-payment-note">{{ t.note }}</span>{% endif %}
                    </div>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <p class="licencie-payments-empty">Aucun paiement enregistré.</p>
            {% endif %}

            <hr class="licencie-modal-divider">

            {# Formulaire ajout paiement #}
            <form method="post" action="{{ path('admin_licencies_add_payment', {uuid: licencie.uuid}) }}" class="licencie-modal-form">
                <input type="hidden" name="_token" value="{{ csrf_token('add_payment_' ~ licencie.uuid) }}">

                <div class="licencie-modal-field">
                    <label class="licencie-modal-label">Mode de paiement *</label>
                    <select name="mode" x-model="addMode" required class="licencie-modal-input">
                        {% for m in paymentModes %}
                            <option value="{{ m.value }}">{{ m.label() }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="licencie-modal-row">
                    <div class="licencie-modal-field">
                        <label class="licencie-modal-label">Montant (€) *</label>
                        <input type="number" name="montant" x-model="addMontant" step="0.01" min="0.01" required class="licencie-modal-input">
                    </div>
                    <div class="licencie-modal-field">
                        <label class="licencie-modal-label">Date *</label>
                        <input type="date" name="date_paiement" x-model="addDate" required class="licencie-modal-input">
                    </div>
                </div>

                <div class="licencie-modal-field" x-show="['cheque', 'virement'].includes(addMode)">
                    <label class="licencie-modal-label">Référence <span class="licencie-modal-hint">(n° chèque, référence virement)</span></label>
                    <input type="text" name="reference" x-model="addReference" class="licencie-modal-input" placeholder="Ex : 1234567">
                </div>

                <div class="licencie-modal-field">
                    <label class="licencie-modal-label">Remarque <span class="licencie-modal-optional">(facultatif)</span></label>
                    <input type="text" name="note" x-model="addNote" class="licencie-modal-input" placeholder="Ex : 1er chèque sur 3">
                </div>

                <div class="licencie-modal-actions">
                    {% if licencie.dossierClub and licencie.dossierClub.status.value != 'validated' %}
                    <button type="submit"
                            form="validate-manually-form-{{ licencie.uuid }}"
                            class="licencie-modal-validate-manual"
                            onclick="return confirm('Valider la licence de {{ licencie.nomPrenom }} sans paiement complet ?')">
                        Valider quand même
                    </button>
                    {% endif %}
                    <button type="submit" class="licencie-modal-submit">Ajouter le paiement</button>
                </div>
            </form>
        </div>
    </div>

    <div class="licencie-show-header">
        <div class="licencie-show-header-main">
            <h1 class="licencie-show-title">{{ licencie.nomPrenom }}</h1>
            {% if licencie.dossierClub %}
                {% include 'components/_badge_status.html.twig' with { status: licencie.dossierClub.status.value } %}
            {% endif %}
        </div>

        <div class="licencie-show-header-actions">
            <a href="{{ path('admin_licencies_edit', {uuid: licencie.uuid}) }}" class="licencie-show-edit-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
                Modifier
            </a>

            {% if licencie.dossierClub is null or licencie.dossierClub.status.value == 'link_sent' %}
                {% if licencie.email %}
                    <form method="post" action="{{ path('admin_licencies_send_link', {uuid: licencie.uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('send_link_' ~ licencie.uuid) }}">
                        <button type="submit" class="licencie-show-send-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="2" x2="11" y2="13"/>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                            </svg>
                            Envoyer le lien
                        </button>
                    </form>
                {% else %}
                    <span class="licencie-show-no-email">Pas d'email renseigné</span>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="licencie-show-grid">

        {# — Données FootClubs — #}
        <div class="licencie-show-card">
            <div class="licencie-show-card-title-row">
                <h2 class="licencie-show-card-title">
                    {% if licencie.createdManually %}Données saisies manuellement{% else %}Données FootClubs{% endif %}
                </h2>
                {% if licencie.createdManually %}
                    <a href="{{ path('admin_licencies_edit_identity', {uuid: licencie.uuid}) }}"
                       class="licencie-show-identity-edit-btn"
                       title="Corriger les données d'identité">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Corriger
                    </a>
                {% endif %}
            </div>

            <dl class="licencie-show-dl">
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">N° licence</dt>
                    <dd class="{{ licencie.numLicence ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ licencie.numLicence ?? '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Date de naissance</dt>
                    <dd class="licencie-show-dd">{{ licencie.dateNaissance|date('d/m/Y') }}</dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Catégorie</dt>
                    <dd class="licencie-show-dd">{{ licencie.category.label }}</dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Équipe</dt>
                    <dd class="{{ licencie.team ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ licencie.team ? licencie.team.name : '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Email</dt>
                    <dd class="{{ licencie.email ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ licencie.email ?? '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Téléphone</dt>
                    <dd class="{{ licencie.telephone ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ licencie.telephone|phone_format }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Adresse</dt>
                    <dd class="{{ licencie.voieRue ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {% if licencie.voieRue %}
                            {{ licencie.voieRue }}<br>
                            {{ licencie.codePostal }} {{ licencie.ville }}
                        {% else %}
                            —
                        {% endif %}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Importé le</dt>
                    <dd class="licencie-show-dd">{{ licencie.importedAt|date('d/m/Y à H:i') }}</dd>
                </div>
            </dl>
        </div>

        {# — Dossier club — #}
        <div class="licencie-show-card">
            <h2 class="licencie-show-card-title">Dossier club</h2>

            {% if licencie.dossierClub %}
                {% set d = licencie.dossierClub %}

                <dl class="licencie-show-dl">
                    <div class="licencie-show-dl-row">
                        <dt class="licencie-show-dt">Taille haut</dt>
                        <dd class="{{ d.tailleHaut ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ d.tailleHaut ?? '—' }}</dd>
                    </div>
                    <div class="licencie-show-dl-row">
                        <dt class="licencie-show-dt">Taille bas</dt>
                        <dd class="{{ d.tailleBas ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ d.tailleBas ?? '—' }}</dd>
                    </div>
                    <div class="licencie-show-dl-row">
                        <dt class="licencie-show-dt">Pointure</dt>
                        <dd class="{{ d.pointure ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ d.pointure ?? '—' }}</dd>
                    </div>
                    {% if d.paymentIntentions is not empty %}
                    <div class="licencie-show-dl-row">
                        <dt class="licencie-show-dt">Intention paiement</dt>
                        <dd class="licencie-show-dd">
                            {{ d.paymentIntentions|map(m => m.label())|join(', ') }}
                        </dd>
                    </div>
                    {% endif %}
                </dl>

                <hr class="licencie-show-divider">

                <ul class="licencie-show-checklist">

                    {# Règlement signé #}
                    <li class="licencie-show-check-item">
                        {% if d.isSigned %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span class="licencie-show-check-label">Règlement signé</span>
                            {% if d.signatureDate %}
                                <span class="licencie-show-check-date">le {{ d.signatureDate|date('d/m/Y') }}</span>
                            {% endif %}
                        {% else %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="licencie-show-check-label licencie-show-check-label-pending">Règlement signé</span>
                            <span class="licencie-show-check-badge-pending">En attente</span>
                        {% endif %}
                    </li>

                    {# Droit à l'image #}
                    <li class="licencie-show-check-item">
                        {% if d.autorisationPhoto is null %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="licencie-show-check-label licencie-show-check-label-pending">Droit à l'image</span>
                            <span class="licencie-show-check-badge-pending">En attente</span>
                        {% elseif d.autorisationPhoto %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span class="licencie-show-check-label">Droit à l'image</span>
                            <span class="licencie-show-check-badge-yes">Accordé</span>
                        {% else %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            <span class="licencie-show-check-label">Droit à l'image</span>
                            <span class="licencie-show-check-badge-no">Refusé</span>
                        {% endif %}
                    </li>

                    {% if licencie.category.isJeune %}
                        {# Autorisation accident #}
                        <li class="licencie-show-check-item">
                            {% if d.autorisationAccident is null %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="licencie-show-check-label licencie-show-check-label-pending">Autorisation accident</span>
                                <span class="licencie-show-check-badge-pending">En attente</span>
                            {% elseif d.autorisationAccident %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="licencie-show-check-label">Autorisation accident</span>
                                <span class="licencie-show-check-badge-yes">Accordé</span>
                            {% else %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                <span class="licencie-show-check-label">Autorisation accident</span>
                                <span class="licencie-show-check-badge-no">Refusé</span>
                            {% endif %}
                        </li>

                        {# Transport dirigeants #}
                        <li class="licencie-show-check-item">
                            {% if d.autorisationTransportDirigeants is null %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="licencie-show-check-label licencie-show-check-label-pending">Transport dirigeants</span>
                                <span class="licencie-show-check-badge-pending">En attente</span>
                            {% elseif d.autorisationTransportDirigeants %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="licencie-show-check-label">Transport dirigeants</span>
                                <span class="licencie-show-check-badge-yes">Accordé</span>
                            {% else %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                <span class="licencie-show-check-label">Transport dirigeants</span>
                                <span class="licencie-show-check-badge-no">Refusé</span>
                            {% endif %}
                        </li>

                        {# Transport parents #}
                        <li class="licencie-show-check-item">
                            {% if d.autorisationTransportParents is null %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="licencie-show-check-label licencie-show-check-label-pending">Transport parents</span>
                                <span class="licencie-show-check-badge-pending">En attente</span>
                            {% elseif d.autorisationTransportParents %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="licencie-show-check-label">Transport parents</span>
                                <span class="licencie-show-check-badge-yes">Accordé</span>
                            {% else %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                <span class="licencie-show-check-label">Transport parents</span>
                                <span class="licencie-show-check-badge-no">Refusé</span>
                            {% endif %}
                        </li>

                        {# Volontaire transport #}
                        <li class="licencie-show-check-item">
                            {% if d.volontaireTransport is null %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="licencie-show-check-label licencie-show-check-label-pending">Volontaire transport</span>
                                <span class="licencie-show-check-badge-pending">En attente</span>
                            {% elseif d.volontaireTransport %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="licencie-show-check-label">Volontaire transport</span>
                                <span class="licencie-show-check-badge-yes">Oui</span>
                            {% else %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                <span class="licencie-show-check-label">Volontaire transport</span>
                                <span class="licencie-show-check-badge-neutral">Non</span>
                            {% endif %}
                        </li>

                        {# Attestation transport — uniquement si le parent est volontaire #}
                        {% if d.volontaireTransport %}
                        <li class="licencie-show-check-item licencie-show-check-item-sub">
                            {% if d.attestationTransportDriveId is not null and not (d.attestationTransportDriveId starts with '/') %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                <span class="licencie-show-check-label">Attestation transport</span>
                                <span class="licencie-show-check-badge-yes">Archivée sur Drive</span>
                            {% else %}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                <span class="licencie-show-check-label licencie-show-check-label-pending">Attestation transport</span>
                                <span class="licencie-show-check-badge-pending">Upload en attente</span>
                            {% endif %}
                        </li>
                        {% endif %}
                    {% endif %}

                    {# Paiement cotisation #}
                    <li class="licencie-show-check-item">
                        {% if d.status.value == 'validated' %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            <span class="licencie-show-check-label">Paiement cotisation</span>
                            <span class="licencie-show-check-date">{{ totalPaid|number_format(2, ',', ' ') }} € / {{ montant }} €</span>
                        {% elseif transactions is not empty %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="licencie-show-check-label licencie-show-check-label-pending">Paiement cotisation</span>
                            <span class="licencie-show-check-date">{{ totalPaid|number_format(2, ',', ' ') }} € / {{ montant }} €</span>
                        {% else %}
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span class="licencie-show-check-label licencie-show-check-label-pending">Paiement cotisation</span>
                            <span class="licencie-show-check-badge-pending">En attente</span>
                        {% endif %}
                    </li>

                </ul>

                {# Bouton gérer les paiements #}
                {% if d.isSigned %}
                    <button type="button" @click="paymentsModal = true" class="licencie-show-confirm-full">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                        </svg>
                        Gérer les paiements
                    </button>
                {% endif %}

            {% else %}
                <p class="licencie-show-empty">Aucun dossier club — le lien d'inscription n'a pas encore été complété.</p>
            {% endif %}
        </div>

        {# — Historique — #}
        <div class="licencie-show-card licencie-show-card-full">
            <h2 class="licencie-show-card-title">Historique</h2>
            <ul class="licencie-show-history">
                {% for event in history %}
                    <li class="licencie-show-history-item {{ not loop.last ? 'licencie-show-history-item-sep' }}">
                        <span class="licencie-show-history-date">{{ event.date|date(event.format ?? 'd/m/Y à H:i') }}</span>
                        <span class="licencie-show-history-label">{{ event.label }}</span>
                        <span class="licencie-show-history-who">{{ event.who }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {# — Paiements — #}
        {% if transactions is not empty or (licencie.dossierClub and licencie.dossierClub.paymentIntentions is not empty) %}
        <div class="licencie-show-card licencie-show-card-full">
            <div class="licencie-show-card-title-row">
                <h2 class="licencie-show-card-title">Paiements</h2>
                <span class="licencie-payments-total">
                    {{ totalPaid|number_format(2, ',', ' ') }} € / {{ montant }} €
                </span>
            </div>

            {% if transactions is not empty %}
            <table class="licencie-show-dotations-table licencie-payments-table">
                <thead>
                    <tr>
                        <th>Mode</th>
                        <th>Montant</th>
                        <th>Date</th>
                        <th>Référence</th>
                        <th>Remarque</th>
                    </tr>
                </thead>
                <tbody>
                    {% for t in transactions %}
                    <tr>
                        <td class="licencie-show-dd">{{ t.mode.label() }}</td>
                        <td class="licencie-show-dd">{{ t.montant }} €</td>
                        <td class="licencie-show-dd-empty">{{ t.datePaiement|date('d/m/Y') }}</td>
                        <td class="licencie-show-dd-empty">{{ t.reference ?? '—' }}</td>
                        <td class="licencie-show-dd-empty">{{ t.note ?? '—' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="licencie-show-empty">Aucun paiement enregistré.</p>
            {% endif %}
        </div>
        {% endif %}

        {# — Dotations stock — #}
        {% if dotations is not empty %}
        <div class="licencie-show-card licencie-show-card-full">
            <h2 class="licencie-show-card-title">Équipements attribués</h2>
            <table class="licencie-show-dotations-table">
                <thead>
                    <tr>
                        <th>Article</th>
                        <th>Quantité</th>
                        <th>Note</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for d in dotations %}
                        <tr>
                            <td>
                                <span class="licencie-show-dd">{{ d.item.nom }}</span>
                                {% if d.item.couleur %}<span class="licencie-show-dd-empty" style="font-size:var(--font-size-xs)"> — {{ d.item.couleur }}</span>{% endif %}
                            </td>
                            <td class="licencie-show-dd">{{ d.quantite }}</td>
                            <td class="licencie-show-dd-empty">{{ d.note ?? '—' }}</td>
                            <td class="licencie-show-dd-empty">{{ d.createdAt|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

    </div>

</div>{# fin x-data #}
{% endblock %}
