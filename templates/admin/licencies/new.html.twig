{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Nouveau licencié{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Licenciés', route: 'admin_licencies_list' },
    { label: 'Nouveau licencié' }
] } %}

<div class="season-form-page">

    {{ form_start(form, { attr: { class: 'season-form-card licencie-new-card' } }) }}

        <h1 class="season-form-header">Ajouter un licencié manuellement</h1>
        <p class="licencie-new-intro">Utilisez ce formulaire si FootClubs n'est pas disponible. Le numéro FootClubs est facultatif : il pourra être complété lors du prochain import.</p>

        <hr class="season-form-divider">

        <p class="licencie-edit-section">Identité</p>

        <div class="season-form-row">
            <div class="field">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="field">
                {{ form_label(form.prenom) }}
                {{ form_widget(form.prenom, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.prenom) }}
            </div>
        </div>

        <div class="season-form-row">
            <div class="field">
                {{ form_label(form.dateNaissance) }}
                {{ form_widget(form.dateNaissance, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.dateNaissance) }}
            </div>
            <div class="field">
                {{ form_label(form.category) }}
                {{ form_widget(form.category, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.category) }}
            </div>
        </div>

        <div class="season-form-row">
            <div class="field">
                {{ form_label(form.team) }}
                {{ form_widget(form.team, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.team) }}
            </div>
        </div>

        <div class="field">
            {{ form_label(form.numLicence) }}
            {{ form_widget(form.numLicence, { attr: { class: 'field-input' } }) }}
            {{ form_errors(form.numLicence) }}
            <p class="licencie-new-hint">Facultatif si l'export FootClubs est indisponible. Sera mis à jour automatiquement lors du prochain import.</p>
        </div>

        <hr class="season-form-divider">

        <p class="licencie-edit-section">Contact</p>

        <div class="season-form-row">
            <div class="field">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.email) }}
            </div>
            <div class="field">
                {{ form_label(form.telephone) }}
                {{ form_widget(form.telephone, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="field">
            {{ form_label(form.voieRue) }}
            {{ form_widget(form.voieRue, { attr: { class: 'field-input' } }) }}
            {{ form_errors(form.voieRue) }}
        </div>

        <div class="season-form-row">
            <div class="field">
                {{ form_label(form.codePostal) }}
                {{ form_widget(form.codePostal, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.codePostal) }}
            </div>
            <div class="field">
                {{ form_label(form.ville) }}
                {{ form_widget(form.ville, { attr: { class: 'field-input' } }) }}
                {{ form_errors(form.ville) }}
            </div>
        </div>

        <hr class="season-form-divider">

        <div class="licencie-new-checkbox">
            {{ form_widget(form.sendLink) }}
            {{ form_label(form.sendLink) }}
            {{ form_errors(form.sendLink) }}
        </div>

        <div class="season-form-actions">
            <a href="{{ path('admin_licencies_list') }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary btn-lg">Ajouter le licencié</button>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
