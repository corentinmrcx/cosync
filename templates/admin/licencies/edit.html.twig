{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Modifier {{ licencie.nomPrenom }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Licenciés', route: 'admin_licencies_list' },
    { label: licencie.nomPrenom, route: 'admin_licencies_show', params: { uuid: licencie.uuid } },
    { label: 'Modifier' }
] } %}

<div class="season-form-page">

    {{ form_start(form, { attr: { class: 'season-form-card licencie-edit-card' } }) }}

        <h1 class="season-form-header">{{ licencie.nomPrenom }}</h1>

        <hr class="season-form-divider">

        {# — Équipe — #}
        <p class="licencie-edit-section">Équipe</p>

        <div class="season-form-field">
            {{ form_label(form.team) }}
            {{ form_widget(form.team) }}
            {{ form_errors(form.team) }}
        </div>

        <hr class="season-form-divider">

        {# — Équipement — #}
        <p class="licencie-edit-section">Équipement</p>

        {% if licencie.dossierClub is null %}
            <p class="licencie-edit-note">Le licencié n'a pas encore complété son formulaire d'inscription.</p>
        {% endif %}

        <div class="season-form-field">
            {{ form_label(form.tailleHaut) }}
            {{ form_widget(form.tailleHaut) }}
            {{ form_errors(form.tailleHaut) }}
        </div>

        <div class="season-form-field">
            {{ form_label(form.tailleBas) }}
            {{ form_widget(form.tailleBas) }}
            {{ form_errors(form.tailleBas) }}
        </div>

        <div class="season-form-field">
            {{ form_label(form.pointure) }}
            {{ form_widget(form.pointure) }}
            {{ form_errors(form.pointure) }}
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>

    {{ form_end(form) }}

</div>
{% endblock %}
