{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Joueurs{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Joueurs' }
] } %}

<div class="licencies-page">

    {% embed 'components/list-toolbar.html.twig' with {
        search: search ?? '',
        searchPlaceholder: 'Rechercher un licencié…',
        filterGroups: filterGroups,
        activeCount: activeFilterCount,
        resetUrl: path('admin_licencies_list', {search: search ?? ''}),
        formId: 'licencies'
    } %}
        {% block actions %}
            <a href="{{ path('admin_licencies_new') }}" class="licencies-add-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nouveau
            </a>
        {% endblock %}
    {% endembed %}

    {% if licencies is empty %}
        <div class="licencies-empty">
            <p>Aucun licencié trouvé.</p>
        </div>
    {% else %}
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nom / Prénom</th>
                        <th class="licencies-col-team">Équipe</th>
                        <th class="licencies-col-email">Email</th>
                        <th class="licencies-col-status">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for licencie in licencies %}
                        <tr class="licencies-row"
                            onclick="window.location='{{ path('admin_licencies_show', {uuid: licencie.uuid}) }}'">
                            <td class="licencies-td-name">{{ licencie.nomPrenom }}</td>
                            <td class="licencies-col-team">{{ licencie.team ? licencie.team.name : '—' }}</td>
                            <td class="licencies-col-email licencies-td-muted">{{ licencie.email ?? '—' }}</td>
                            <td class="licencies-col-status">
                                {% if licencie.dossierClub %}
                                    {% include 'components/_badge_status.html.twig' with { status: licencie.dossierClub.status.value } %}
                                {% else %}
                                    <span class="licencies-td-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="licencies-footer">
            <p class="licencies-count">{{ total }} licencié{{ total > 1 ? 's' : '' }}</p>

            {% if pages > 1 %}
                <nav class="licencies-pagination">
                    {% if page > 1 %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: page - 1})) }}"
                           class="licencies-page-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"/>
                            </svg>
                        </a>
                    {% endif %}

                    {% for p in 1..pages %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: p})) }}"
                           class="licencies-page-btn {{ p == page ? 'licencies-page-btn-active' : '' }}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if page < pages %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: page + 1})) }}"
                           class="licencies-page-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
