{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Joueurs{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Joueurs' }
] } %}

<div class="licencies-page">

    {% if liensEnAttente > 0 or signaturesEnAttente > 0 or relancesEnAttente > 0 or aValiderFff > 0 %}
        <div class="effectif-alertes">

            {% if liensEnAttente > 0 %}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: liensEnAttente,
                    url: path('admin_licencies_send_links'),
                    libelle: 'Envoyer les liens',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> licencié{{ nb > 1 ? 's' }} n'{{ nb > 1 ? 'ont' : 'a' }}
                        jamais reçu {{ nb > 1 ? 'leur' : 'son' }} lien d'inscription.
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if signaturesEnAttente > 0 %}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: signaturesEnAttente,
                    url: path('admin_licencies_request_signatures'),
                    libelle: 'Demander les signatures',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> licencié{{ nb > 1 ? 's' }} {{ nb > 1 ? 'ont' : 'a' }}
                        un document à signer — ajouté après {{ nb > 1 ? 'leur' : 'son' }} inscription.
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if relancesEnAttente > 0 %}
                {# Le robot enverra la même liste cette nuit s'il est allumé ; l'alerte
                   reste utile dans les deux cas : allumé, elle dit ce qui va partir. #}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: relancesEnAttente,
                    url: path('admin_licencies_relancer'),
                    libelle: 'Relancer',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> licence{{ nb > 1 ? 's' }} non soldée{{ nb > 1 ? 's' }}
                        {{ nb > 1 ? 'attendent' : 'attend' }} une relance.
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if aValiderFff > 0 %}
                {# Ne s'adresse à personne : c'est le club qui a une démarche à faire. #}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: aValiderFff,
                    url: path('admin_licencies_validate_fff_bulk'),
                    libelle: 'Valider sur FootClubs',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> licence{{ nb > 1 ? 's' }} {{ nb > 1 ? 'sont' : 'est' }}
                        payée{{ nb > 1 ? 's' }} et {{ nb > 1 ? 'restent' : 'reste' }} à valider sur FootClubs.
                    {% endblock %}
                {% endembed %}
            {% endif %}

        </div>
    {% endif %}

    {% embed 'components/list-toolbar.html.twig' with {
        search: search ?? '',
        searchPlaceholder: 'Rechercher un licencié…',
        filterGroups: filterGroups,
        activeCount: activeFilterCount,
        resetUrl: path('admin_licencies_list', {search: search ?? ''}),
        formId: 'licencies'
    } %}
        {% block actions %}
            {# Réservé au compte de diagnostic : supprimer une fiche est le seul geste
               irréversible de cet écran. #}
            {% if is_granted('ACCES_DIAGNOSTIC') and not edition %}
                <a href="{{ path('admin_licencies_list', app.request.query.all|merge({edition: 1})) }}" class="btn btn-secondary">
                    Mode édition
                </a>
            {% endif %}
            <a href="{{ path('admin_licencies_new') }}" class="licencies-add-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nouveau
            </a>
        {% endblock %}
    {% endembed %}

    {% if edition %}
        {% include 'components/_edition_bandeau.html.twig' with {
            quitterUrl: path('admin_licencies_list', app.request.query.all|filter((v, k) => k != 'edition')),
            population: 'joueurs'
        } only %}
    {% endif %}

    {% if licencies is empty %}
        <div class="licencies-empty">
            <p>Aucun licencié trouvé.</p>
        </div>
    {% else %}
        {# En mode édition la ligne ne mène plus à la fiche : le seul geste possible est de
           cocher. Mélanger navigation et sélection sur le même clic ferait ouvrir une fiche
           alors qu'on croyait la désigner. #}
        {% if edition %}
        <form method="post"
              action="{{ path('admin_licencies_delete_confirm') }}"
              x-data="{ selection: [] }">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer_licencies') }}">
        {% endif %}

            {# Sur téléphone, chaque ligne devient une carte : six colonnes ne se lisent pas
               sur 360 px. Cf. `.table-cartes` dans components/data-table.css. #}
            <div class="table-wrapper table-cartes">
                <table class="table table-cliquable">
                    <thead>
                        <tr>
                            {% if edition %}<th class="edition-col-check"></th>{% endif %}
                            <th>Nom / Prénom</th>
                            <th class="licencies-col-team">Équipe</th>
                            <th class="licencies-col-email">Email</th>
                            <th class="licencies-col-status">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for licencie in licencies %}
                            <tr class="licencies-row {{ edition ? 'edition-row' }}"
                                {% if not edition %}onclick="window.location='{{ path('admin_licencies_show', {uuid: licencie.uuid}) }}'"{% endif %}>
                                {% if edition %}
                                    <td class="edition-col-check">
                                        <input type="checkbox"
                                               class="edition-check"
                                               name="licencies[]"
                                               value="{{ licencie.uuid }}"
                                               x-model="selection"
                                               aria-label="Sélectionner {{ licencie.nomPrenom }}">
                                    </td>
                                {% endif %}
                                <td class="licencies-td-name carte-titre">{{ licencie.nomPrenom }}</td>
                                <td class="licencies-col-team carte-meta">{{ licencie.team ? licencie.team.name : 'Sans équipe' }}</td>
                                <td class="licencies-col-email licencies-td-muted carte-meta">{{ licencie.email ?? 'Pas d\'email' }}</td>
                                <td class="licencies-col-status">
                                    {% if licencie.dossierClub %}
                                        {% include 'components/_badge_status.html.twig' with { status: licencie.dossierClub.status.value } %}
                                    {% else %}
                                        <span class="licencies-td-muted">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        {% if edition %}
            {% include 'components/_edition_barre.html.twig' %}
        </form>
        {% endif %}

        <div class="licencies-footer">
            <p class="licencies-count">{{ total }} licencié{{ total > 1 ? 's' : '' }}</p>

            {% if pages > 1 %}
                <nav class="licencies-pagination">
                    {% if page > 1 %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: page - 1})) }}"
                           class="licencies-page-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"/>
                            </svg>
                        </a>
                    {% endif %}

                    {% for p in 1..pages %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: p})) }}"
                           class="licencies-page-btn {{ p == page ? 'licencies-page-btn-active' : '' }}">
                            {{ p }}
                        </a>
                    {% endfor %}

                    {% if page < pages %}
                        <a href="{{ path('admin_licencies_list', app.request.query.all|merge({page: page + 1})) }}"
                           class="licencies-page-btn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
