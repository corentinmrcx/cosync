{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Supprimer des dirigeants{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Dirigeants', route: 'admin_dirigeants_list' },
    { label: 'Supprimer' }
] } %}

<div class="dirigeants-page">
    <h1 class="dirigeants-suppr-titre">Retirer ces dirigeants de la saison ?</h1>

    {% include 'components/_edition_confirmation.html.twig' with {
        analyses: analyses,
        actionUrl: path('admin_dirigeants_delete'),
        tokenId: 'supprimer_dirigeants_confirmer',
        champ: 'dirigeants',
        retourUrl: path('admin_dirigeants_list', {edition: 1})
    } only %}
</div>
{% endblock %}
