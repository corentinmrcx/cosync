{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Dirigeants{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Dirigeants' }
] } %}

<div class="dirigeants-page">

    {% if liensEnAttente > 0 or signaturesEnAttente > 0 or aValiderFff > 0 %}
        <div class="effectif-alertes">

            {% if liensEnAttente > 0 %}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: liensEnAttente,
                    url: path('admin_dirigeants_send_links'),
                    libelle: 'Envoyer les liens',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> dirigeant{{ nb > 1 ? 's' }} n'{{ nb > 1 ? 'ont' : 'a' }}
                        jamais reçu {{ nb > 1 ? 'leur' : 'son' }} lien de formulaire.
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if signaturesEnAttente > 0 %}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: signaturesEnAttente,
                    url: path('admin_dirigeants_request_signatures'),
                    libelle: 'Demander les signatures',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> dirigeant{{ nb > 1 ? 's' }} {{ nb > 1 ? 'ont' : 'a' }}
                        un document à signer — ajouté après {{ nb > 1 ? 'leur' : 'son' }} inscription.
                    {% endblock %}
                {% endembed %}
            {% endif %}

            {% if aValiderFff > 0 %}
                {# Ne s'adresse à personne : c'est le club qui a une démarche à faire. #}
                {% embed 'components/_effectif_alerte.html.twig' with {
                    nb: aValiderFff,
                    url: path('admin_dirigeants_validate_fff_bulk'),
                    libelle: 'Valider sur FootClubs',
                } only %}
                    {% block texte %}
                        <strong>{{ nb }}</strong> licence{{ nb > 1 ? 's' }} dirigeant{{ nb > 1 ? 's' }}
                        {{ nb > 1 ? 'restent' : 'reste' }} à valider sur FootClubs.
                    {% endblock %}
                {% endembed %}
            {% endif %}

        </div>
    {% endif %}

    {% embed 'components/list-toolbar.html.twig' with {
        search: search ?? '',
        searchPlaceholder: 'Rechercher un dirigeant…',
        filterGroups: filterGroups,
        activeCount: activeFilterCount,
        resetUrl: path('admin_dirigeants_list', {search: search ?? ''}),
        formId: 'dirigeants'
    } %}
        {% block actions %}
            {# Réservé au compte de diagnostic : supprimer une fiche est le seul geste
               irréversible de cet écran. #}
            {% if is_granted('ACCES_DIAGNOSTIC') and not edition %}
                <a href="{{ path('admin_dirigeants_list', app.request.query.all|merge({edition: 1})) }}" class="btn btn-secondary">
                    Mode édition
                </a>
            {% endif %}
            <a href="{{ path('admin_dirigeants_new') }}" class="btn btn-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Nouveau dirigeant
            </a>
        {% endblock %}
    {% endembed %}

    {% if edition %}
        {% include 'components/_edition_bandeau.html.twig' with {
            quitterUrl: path('admin_dirigeants_list', app.request.query.all|filter((v, k) => k != 'edition')),
            population: 'dirigeants'
        } only %}
    {% endif %}

    {% if dirigeants is empty %}
        <div class="dirigeants-empty">
            <p>Aucun dirigeant trouvé.</p>
        </div>
    {% else %}
        {# Même règle que côté joueurs : en mode édition la ligne ne mène plus à la fiche. #}
        {% if edition %}
        <form method="post"
              action="{{ path('admin_dirigeants_delete_confirm') }}"
              x-data="{ selection: [] }">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer_dirigeants') }}">
        {% endif %}

            {# Même passage en cartes que la liste des joueurs (cf. `.table-cartes`). #}
            <div class="table-wrapper table-cartes">
                <table class="table table-cliquable">
                    <thead>
                        <tr>
                            {% if edition %}<th class="edition-col-check"></th>{% endif %}
                            <th>Nom / Prénom</th>
                            <th class="dirigeants-col-role">Rôle</th>
                            <th class="dirigeants-col-team">Équipe</th>
                            <th class="dirigeants-col-email">Email</th>
                            <th class="dirigeants-col-status">Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for dirigeant in dirigeants %}
                            <tr class="dirigeants-row {{ edition ? 'edition-row' }}"
                                {% if not edition %}onclick="window.location='{{ path('admin_dirigeants_show', {uuid: dirigeant.uuid}) }}'"{% endif %}>
                                {% if edition %}
                                    <td class="edition-col-check">
                                        <input type="checkbox"
                                               class="edition-check"
                                               name="dirigeants[]"
                                               value="{{ dirigeant.uuid }}"
                                               x-model="selection"
                                               aria-label="Sélectionner {{ dirigeant.nomPrenom }}">
                                    </td>
                                {% endif %}
                                <td class="dirigeants-td-name carte-titre">{{ dirigeant.nomPrenom }}</td>
                                <td class="dirigeants-col-role dirigeants-td-muted carte-meta">
                                    {{ dirigeant.role.label() }}
                                </td>
                                <td class="dirigeants-col-team dirigeants-td-muted carte-meta">{{ dirigeant.team ? dirigeant.team.name : 'Sans équipe' }}</td>
                                <td class="dirigeants-col-email dirigeants-td-muted carte-meta">{{ dirigeant.email ?? 'Pas d\'email' }}</td>
                                <td class="dirigeants-col-status">
                                    {# La licence administrative est un statut à part entière :
                                       la mention « licence district » de la colonne Rôle faisait
                                       double emploi, elle a disparu au profit du badge. #}
                                    {% include 'components/_badge_status.html.twig' with { status: statuts[dirigeant.uuid].value } %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        {% if edition %}
            {% include 'components/_edition_barre.html.twig' %}
        </form>
        {% endif %}

        <div class="dirigeants-footer">
            <p class="dirigeants-count">{{ dirigeants|length }} dirigeant{{ dirigeants|length > 1 ? 's' : '' }}</p>
        </div>
    {% endif %}

</div>
{% endblock %}
