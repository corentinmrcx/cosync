{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ dirigeant.nomPrenom }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Dirigeants', route: 'admin_dirigeants_list' },
    { label: dirigeant.nomPrenom }
] } %}

<div class="licencie-show-page">

    <div class="licencie-show-header">
        <div>
            <div class="licencie-show-header-main">
                <h1 class="licencie-show-title">{{ dirigeant.nomPrenom }}</h1>
                <div class="licencie-show-badges">
                    {% include 'components/_badge_status.html.twig' with { status: statut.value } %}
                </div>
            </div>
            <p class="dirigeant-show-role">{{ dirigeant.role.label() }}</p>

            {# Cf. la fiche licencié : le dernier mail réellement parti, relances comprises. #}
            <p class="fiche-dernier-contact">
                {% if dernierContact %}
                    Dernier contact : <strong>{{ dernierContact.resume }}</strong>
                {% else %}
                    Aucun mail ne lui a encore été envoyé
                {% endif %}
            </p>
        </div>

        {% include 'components/_fiche_actions.html.twig' with {
            actions: actions,
            actionTemplate: 'admin/dirigeants/_action.html.twig',
            vars: { dirigeant: dirigeant },
        } only %}
    </div>

    <div class="licencie-show-grid">

        {# — Informations — #}
        <div class="licencie-show-card">
            <h2 class="licencie-show-card-title">
                {% if dirigeant.createdManually %}Données saisies manuellement{% else %}Données FootClubs{% endif %}
            </h2>

            <dl class="licencie-show-dl">
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">N° licence</dt>
                    <dd class="{{ dirigeant.numLicence ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ dirigeant.numLicence ?? '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Date de naissance</dt>
                    <dd class="{{ dirigeant.dateNaissance ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ dirigeant.dateNaissance ? dirigeant.dateNaissance|date('d/m/Y') : '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Email</dt>
                    <dd class="{{ dirigeant.email ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ dirigeant.email ?? '—' }}
                        {% if dirigeant.emailManuel and peut_acceder('admin_dirigeants_contact_reprendre_import') %}
                            {% include 'components/_contact_verrou.html.twig' with {
                                url: path('admin_dirigeants_contact_reprendre_import', { uuid: dirigeant.uuid, champ: 'email' }),
                                tokenId: 'dirigeant_contact_reprendre_import_' ~ dirigeant.uuid
                            } only %}
                        {% endif %}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Téléphone</dt>
                    <dd class="{{ dirigeant.telephone ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ dirigeant.telephone|phone_format }}
                        {% if dirigeant.telephoneManuel and peut_acceder('admin_dirigeants_contact_reprendre_import') %}
                            {% include 'components/_contact_verrou.html.twig' with {
                                url: path('admin_dirigeants_contact_reprendre_import', { uuid: dirigeant.uuid, champ: 'telephone' }),
                                tokenId: 'dirigeant_contact_reprendre_import_' ~ dirigeant.uuid
                            } only %}
                        {% endif %}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Équipe</dt>
                    <dd class="{{ dirigeant.team ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {{ dirigeant.team ? dirigeant.team.name : '—' }}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Profil joueur</dt>
                    <dd class="{{ dirigeant.licencie ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">
                        {% if dirigeant.licencie %}
                            <a href="{{ path('admin_licencies_show', {uuid: dirigeant.licencie.uuid}) }}"
                               style="color: var(--color-primary); text-decoration: none; font-weight: 600;">
                                {{ dirigeant.licencie.nomPrenom }} →
                            </a>
                        {% else %}
                            —
                        {% endif %}
                    </dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Ajouté le</dt>
                    <dd class="licencie-show-dd">{{ dirigeant.importedAt|date('d/m/Y à H:i') }}</dd>
                </div>
            </dl>
        </div>

        {# — Dossier club — #}
        <div class="licencie-show-card">
            <h2 class="licencie-show-card-title">Dossier club</h2>

            {# Licence administrative : aucun dossier n'est attendu. Les clés font exception —
               un président sans dossier club détient souvent le trousseau du local. #}
            {% if dirigeant.licenceAdministrative %}
                <p class="licencie-show-card-note">
                    Licence déclarée au district pour l'association. Aucun formulaire, aucun document
                    à signer et aucune dotation ne sont attendus pour cette personne.
                </p>
            {% else %}

            <dl class="licencie-show-dl">
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Taille haut</dt>
                    <dd class="{{ dirigeant.tailleHaut ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ dirigeant.tailleHaut ?? '—' }}</dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Taille bas</dt>
                    <dd class="{{ dirigeant.tailleBas ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ dirigeant.tailleBas ?? '—' }}</dd>
                </div>
                <div class="licencie-show-dl-row">
                    <dt class="licencie-show-dt">Pointure</dt>
                    <dd class="{{ dirigeant.pointure ? 'licencie-show-dd' : 'licencie-show-dd-empty' }}">{{ dirigeant.pointure ?? '—' }}</dd>
                </div>
            </dl>

            <hr class="licencie-show-divider">

            {% set photoVal = dirigeant.licencie
                ? (dirigeant.licencie.dossierClub ? dirigeant.licencie.dossierClub.autorisationPhoto : null)
                : dirigeant.autorisationPhoto %}
            {% endif %}

            <ul class="licencie-show-checklist">
                {% if not dirigeant.licenceAdministrative %}
                {# Droit à l'image #}
                {% include 'components/_checklist_item.html.twig' with {
                    etat: photoVal is null ? 'attente' : (photoVal ? 'accorde' : 'refuse'),
                    label: "Droit à l'image",
                    detail: photoVal is null ? null : (photoVal ? 'Accordé' : 'Refusé'),
                } only %}

                {# Transport des licenciés #}
                {% include 'components/_checklist_item.html.twig' with {
                    etat: dirigeant.volontaireTransport is null ? 'attente' : (dirigeant.volontaireTransport ? 'accorde' : 'refuse'),
                    label: "Transport des licenciés",
                    detail: dirigeant.volontaireTransport is null ? null : (dirigeant.volontaireTransport ? 'Accordé' : 'Refusé'),
                } only %}

                {# Attestation transport — uniquement si volontaire #}
                {% if dirigeant.volontaireTransport %}
                {% include 'components/_checklist_item.html.twig' with {
                    etat: dirigeant.attestationTransportEstArchivee ? 'fait' : 'attente',
                    label: 'Attestation transport',
                    detail: dirigeant.attestationTransportEstArchivee ? 'Archivée sur Drive' : 'Upload en attente',
                } only %}
                {% endif %}

                {# Documents à signer — la liste suit ce que la saison demande à ce dirigeant #}
                {% for doc in documents %}
                    {% set signature = signatures[doc.id] ?? null %}
                    {% include 'components/_checklist_item.html.twig' with {
                        etat: signature ? 'fait' : 'attente',
                        label: doc.titre,
                        detail: signature
                            ? (signature.uploadPending ? 'Upload en attente' : 'Archivé sur Drive')
                            : null,
                    } only %}
                {% endfor %}
            {% endif %}

                {# Attestation de remise de clés — affichée seulement pour les détenteurs de clés #}
                {% if cleRow and cleRow.estDetenteur() %}
                    {% set attestation = cleRow.attestation %}
                    {% include 'components/_checklist_item.html.twig' with {
                        etat: cleRow.attestationAJour() ? 'fait' : 'attente',
                        label: 'Attestation de remise de clés — saison ' ~ dirigeant.season.label,
                        detail: attestation and attestation.estSignee()
                            ? (attestation.estArchivee() ? 'Archivée sur Drive' : 'Upload en attente')
                            : cleRow.etatAttestation().label(),
                    } only %}
                {% endif %}
            </ul>

            {% if cleRow and cleRow.estDetenteur() %}
                <p class="licencie-show-card-note">
                    Détient {{ cleRow.detention.solde }} clé{{ cleRow.detention.solde > 1 ? 's' : '' }} du local{% if peut_acceder('admin_cles_index') %} — <a href="{{ path('admin_cles_index') }}">voir le registre</a>{% endif %}
                </p>
            {% endif %}
        </div>

        {# — Historique — #}
        <div class="licencie-show-card licencie-show-card-full">
            <h2 class="licencie-show-card-title">Historique</h2>
            <ul class="licencie-show-history">
                {% for event in history %}
                    <li class="licencie-show-history-item {{ not loop.last ? 'licencie-show-history-item-sep' }}">
                        <span class="licencie-show-history-date">{{ event.date|date('d/m/Y à H:i') }}</span>
                        <span class="licencie-show-history-label">{{ event.label }}</span>
                        <span class="licencie-show-history-who">{{ event.who }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>

        {# — Dotations — #}
        {% if dotations is not empty %}
        <div class="licencie-show-card licencie-show-card-full">
            <h2 class="licencie-show-card-title">Équipements attribués</h2>
            {# Conteneur défilant, sans second cadre : la carte porte déjà le sien. #}
            <div class="table-wrapper table-wrapper-nu table-cartes">
            <table class="table">
                <thead>
                    <tr><th>Article</th><th>Quantité</th><th>Date</th></tr>
                </thead>
                <tbody>
                    {% for d in dotations %}
                        <tr>
                            <td class="carte-titre">
                                <span class="licencie-show-dd">{{ d.item.nom }}</span>
                                {% if d.item.couleur %}<span class="licencie-show-dd-empty" style="font-size:var(--font-size-xs)"> — {{ d.item.couleur }}</span>{% endif %}
                            </td>
                            <td class="licencie-show-dd" data-label="Quantité">{{ d.quantite }}</td>
                            <td class="licencie-show-dd-empty" data-label="Date">{{ d.createdAt|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
        {% endif %}

    </div>

</div>
{% endblock %}
