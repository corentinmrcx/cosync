{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ modele.nom }}{% endblock %}

{# Le sélecteur d'article, identique partout où l'on désigne un article du stock :
   vêtements d'abord (taille déduite automatiquement), puis le reste. #}
{% macro articleSelect(vetements, autres, name, placeholder, model = null) %}
    <select name="{{ name }}" class="field-input" required
            {% if model %}x-model="{{ model }}"{% endif %}>
        <option value="">{{ placeholder }}</option>
        {% if vetements is not empty %}
            <optgroup label="Vêtements (taille automatique)">
                {% for item in vetements %}
                    <option value="{{ item.id }}">{{ item.nom }}{% if item.couleur %} · {{ item.couleur }}{% endif %}</option>
                {% endfor %}
            </optgroup>
        {% endif %}
        {% if autres is not empty %}
            <optgroup label="Autres articles">
                {% for item in autres %}
                    <option value="{{ item.id }}">{{ item.nom }}{% if item.couleur %} · {{ item.couleur }}{% endif %}</option>
                {% endfor %}
            </optgroup>
        {% endif %}
    </select>
{% endmacro %}

{# Un panneau de destinataires : la même liste déroulante à coches que les catégories d'une
   équipe. Masqué, le panneau est aussi désactivé — un <fieldset disabled> ne poste rien,
   donc seules les valeurs du type retenu partent au serveur. #}
{% macro cibles(type, options, verrouillees, vide, recherche) %}
    <fieldset class="dot-pick" x-ref="panneau-{{ type }}" x-show="type === '{{ type }}'"
              :disabled="type !== '{{ type }}'" x-cloak>
        {% if options is empty %}
            <p class="dot-empty">{{ vide }}</p>
        {% else %}
            {% include 'components/multi-select.html.twig' with {
                ms_name: 'cible_ids[]',
                ms_options: options,
                ms_selected: [],
                ms_placeholder: '— Choisir les destinataires —',
                ms_unite: 'destinataires',
                ms_verrouillees: verrouillees,
                ms_verrou_note: 'déjà attribué',
                ms_recherche: recherche,
                ms_tout: true,
            } only %}
        {% endif %}
    </fieldset>
{% endmacro %}

{% block content %}
{% import _self as ui %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Dotations', route: 'admin_dotations_dashboard' },
    { label: 'Modèles', route: 'admin_dotations_modeles' },
    { label: modele.nom }
] } %}

{% set vetements = articles|filter(a => a.typeVetement) %}
{% set autres = articles|filter(a => not a.typeVetement) %}
{% set fixes = modele.lignes|filter(l => l.groupeChoix is null) %}
{% set choixGroupes = {} %}
{% for l in modele.lignes|filter(l => l.groupeChoix is not null) %}
    {% set choixGroupes = choixGroupes|merge({ (l.groupeChoix): (choixGroupes[l.groupeChoix]|default([]))|merge([l]) }) %}
{% endfor %}

<div class="dot-page">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">{{ modele.nom }}</h1>
            <p class="dot-subtitle">
                Un kit se compose d'articles reçus par tout le monde, et de choix laissés au licencié.
                L'aperçu en bas de page montre ce que chaque profil recevra vraiment.
            </p>
        </div>
    </div>

    {# — Réglages du kit — #}
    <div class="dot-card">
        <h2 class="dot-card-title">Le kit</h2>
        <form method="post" action="{{ path('admin_dotations_edit', {id: modele.id}) }}" class="dot-choix-body">
            <input type="hidden" name="_token" value="{{ csrf_token('dotation_modele_edit_' ~ modele.id) }}">
            <div class="dot-inline">
                <input type="text" name="nom" class="field-input" value="{{ modele.nom }}" required aria-label="Nom du kit">
                <label class="dot-check">
                    <input type="checkbox" name="actif" value="1" {{ modele.actif ? 'checked' : '' }}> Actif
                </label>
            </div>
            <div class="dot-choix-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>

    </div>

    {# — Qui reçoit ce kit — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Qui reçoit ce kit</h2>
            <span class="dot-card-count">{{ affectations|length }}</span>
        </div>
        <p class="dot-hint">
            En cas de chevauchement avec un autre kit, le plus précis l'emporte :
            personne &gt; équipe &gt; catégorie ou rôle &gt; défaut.
        </p>

        {% if affectations is empty %}
            <p class="dot-warning">Ce kit n'est attribué à personne : personne ne le recevra tant qu'il n'a pas de cible.</p>
        {% else %}
            <ul class="dot-list">
                {% for a in affectations %}
                    <li class="dot-list-item">
                        <div class="dot-list-main">
                            <span class="dot-list-name">{{ a.cibleLabel }}</span>
                        </div>
                        <form method="post" action="{{ path('admin_dotations_affectation_delete', {id: a.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_affectation_delete_' ~ a.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">Retirer</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {# Un kit se donne rarement à une seule équipe : on coche tout ce qui le reçoit,
           puis on attribue en un envoi. Les cases déjà attribuées sont verrouillées —
           le retrait passe par la liste ci-dessus, seul endroit d'où l'on défait. #}
        <form method="post" action="{{ path('admin_dotations_affectation_new', {id: modele.id}) }}"
              class="dot-attribuer" x-data="dotationCibles('team')" @multi-select="majSelection($event.detail.nombre)">
            <input type="hidden" name="_token" value="{{ csrf_token('dotation_affectation_new_' ~ modele.id) }}">

            <div class="field">
                <label class="field-label" for="cible-type">Type de destinataire</label>
                <select id="cible-type" name="cible_type" class="field-input" x-model="type">
                    <option value="team">Équipes</option>
                    <option value="category">Catégories FFF</option>
                    <option value="role">Rôles dirigeants</option>
                    <option value="licencie">Licenciés</option>
                    <option value="dirigeant">Dirigeants</option>
                    <option value="default">Par défaut (toute la saison)</option>
                </select>
            </div>

            {{ ui.cibles('team', cibles.team, ciblesVerrouillees.team, 'Aucune équipe dans cette saison.', false) }}
            {{ ui.cibles('category', cibles.category, ciblesVerrouillees.category, 'Aucune catégorie au référentiel.', false) }}
            {{ ui.cibles('role', cibles.role, ciblesVerrouillees.role, 'Aucun rôle dirigeant.', false) }}
            {{ ui.cibles('licencie', cibles.licencie, ciblesVerrouillees.licencie, 'Aucun licencié validé dans cette saison.', true) }}
            {{ ui.cibles('dirigeant', cibles.dirigeant, ciblesVerrouillees.dirigeant, 'Aucun dirigeant dans cette saison.', true) }}

            <fieldset class="dot-pick" x-ref="panneau-default" x-show="type === 'default'"
                      :disabled="type !== 'default'" x-cloak>
                {% if defautAttribue %}
                    <p class="dot-hint">Ce kit est déjà le kit par défaut de la saison.</p>
                {% else %}
                    <p class="dot-hint">Ce kit ira à toute personne qu'aucune autre attribution ne vise.</p>
                {% endif %}
            </fieldset>

            <div class="dot-choix-actions">
                <button type="submit" class="btn btn-primary" :disabled="!peutValider">
                    <span x-text="libelleBouton"></span>
                </button>
            </div>
        </form>
    </div>

    {# — Articles reçus par tout le monde — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Reçu par tout le monde</h2>
            <span class="dot-card-count">{{ fixes|length }}</span>
        </div>
        <p class="dot-hint">Ces articles sont attribués sans question. Le licencié ne les voit pas dans son formulaire, sauf si l'un d'eux réclame un texte à personnaliser.</p>

        {% if fixes is empty %}
            <p class="dot-empty">Aucun article commun.</p>
        {% else %}
            <ul class="dot-list">
                {% for ligne in fixes %}
                    <li class="dot-list-item dot-list-item-stack" x-data="{ ouvert: false }">
                        <div class="dot-list-row">
                            <div class="dot-list-main">
                                <span class="dot-list-name">{{ ligne.stockItem.nom }}</span>
                                <span class="dot-list-meta">
                                    ×{{ ligne.quantite }}
                                    {%- if ligne.stockItem.typeVetement %} · {{ ligne.stockItem.typeVetement.label }}{% endif -%}
                                    {%- if ligne.eligibilite != eligibilites[0] %} · {{ ligne.eligibilite.label }}{% endif -%}
                                    {%- if ligne.personnalisationRequise %} · texte à personnaliser{% endif -%}
                                </span>
                            </div>
                            <div class="dot-list-actions">
                                <button type="button" class="btn btn-secondary btn-sm" @click="ouvert = !ouvert"
                                        x-text="ouvert ? 'Fermer' : 'Régler'"></button>
                                <button type="submit" form="fixe-del-{{ ligne.id }}" class="btn btn-danger btn-sm">Retirer</button>
                            </div>
                        </div>

                        <form method="post" action="{{ path('admin_dotations_ligne_reglages', {id: ligne.id}) }}"
                              class="dot-reglages" x-show="ouvert" x-cloak
                              x-data="{ perso: {{ ligne.personnalisationRequise ? 'true' : 'false' }} }">
                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_reglages_' ~ ligne.id) }}">

                            <div class="field">
                                <label class="field-label" for="fx-elig-{{ ligne.id }}">Qui y a droit</label>
                                <select id="fx-elig-{{ ligne.id }}" name="eligibilite" class="field-input">
                                    {% for cas in eligibilites %}
                                        <option value="{{ cas.value }}" {{ ligne.eligibilite == cas ? 'selected' : '' }}>{{ cas.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <label class="dot-toggle">
                                <input type="checkbox" name="personnalisation_requise" value="1" x-model="perso">
                                <span>Demander un texte à personnaliser</span>
                            </label>

                            <div class="dot-perso" x-show="perso" x-cloak>
                                <div class="dot-row">
                                    <div class="field">
                                        <label class="field-label" for="fx-lab-{{ ligne.id }}">Question posée au licencié</label>
                                        <input id="fx-lab-{{ ligne.id }}" type="text" name="personnalisation_label" class="field-input"
                                               value="{{ ligne.personnalisationLabel }}" placeholder="Ex : Nom à floquer au dos">
                                    </div>
                                    <div class="field dot-field-narrow">
                                        <label class="field-label" for="fx-max-{{ ligne.id }}">Caractères max.</label>
                                        <input id="fx-max-{{ ligne.id }}" type="number" name="personnalisation_max" class="field-input"
                                               min="1" max="60" value="{{ ligne.personnalisationMaxLength }}"
                                               placeholder="{{ personnalisationMaxDefaut }}">
                                    </div>
                                </div>
                            </div>

                            <div class="dot-choix-actions">
                                <button type="submit" class="btn btn-primary">Enregistrer cet article</button>
                            </div>
                        </form>

                        {# Hors du formulaire ci-dessus : HTML interdit les formulaires imbriqués. #}
                        <form id="fixe-del-{{ ligne.id }}" method="post" action="{{ path('admin_dotations_ligne_delete', {id: ligne.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_delete_' ~ ligne.id) }}">
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <form method="post" action="{{ path('admin_dotations_ligne_add', {id: modele.id}) }}" class="dot-add-row">
            <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_add_' ~ modele.id) }}">
            {{ ui.articleSelect(vetements, autres, 'stock_item_id', '— Ajouter un article —') }}
            <input type="number" name="quantite" class="field-input dot-text-qty" min="1" value="1" title="Quantité" aria-label="Quantité">
            <button type="submit" class="btn btn-ghost">+ Ajouter</button>
        </form>

        <p class="dot-hint">La taille n'est pas à choisir ici : pour un vêtement, elle est déterminée automatiquement d'après la fiche d'inscription de chaque personne.</p>
    </div>

    {# — Choix laissés au licencié — #}
    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Choix laissés au licencié</h2>
            <span class="dot-card-count">{{ choixGroupes|length }}</span>
        </div>
        <p class="dot-hint">
            Un choix propose plusieurs articles dont le licencié en retient un.
            Réserver une option à une population <strong>supprime la question</strong> pour les autres :
            s'il ne reste qu'une option éligible, l'article est imposé sans rien demander.
        </p>

        {% if choixGroupes is empty %}
            <p class="dot-empty">Aucun choix. Tout le monde reçoit exactement le même kit.</p>
        {% endif %}

        {% for nom, lignes in choixGroupes %}
            <div class="dot-choix" id="choix-{{ nom }}">

                <div class="dot-choix-bar">
                    <span class="dot-choix-tag">Choix</span>
                    <span class="dot-choix-count">{{ lignes|length }} option{{ lignes|length > 1 ? 's' : '' }}{% if lignes[0].quantite > 1 %} · ×{{ lignes[0].quantite }}{% endif %}</span>
                    <button type="submit" form="choix-del-{{ loop.index }}" class="dot-choix-delete">Retirer ce choix</button>
                </div>

                {# Repère interne : sert de clé aux réponses déjà saisies, d'où le renommage encadré. #}
                <form method="post" action="{{ path('admin_dotations_choix_rename', {id: modele.id}) }}" class="dot-choix-title">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_rename_' ~ modele.id) }}">
                    <input type="hidden" name="ancien" value="{{ nom }}">
                    <div class="field">
                        <label class="field-label" for="nom-{{ loop.index }}">Nom du choix (usage interne)</label>
                        <div class="dot-inline">
                            <input id="nom-{{ loop.index }}" type="text" name="nouveau" class="field-input" value="{{ nom }}" required>
                            <button type="submit" class="btn btn-ghost">Renommer</button>
                        </div>
                        <p class="field-hint">Sert à repérer le choix ici et dans le suivi. Il n'apparaît au licencié que si le kit propose plusieurs choix, pour les distinguer. Les réponses déjà saisies suivent le renommage.</p>
                    </div>
                </form>

                <form method="post" action="{{ path('admin_dotations_choix_reglages', {id: modele.id}) }}" class="dot-choix-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_reglages_' ~ modele.id) }}">
                    <input type="hidden" name="nom" value="{{ nom }}">
                    <p class="dot-section-title">Options proposées</p>
                    <ul class="dot-opt-list">
                        {% for ligne in lignes %}
                            {% include 'admin/dotations/_option_reglages.html.twig' with {
                                ligne: ligne,
                                eligibilites: eligibilites,
                                personnalisationMaxDefaut: personnalisationMaxDefaut,
                                supprimable: lignes|length > 2,
                            } only %}
                        {% endfor %}
                    </ul>
                    <div class="dot-choix-actions">
                        <button type="submit" class="btn btn-primary">Enregistrer ce choix</button>
                    </div>
                </form>

                {# Ajouter une 3e option sans détruire les réglages ni les réponses des 2 premières. #}
                <form method="post" action="{{ path('admin_dotations_choix_option_add', {id: modele.id}) }}" class="dot-choix-add">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_option_add_' ~ modele.id) }}">
                    <input type="hidden" name="nom" value="{{ nom }}">
                    <div class="dot-inline">
                        {{ ui.articleSelect(vetements, autres, 'stock_item_id', '— Ajouter une option —') }}
                        <button type="submit" class="btn btn-ghost">+ Ajouter</button>
                    </div>
                </form>

                {# Hors du formulaire de réglages : HTML interdit les formulaires imbriqués.
                   Les boutons plus haut s'y rattachent par leur attribut `form`. #}
                <form id="choix-del-{{ loop.index }}" method="post" action="{{ path('admin_dotations_choix_delete', {id: modele.id}) }}"
                      onsubmit="return confirm('Retirer le choix « {{ nom }} » et ses {{ lignes|length }} options ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_delete_' ~ modele.id) }}">
                    <input type="hidden" name="nom" value="{{ nom }}">
                </form>
                {% for ligne in lignes %}
                    <form id="opt-del-{{ ligne.id }}" method="post" action="{{ path('admin_dotations_ligne_delete', {id: ligne.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_delete_' ~ ligne.id) }}">
                    </form>
                {% endfor %}
            </div>
        {% endfor %}

        {# — Créer un choix : deux selects minimum, comme partout ailleurs dans l'admin — #}
        <form method="post" action="{{ path('admin_dotations_ligne_choix_add', {id: modele.id}) }}"
              class="dot-choix-new" x-data="{ options: ['', ''] }">
            <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_add_' ~ modele.id) }}">
            <p class="dot-section-title">Nouveau choix</p>

            <div class="dot-row">
                <div class="field">
                    <label class="field-label" for="new-choix-nom">Nom du choix (usage interne)</label>
                    <input id="new-choix-nom" type="text" name="nom" class="field-input" placeholder="Ex : Choix du haut" required>
                </div>
                <div class="field dot-field-narrow">
                    <label class="field-label" for="new-choix-qte">Quantité</label>
                    <input id="new-choix-qte" type="number" name="quantite" class="field-input" min="1" value="1">
                </div>
            </div>

            <div class="field">
                <span class="field-label">Articles proposés</span>
                <template x-for="(option, i) in options" :key="i">
                    <div class="dot-inline dot-inline-stack">
                        {{ ui.articleSelect(vetements, autres, 'stock_item_ids[]', '— Choisir un article —', 'options[i]') }}
                        <button type="button" class="btn btn-ghost" x-show="options.length > 2"
                                @click="options.splice(i, 1)">Retirer</button>
                    </div>
                </template>
                <button type="button" class="btn btn-ghost dot-btn-ghost-start" @click="options.push('')">+ Une option de plus</button>
                <p class="field-hint">Le licencié en retiendra une seule. Vous réglerez ensuite qui a droit à quoi.</p>
            </div>

            <div class="dot-choix-actions">
                <button type="submit" class="btn btn-primary">Créer le choix</button>
            </div>
        </form>
    </div>

    {# — Aperçu — #}
    <div class="dot-card">
        <h2 class="dot-card-title">Ce que recevra chaque profil</h2>
        <p class="dot-hint">Calculé à partir des réglages ci-dessus. C'est exactement ce que verra la personne concernée.</p>
        {% include 'admin/dotations/_apercu.html.twig' with { apercu: apercu } only %}
    </div>

</div>
{% endblock %}
