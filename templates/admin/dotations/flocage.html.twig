{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Liste de flocage{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Dotations', route: 'admin_dotations_dashboard' },
    { label: 'Commandes', route: 'admin_commandes_index' },
    { label: 'Flocage' }
] } %}

<div class="dot-page">

    {# L'écran sert à se relire — d'où le porteur et son équipe, que le club seul peut
       vérifier. La feuille qu'on édite, elle, ne les porte pas : elle sort du club. #}
    <div class="dot-header">
        <div>
            <h1 class="dot-title">Liste de flocage</h1>
            <p class="dot-subtitle">Les textes à marquer sur les articles encore à remettre.</p>
        </div>
        <div class="dot-header-actions">
            {% if besoins is not empty and peut_acceder('admin_dotations_flocage_pdf') %}
                <form method="post" action="{{ path('admin_dotations_flocage_pdf') }}" target="_blank">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_flocage_pdf') }}">
                    <button type="submit" class="btn btn-primary">Feuille pour le floqueur (PDF)</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="dot-card">
        {% if besoins is empty %}
            <p class="dot-empty">Aucun article à floquer pour cette saison.</p>
        {% else %}
            <div class="dot-card-header">
                <h2 class="dot-card-title">À floquer</h2>
                <span class="dot-card-count">{{ besoins|length }}</span>
            </div>

            {# Liste qu'on relit ligne par ligne avant d'envoyer au floqueur : sur téléphone
               elle passe en cartes, chaque texte à floquer sous son porteur. #}
            <div class="table-wrapper table-wrapper-nu table-cartes">
            <table class="table">
                <thead>
                    <tr>
                        <th>Personne</th>
                        <th>Équipe</th>
                        <th>Article</th>
                        <th>Taille</th>
                        <th>Texte à floquer</th>
                    </tr>
                </thead>
                <tbody>
                    {% for besoin in besoins %}
                        <tr>
                            <td class="carte-titre"><span class="dot-item-nom">{{ besoin.nomPrenom }}</span></td>
                            <td class="carte-meta">{{ besoin.teamName ?? 'Sans équipe' }}</td>
                            {# L'article servi : c'est celui-là qui part chez le floqueur. #}
                            <td data-label="Article">{{ besoin.articleServi.nom }}</td>
                            <td data-label="Taille">
                                {% if besoin.taille %}
                                    <span class="dot-item-taille">{{ besoin.taille }}</span>
                                {% else %}
                                    <span class="dot-item-taille-missing">à renseigner</span>
                                {% endif %}
                            </td>
                            <td data-label="Flocage"><span class="dot-flocage-print">{{ besoin.personnalisation }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
