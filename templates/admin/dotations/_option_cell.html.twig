{# Article d'un besoin, et correction de l'option retenue quand il vient d'un groupe de choix.

   La saisie s'ouvre à la place du nom, depuis le menu « ⋯ » de la ligne (`correction`, porté
   par la ligne) — un select toujours ouvert alourdirait chaque ligne du tableau.

   Le nom affiché est celui de l'article **servi** : sa marque et sa couleur s'écrivent juste
   en dessous, et doivent parler du même carton.

   `besoin` = App\Entity\DotationBesoin, `options` = StockItem[] proposés à cette personne,
   `corrections` = App\DTO\DotationLigneCorrections. #}
<span class="dot-item-nom" x-show="correction !== 'option'">{{ besoin.articleServi.nom }}</span>

{# droits-verifies-cote-serveur: DotationLigneCorrectionsResolver filtre déjà sur DotationLigneCorrection::permission() #}
{% if corrections.propose('option') %}
    <form x-show="correction === 'option'" x-cloak method="post"
          action="{{ path('admin_dotations_besoin_option', {id: besoin.id}) }}"
          class="dot-option-form">
        <input type="hidden" name="_token" value="{{ csrf_token('dotation_besoin_option_' ~ besoin.id) }}">
        <select name="stock_item_id" class="field-input field-input-compact"
                x-init="$watch('correction', v => v === 'option' && $nextTick(() => $el.focus()))">
            {% for option in options %}
                <option value="{{ option.id }}"{{ option.id == besoin.stockItem.id ? ' selected' }}>
                    {{ option.nom }}{% if option.couleur %} · {{ option.couleur }}{% endif %}
                </option>
            {% endfor %}
        </select>
        <button type="submit" class="dot-option-ok" title="Valider">✓</button>
        <button type="button" class="btn btn-ghost btn-sm" @click="correction = null" title="Annuler">✕</button>
    </form>
{% endif %}
