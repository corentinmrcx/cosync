{% extends 'admin/layout.html.twig' %}
{% import 'components/_stock_item_label.html.twig' as article %}

{% block title %}CoSync — Suivi des dotations{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Dotations', route: 'admin_dotations_dashboard' },
    { label: 'Modèles', route: 'admin_dotations_modeles' },
    { label: 'Suivi' }
] } %}

{# Chaque geste recharge la page : `suiviDotations` note les groupes ouverts et le défilement à
   l'envoi, et les rend au rechargement — sans quoi on remontait tout en haut après chaque sac. #}
<div class="dot-page"
     x-data="suiviDotations({{ articlesRemisables|json_encode|e('html_attr') }})"
     @submit.capture="memoriser()">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">Suivi des dotations</h1>
            <p class="dot-subtitle">Ce que chaque personne doit recevoir et ce qui a déjà été remis.</p>
        </div>
        {# La liste de flocage est partie sur l'écran des commandes : elle s'envoie au floqueur
           au moment où l'on commande, cet écran-ci ne sert qu'à remettre. #}
        <div class="dot-header-actions">
            {% if peut_acceder('admin_dotations_recalculer') %}
                <form method="post" action="{{ path('admin_dotations_recalculer') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('dotation_recalculer') }}">
                    <button type="submit" class="btn btn-secondary">↻ Recalculer les besoins</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if groupes is empty %}
        <div class="dot-card">
            <p class="dot-empty">
                Aucun besoin. Configurez des modèles + affectations, validez des licenciés (paiement confirmé)
                ou complétez des dossiers dirigeants, puis cliquez sur « Recalculer les besoins ».
            </p>
        </div>
    {% endif %}

    {% for groupe in groupes %}
        <div class="dot-card" x-data="{ open: estOuvert({{ groupe.nom|json_encode|e('html_attr') }}) }">
            <button type="button" class="dot-card-header dot-card-toggle" @click="open = !open"
                    data-groupe="{{ groupe.nom }}"
                    :aria-expanded="open" aria-label="Déplier / replier l'équipe">
                <svg class="dot-card-chevron" :class="{ 'dot-card-chevron-open': open }"
                     width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
                <h2 class="dot-card-title">{{ groupe.nom }}</h2>
                {% if groupe.restants > 0 %}
                    <span class="dot-card-count dot-card-count-todo">{{ groupe.restants }} à remettre</span>
                {% else %}
                    <span class="dot-card-count dot-card-count-done">Tout remis</span>
                {% endif %}
                {% if groupe.prepares > 0 %}
                    <span class="dot-card-count dot-card-count-prepare">{{ groupe.prepares }} prêt{{ groupe.prepares > 1 ? 's' }}</span>
                {% endif %}
                <span class="dot-card-count">{{ groupe.total }}</span>
            </button>

            {# Écran tenu à la main devant les cartons : sur téléphone chaque besoin devient
               une carte, avec le bouton de son étape — « Préparer », puis « Marquer remis ». #}
            <div class="table-wrapper table-cartes" x-show="open" x-collapse x-cloak>
                <table class="table resp-table">
                    <thead>
                        <tr>
                            <th>Personne</th>
                            <th>Article</th>
                            <th>Taille</th>
                            <th>Qté</th>
                            <th>Statut</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for besoin in groupe.besoins %}
                            {% set corrections = correctionsParBesoin[besoin.id] %}
                            {% set actions = actionsParBesoin[besoin.id] %}
                            {# `correction` : la saisie ouverte depuis le menu « ⋯ », dans la cellule de
                               la valeur qu'elle corrige. Une à la fois par ligne. #}
                            <tr x-data="{ correction: null }">
                                <td class="carte-titre">
                                    <span class="dot-person-name">{{ besoin.nomPrenom }}</span>
                                </td>
                                <td data-label="Article">
                                    {# Plusieurs articles s'appellent « Chaussettes » : sans la marque, on
                                       ne sait pas quel carton ouvrir. C'est celle de l'article servi. #}
                                    {% set details = article.details(besoin.articleServi)|trim %}
                                    <div class="dot-article-cell">
                                        {% include 'admin/dotations/_option_cell.html.twig' with {
                                            besoin: besoin,
                                            options: optionsParBesoin[besoin.id] ?? [],
                                            corrections: corrections,
                                        } only %}
                                        {# Remis hors kit, ou servi par un ancien stock : dans les deux
                                           cas ce n'est pas le carton du kit qu'on a ouvert, il ressort. #}
                                        {% if besoin.estRemisHorsKit %}
                                            <span class="dot-horskit-badge" title="Remis à la place de l'article du kit — cas isolé : aucune règle n'en découle, personne d'autre ne le recevra automatiquement">
                                                {{- details ?: article.label(besoin.articleServi) -}}
                                            </span>
                                            <span class="dot-article-mention">
                                                au lieu de {{ article.label(besoin.stockItem) }}
                                            </span>
                                        {% elseif besoin.estServiParEcoulement %}
                                            <span class="dot-ecoulement-badge" title="Servi depuis un stock en cours d'écoulement — l'article du kit n'est pas racheté">
                                                {{- details ?: article.label(besoin.articleServi) -}}
                                            </span>
                                        {% elseif details %}
                                            <span class="dot-item-details">{{ details }}</span>
                                        {% endif %}
                                        {% include 'admin/dotations/_remise_autre_cell.html.twig' with {
                                            besoin: besoin,
                                            actions: actions,
                                        } only %}
                                        {% include 'admin/dotations/_ecoulement_cell.html.twig' with {
                                            besoin: besoin,
                                            articles: articlesParBesoin[besoin.id] ?? [],
                                            corrections: corrections,
                                        } only %}
                                        {% include 'admin/dotations/_flocage_cell.html.twig' with {
                                            besoin: besoin,
                                            reglages: flocagesParBesoin[besoin.id] ?? null,
                                            corrections: corrections,
                                        } only %}
                                    </div>
                                </td>
                                <td data-label="Taille">
                                    {% set taille = taillesParBesoin[besoin.id] ?? null %}
                                    {% set estDonne = besoin.statut.estRemis %}
                                    <div class="dot-taille-edit">
                                        <div x-show="correction !== 'taille'" class="dot-taille-display">
                                            <div class="dot-taille-valeurs">
                                            {% if besoin.taille %}
                                                {# L'étiquette du carton (« 37-40 »), pas le libellé du stock : un « 37 »
                                                   seul se lisait comme la pointure du joueur. #}
                                                <span class="dot-taille-carton">
                                                    <span class="dot-item-taille">{{ taille.etiquette ?? besoin.taille }}</span>
                                                    {% if besoin.tailleManuelle %}
                                                        <span class="dot-taille-lock" title="Taille fixée à la main : le dossier ne la met plus à jour">📌</span>
                                                    {% endif %}
                                                </span>
                                            {% elseif estDonne %}
                                                <span class="dot-taille-none">—</span>
                                            {% elseif besoin.articleServi.typeVetement %}
                                                <span class="dot-item-taille-missing">à renseigner</span>
                                            {% elseif besoin.articleServi.kind and besoin.articleServi.kind.value == 'equipement' %}
                                                {% if peut_acceder('admin_stock_items_edit') %}
                                                    <a href="{{ path('admin_stock_items_edit', {id: besoin.articleServi.id}) }}"
                                                       class="dot-taille-config"
                                                       title="Définir le type de vêtement de l'article pour récupérer automatiquement la taille du licencié">type à définir ↗</a>
                                                {% else %}
                                                    <span class="dot-item-taille-missing">type à définir</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="dot-taille-none">—</span>
                                            {% endif %}
                                            {% if taille and taille.declaree %}
                                                <span class="dot-taille-declaree">{{ taille.declaree }}</span>
                                            {% endif %}
                                            </div>
                                        </div>
                                        {# droits-verifies-cote-serveur: DotationLigneCorrectionsResolver filtre déjà sur DotationLigneCorrection::permission() #}
                                        {% if corrections.propose('taille') %}
                                        <form x-show="correction === 'taille'" x-cloak method="post"
                                              action="{{ path('admin_dotations_besoin_taille', {id: besoin.id}) }}"
                                              class="dot-taille-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_besoin_taille_' ~ besoin.id) }}">
                                            <select name="taille" class="field-input field-input-compact"
                                                    x-init="$watch('correction', v => v === 'taille' && $nextTick(() => $el.focus()))">
                                                {# Choisir une taille la verrouille ; « Automatique » est la sortie
                                                   du verrou. « — Aucune — » ne le disait pas. #}
                                                <option value="">{{ taille and taille.relachable ? 'Automatique (taille du dossier)' : '— Aucune —' }}</option>
                                                {% for option in taille.options ?? [] %}
                                                    <option value="{{ option.valeur }}"{{ option.valeur is same as(taille.selection) ? ' selected' }}>{{ option.libelle }}</option>
                                                {% endfor %}
                                            </select>
                                            <button type="submit" class="dot-taille-ok" title="Valider">✓</button>
                                            <button type="button" class="btn btn-ghost btn-sm" @click="correction = null" title="Annuler">✕</button>
                                        </form>
                                        {% endif %}
                                    </div>
                                </td>
                                <td data-label="Qté">{{ besoin.quantite }}</td>
                                <td data-label="Statut">
                                    <div class="dot-statut-cell">
                                        {# Revenir en arrière se fait depuis le menu « ⋯ » de la ligne. #}
                                        {% if besoin.statut.estRemis %}
                                            <span class="dot-badge dot-badge-done">{{ besoin.statut.label }}</span>
                                        {% elseif besoin.statut.estPrepare %}
                                            <span class="dot-badge dot-badge-prepare">{{ besoin.statut.label }}</span>
                                        {% else %}
                                            <span class="dot-badge dot-badge-todo">{{ besoin.statut.label }}</span>
                                        {% endif %}

                                        {# Le sac est fait : d'où vient l'article ne regarde plus personne. #}
                                        {% if not besoin.statut.contenuFige %}
                                            {% include 'admin/dotations/_provenance_cell.html.twig' with {
                                                besoin: besoin,
                                                provenance: provenanceParBesoin[besoin.id] ?? null,
                                                taille: taillesParBesoin[besoin.id].etiquette ?? null,
                                            } only %}
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="dot-table-action table-actions">
                                    {# `table-actions-cellule` cale le bouton à droite de la
                                       colonne — sur téléphone, où la ligne devient une carte,
                                       la même classe le renvoie à gauche sous le reste. #}
                                    <div class="table-actions-cellule">
                                        {% if actions.principale %}
                                            {% include 'admin/dotations/_action.html.twig' with {
                                                besoin: besoin,
                                                action: actions.principale.value,
                                                contexte: 'principale',
                                            } only %}
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="dot-table-menu">
                                    {% include 'admin/dotations/_menu_ligne.html.twig' with {
                                        besoin: besoin,
                                        corrections: corrections,
                                        actions: actions,
                                    } only %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}

</div>
{% endblock %}
