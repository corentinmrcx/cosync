{# Une option d'un choix, à l'intérieur du formulaire unique du groupe.
   `ligne` = App\Entity\DotationModeleLigne #}
<li class="dot-opt" x-data="{ perso: {{ ligne.personnalisationRequise ? 'true' : 'false' }} }">
    {# Une case décochée n'est pas postée : ce marqueur dit au serveur que l'option était bien
       dans le formulaire, et qu'un « texte à personnaliser » absent veut dire « décoché ». #}
    <input type="hidden" name="reglages[{{ ligne.id }}][_present]" value="1">

    <div class="dot-opt-head">
        <span class="dot-opt-name">{{ ligne.stockItem.nom }}</span>
        {% if ligne.stockItem.typeVetement %}
            <span class="dot-opt-meta">{{ ligne.stockItem.typeVetement.label }}</span>
        {% endif %}
        {% if supprimable %}
            <button type="submit" form="opt-del-{{ ligne.id }}" class="dot-opt-remove">Retirer</button>
        {% endif %}
    </div>

    <div class="field">
        <label class="field-label" for="elig-{{ ligne.id }}">Qui y a droit</label>
        <select id="elig-{{ ligne.id }}" name="reglages[{{ ligne.id }}][eligibilite]" class="field-input">
            {% for cas in eligibilites %}
                <option value="{{ cas.value }}" {{ ligne.eligibilite == cas ? 'selected' : '' }}>{{ cas.label }}</option>
            {% endfor %}
        </select>
    </div>

    <label class="dot-toggle">
        <input type="checkbox" name="reglages[{{ ligne.id }}][personnalisation_requise]" value="1" x-model="perso">
        <span>Demander un texte à personnaliser</span>
    </label>

    <div class="dot-perso" x-show="perso" x-cloak>
        <div class="dot-row">
            <div class="field">
                <label class="field-label" for="lab-{{ ligne.id }}">Question posée au licencié</label>
                <input id="lab-{{ ligne.id }}" type="text" name="reglages[{{ ligne.id }}][personnalisation_label]"
                       class="field-input" value="{{ ligne.personnalisationLabel }}"
                       placeholder="Ex : Nom à floquer au dos">
            </div>
            <div class="field dot-field-narrow">
                <label class="field-label" for="max-{{ ligne.id }}">Caractères max.</label>
                <input id="max-{{ ligne.id }}" type="number" name="reglages[{{ ligne.id }}][personnalisation_max]"
                       class="field-input" min="1" max="60" value="{{ ligne.personnalisationMaxLength }}"
                       placeholder="{{ personnalisationMaxDefaut }}">
            </div>
        </div>
        <p class="field-hint">Le licencié saisira ce texte et devra en confirmer l'orthographe avant l'envoi.</p>
    </div>
</li>
