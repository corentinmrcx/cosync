{# ──────────────────────────────────────────────────────────────────────────
   Éditeur du texte d'un règlement intérieur — sert les deux destinataires
   (licenciés / dirigeants), le contrôleur fournit la cible et les libellés.
   Paramètres attendus : season, audience, currentHtml, formAction, csrfId, apercuUrl
─────────────────────────────────────────────────────────────────────────── #}
{% extends 'admin/layout.html.twig' %}

{% set isDirigeant = audience.value == 'dirigeant' %}
{% set documentTitle = audience.documentTitle() %}

{% block title %}CoSync — {{ documentTitle }}{% endblock %}

{% block head %}
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Configuration', route: 'admin_config_index' },
    { label: isDirigeant ? 'Règlement dirigeants' : 'Règlement' }
] } %}

<div class="reglement-edit-page">
    <div class="reglement-edit-layout">

        <form method="post" action="{{ formAction }}" class="reglement-edit-card" id="reglement-form">

            <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
            <input type="hidden" name="reglement_text" id="reglement_text_input">

            <div class="reglement-edit-header">
                <h1 class="reglement-edit-title">{{ documentTitle }}</h1>
                <p class="reglement-edit-hint">
                    {% if isDirigeant %}
                        Ce texte sera affiché au dirigeant lors de l'étape de signature de son formulaire, et intégré dans le PDF archivé. Il est distinct du règlement signé par les licenciés.
                    {% else %}
                        Ce texte sera affiché au licencié lors de l'étape de signature, et intégré dans le PDF archivé.
                    {% endif %}
                </p>
            </div>

            <hr class="reglement-edit-divider">

            <div class="reglement-edit-field">
                <label class="reglement-edit-label">Texte du règlement</label>
                <div class="reglement-edit-editor-wrapper">
                    <div id="quill-editor" class="reglement-edit-editor">{{ currentHtml|raw }}</div>
                </div>
            </div>

            <div class="reglement-edit-actions">
                <a href="{{ path('admin_config_index') }}" class="reglement-edit-cancel">Annuler</a>
                <button type="submit" class="reglement-edit-submit">Enregistrer</button>
            </div>

        </form>

        <aside class="reglement-preview-panel">
            <div class="reglement-preview-header">
                <span class="reglement-preview-title">Aperçu — rendu {{ isDirigeant ? 'dirigeant' : 'licencié' }}</span>
                <span class="reglement-preview-hint">Mis à jour en direct</span>
            </div>
            <div class="reglement-preview-content" id="reglement-preview">
                {{ currentHtml|raw }}
            </div>
            <div class="reglement-preview-footer">
                <a href="{{ apercuUrl }}" target="_blank" class="reglement-edit-apercu-btn">Aperçu PDF</a>
                <span class="reglement-edit-apercu-hint">L'aperçu PDF est basé sur le texte enregistré.</span>
            </div>
        </aside>

    </div>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    const quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: {{ (isDirigeant ? 'Saisissez ici le règlement intérieur des dirigeants…' : 'Saisissez ici le règlement intérieur…')|json_encode|raw }},
        modules: {
            toolbar: [
                [{ header: [1, 2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['clean']
            ]
        }
    });

    document.getElementById('reglement-form').addEventListener('submit', function () {
        document.getElementById('reglement_text_input').value = quill.root.innerHTML;
    });

    const preview = document.getElementById('reglement-preview');
    preview.innerHTML = quill.root.innerHTML;
    quill.on('text-change', () => { preview.innerHTML = quill.root.innerHTML; });
</script>
{% endblock %}
