{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Saisons{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Configuration', route: 'admin_config_index' },
    { label: 'Saisons' }
] } %}

<div class="seasons-page">

    <div class="seasons-header">
        <h1 class="seasons-title">Saisons</h1>
        <a href="{{ path('admin_seasons_new') }}" class="seasons-new-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nouvelle saison
        </a>
    </div>

    {% if seasons is empty %}
        <div class="seasons-empty">
            <p>Aucune saison. Créez-en une pour commencer.</p>
        </div>
    {% else %}
        <div class="seasons-table-wrap">
            <table class="seasons-table">
                <thead>
                    <tr>
                        <th>Saison</th>
                        <th class="seasons-col-costs">Cotisation jeunes</th>
                        <th class="seasons-col-costs">Cotisation seniors</th>
                        <th class="seasons-col-status">Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for season in seasons %}
                        <tr class="seasons-row">
                            <td class="seasons-td-label">{{ season.label }}</td>
                            <td class="seasons-col-costs">{{ season.baseCosts.jeunes ?? '—' }} €</td>
                            <td class="seasons-col-costs">{{ season.baseCosts.seniors ?? '—' }} €</td>
                            <td class="seasons-col-status">
                                {% if season.active %}
                                    <span class="seasons-badge-active">Active</span>
                                {% else %}
                                    <span class="seasons-badge-inactive">Inactive</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="seasons-actions-cell">
                                    <a href="{{ path('admin_seasons_edit', {id: season.id}) }}" class="seasons-action-link">
                                        Modifier
                                    </a>
                                    {% if not season.active %}
                                        <form method="post" action="{{ path('admin_seasons_activate', {id: season.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('activate_season_' ~ season.id) }}">
                                            <button type="submit" class="seasons-action-btn">Activer</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

</div>
{% endblock %}
