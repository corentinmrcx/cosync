{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Gérer les saisons{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Saisons', route: 'admin_seasons_index' },
    { label: 'Gérer' }
] } %}

<div class="season-form-page">
    <div class="season-list-wrap">

        <div class="season-list-header">
            <h1 class="season-list-title">Gérer les saisons</h1>
        </div>
        <p class="season-list-intro">
            Modifier une saison, c'est changer son année de début et sa cotisation par défaut.
            Pour en créer une ou entrer dans l'une d'elles, revenez à l'écran
            <a href="{{ path('admin_seasons_index') }}">Saisons</a>. Une saison qui contient des
            licenciés ou des dirigeants ne peut pas être supprimée.
        </p>

        {% if seasons is empty %}
            <p class="season-list-empty">Aucune saison créée.</p>
        {% else %}
            <ul class="season-list">
                {% for season in seasons %}
                    {% set isActive = current and current.id == season.id %}
                    {% set stat = stats[season.id] %}
                    {% set canDelete = not isActive and stat.licencies == 0 and stat.dirigeants == 0 %}

                    <li class="season-list-item {{ isActive ? 'season-list-item-active' : '' }}">
                        <div class="season-list-item-info">
                            <span class="season-list-item-label">{{ season.label }}</span>
                            {% if isActive %}
                                <span class="season-list-badge-active">En cours</span>
                            {% endif %}
                            {# Les compteurs disent aussi pourquoi le bouton Supprimer manque. #}
                            <span class="season-list-item-stats">
                                {{ stat.licencies }} licencié{{ stat.licencies > 1 ? 's' : '' }}
                                · {{ stat.dirigeants }} dirigeant{{ stat.dirigeants > 1 ? 's' : '' }}
                            </span>
                        </div>

                        <div class="season-list-item-actions">
                            <a href="{{ path('admin_seasons_edit', {id: season.id}) }}" class="season-list-btn-activate">Modifier</a>

                            {% if canDelete %}
                                {% include 'components/_form_suppression.html.twig' with {
                                    action: path('admin_seasons_delete', {id: season.id}),
                                    jeton: 'season_delete_' ~ season.id,
                                    message: 'Supprimer la saison {{ season.label }} ? Cette action est irréversible.',
                                } only %}
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

    </div>
</div>
{% endblock %}
