{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Tableau de bord{% endblock %}

{% block content %}
<div class="dashboard">

    {% if not navbar_current_season %}
        <div class="dashboard-alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>Aucune saison configurée. Certaines fonctionnalités sont désactivées.</span>
            <a href="{{ path('admin_seasons_new') }}" class="dashboard-alert-link">Créer une saison →</a>
        </div>
    {% endif %}

    <div class="dashboard-hub">

        {% include 'components/hub-card.html.twig' with {
            icon: 'calendar',
            label: 'Saisons',
            route: 'admin_seasons_index'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'box',
            label: 'Stock',
            route: 'admin_stock_dashboard'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'key',
            label: 'Clés',
            route: 'admin_cles_index'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'gear',
            label: 'Le club',
            route: 'admin_club_index'
        } only %}

    </div>

    {% if navbar_current_season %}
        <div class="quicklink-grid dashboard-season">
            <a href="{{ path('admin_saison_dashboard') }}" class="quicklink quicklink-wide dashboard-season-item">
                <span class="quicklink-title">Reprendre la saison {{ navbar_current_season.label }}</span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
        </div>
    {% endif %}

    <a href="{{ path('admin_documentation') }}" class="dashboard-doc-fab" title="Documentation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span class="dashboard-doc-fab-label">Documentation</span>
    </a>

</div>
{% endblock %}
