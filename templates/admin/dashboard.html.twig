{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Tableau de bord{% endblock %}

{% block content %}
<div class="dashboard">

    {% if not hasSeason %}
    <div class="dashboard-alert">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Aucune saison configurée. Certaines fonctionnalités sont désactivées.</span>
        <a href="{{ path('admin_seasons_new') }}" class="dashboard-alert-link">Créer une saison →</a>
    </div>
    {% endif %}

    <div class="dashboard-hub">

        {% include 'components/hub-card.html.twig' with {
            icon: 'users',
            label: 'Licenciés',
            route: hasSeason ? 'admin_licencies_list' : null,
            disabled: not hasSeason
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'shield',
            label: 'Dirigeants',
            route: hasSeason ? 'admin_dirigeants_list' : null,
            disabled: not hasSeason
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'import',
            label: 'Import',
            route: hasSeason ? 'admin_import_index' : null,
            disabled: not hasSeason
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'box',
            label: 'Stocks',
            route: hasSeason ? 'admin_stock_dashboard' : null,
            disabled: not hasSeason
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'wallet',
            label: 'Finance',
            sub: 'Bientôt disponible',
            disabled: true
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'gear',
            label: 'Configuration',
            route: 'admin_config_index'
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'book',
            label: 'Documentation',
            route: 'admin_documentation'
        } %}

    </div>

</div>
{% endblock %}
