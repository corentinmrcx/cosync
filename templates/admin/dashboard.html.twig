{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Tableau de bord{% endblock %}

{% block content %}
<div class="dashboard">

    <div class="dashboard-hub">

        {% include 'components/hub-card.html.twig' with {
            icon: 'users',
            label: 'Licenciés',
            sub: 'Gérer les inscrits',
            route: 'admin_licencies_list'
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'import',
            label: 'Import',
            sub: 'Importer un fichier XLSX',
            route: 'admin_import_index'
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'box',
            label: 'Stocks',
            sub: 'Bientôt disponible',
            disabled: true
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'wallet',
            label: 'Finance',
            sub: 'Bientôt disponible',
            disabled: true
        } %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'gear',
            label: 'Configuration',
            sub: 'Saisons, utilisateurs…',
            route: 'admin_config_index'
        } %}

    </div>

</div>
{% endblock %}
