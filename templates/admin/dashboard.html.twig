{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Tableau de bord{% endblock %}

{% block content %}
<div class="dashboard">

    {% if not navbar_current_season %}
        <div class="dashboard-alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>Aucune saison configurée. Certaines fonctionnalités sont désactivées.</span>
            {% if peut_acceder('admin_seasons_new') %}
                <a href="{{ path('admin_seasons_new') }}" class="dashboard-alert-link">Créer une saison →</a>
            {% endif %}
        </div>
    {% endif %}

    {# — La porte d'entrée quotidienne, avant tout le reste —
       Reprendre la saison en cours et « Changer de saison » mènent au même écran : la
       première par sa route directe, la seconde après un détour par la liste. Sans
       hiérarchie entre les deux, la carte du hub captait le clic. D'où la bannière en
       tête, seule de son espèce, et la carte reléguée en fin de grille sous un libellé
       qui dit qu'elle sert à changer, pas à entrer. #}
    {% if navbar_current_season %}
        <a href="{{ path('admin_saison_dashboard') }}" class="dashboard-saison-hero">
            <span class="dashboard-saison-hero-title">Reprendre la saison {{ navbar_current_season.label }}</span>
            <span class="dashboard-saison-hero-arrow">{{ ui.icon('arrow-right', 20) }}</span>
        </a>
    {% endif %}

    <div class="dashboard-hub">

        {% include 'components/hub-card.html.twig' with {
            icon: 'box',
            label: 'Stock',
            route: 'admin_stock_dashboard',
            permission: 'stock.lire'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'key',
            label: 'Clés',
            route: 'admin_cles_index',
            permission: 'cle.lire'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'cart',
            label: 'Boutique',
            route: 'admin_boutique_index',
            permission: 'boutique.lire'
        } only %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'tool',
            label: 'Outils',
            route: 'admin_outils_index',
            permission: 'planning.lire'
        } only %}

        {# Le hub du club rassemble plusieurs sujets — identité, RIB, relances, référentiels,
           comptes — et une carte ne prend qu'une permission. C'est donc le domaine qui
           répond : la carte s'affiche dès qu'un de ses écrans est ouvert. #}
        {% if possede_un_droit('club') %}
            {% include 'components/hub-card.html.twig' with {
                icon: 'gear',
                label: 'Le club',
                route: 'admin_club_index'
            } only %}
        {% endif %}

        {% include 'components/hub-card.html.twig' with {
            icon: 'calendar',
            label: 'Changer de saison',
            route: 'admin_seasons_index'
        } only %}

    </div>

    <a href="{{ path('admin_documentation') }}" class="dashboard-doc-fab" title="Documentation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        <span class="dashboard-doc-fab-label">Documentation</span>
    </a>

</div>
{% endblock %}
