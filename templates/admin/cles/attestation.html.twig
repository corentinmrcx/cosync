{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Attestation de remise{% endblock %}

{% block head %}
{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Clés', route: 'admin_cles_index' },
    { label: 'Attestation de remise' }
] } %}

<div class="cles-editor-page">
    <div class="cles-editor-layout">

        <form method="post" action="{{ path('admin_cles_attestation_edit') }}" class="cles-editor-card" id="attestation-form">

            <input type="hidden" name="_token" value="{{ csrf_token('attestation_cle_text_' ~ season.id) }}">
            <input type="hidden" name="attestation_cle_text" id="attestation_cle_text_input">

            <div class="cles-editor-header">
                <h1 class="cles-editor-title">Attestation de remise de clés</h1>
                <p class="cles-editor-hint">
                    Le nom du signataire, le nombre de clés et la date de remise sont repris
                    automatiquement du registre. Ce champ ne sert qu'à ajouter un engagement
                    complémentaire (ne pas prêter la clé, la restituer en fin de saison…).
                    Il est propre à la saison {{ season.label }}.
                </p>
            </div>

            <hr class="cles-editor-divider">

            <div class="cles-editor-field">
                <label class="cles-editor-label">Engagement complémentaire (facultatif)</label>
                <div class="editeur-riche-wrapper">
                    <div id="quill-editor" class="editeur-riche-zone">{{ season.attestationCleText|raw }}</div>
                </div>
            </div>

            <div class="cles-editor-actions">
                <a href="{{ path('admin_cles_index') }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>

        </form>

        <aside class="cles-preview-panel">
            <div class="cles-preview-header">
                <span class="cles-preview-title">Aperçu — rendu signataire</span>
                <span class="cles-preview-hint">Mis à jour en direct</span>
            </div>
            <div class="cles-preview-content editeur-riche-apercu" id="attestation-preview">
                {{ season.attestationCleText|raw }}
            </div>
            <div class="cles-preview-footer">
                <a href="{{ path('admin_cles_attestation_apercu') }}" target="_blank" class="btn btn-secondary">Aperçu PDF</a>
                <a href="{{ path('admin_cles_attestation_recap') }}" class="btn btn-secondary">Récapitulatif mairie</a>

                <form method="post" action="{{ path('admin_cles_attestation_recap_sync') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('attestation_cle_recap_sync') }}">
                    <button type="submit" class="cles-btn-link">Régénérer le récapitulatif sur Drive</button>
                </form>

                <span class="cles-editor-hint">Les aperçus sont basés sur le texte enregistré.</span>
            </div>
        </aside>

    </div>
</div>
{% endblock %}

{% block scripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => initEditeurRiche({
            editeur: '#quill-editor',
            formulaire: 'attestation-form',
            champCache: 'attestation_cle_text_input',
            apercu: 'attestation-preview',
            placeholder: {{ "Ex. : je m'engage à ne pas prêter cette clé et à la restituer sur demande…"|json_encode|raw }},
        }));
    </script>
{% endblock %}
