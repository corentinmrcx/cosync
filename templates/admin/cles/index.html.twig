{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Clés{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Clés' }
] } %}

<div class="section-home-page" x-data="{ modaleExterieur: false }">

    <div class="section-home-header">
        <div>
            <h1 class="section-home-title">Clés du local</h1>
        </div>

        {# Tenue du registre : des gestes rares, rangés dans un « ⋯ » aligné sur le titre. #}
        <div class="section-home-actions">
            {% embed 'components/_menu_actions.html.twig' with { label: 'Actions sur le registre des clés' } %}
                {% block items %}
                    {# Un `embed` est un template à lui seul : les macros importées par la page
                       ne descendent pas dans ses blocs, celui-ci refait son import. #}
                    {% import 'components/_icon.html.twig' as ui %}
                    {% if peut_acceder('admin_cles_detenteur_exterieur') %}
                        <button type="button" class="fiche-menu-item" @click="modaleExterieur = true; ouvert = false">
                            {{ ui.icon('user-plus', 15) }}
                            Ajouter une personne extérieure
                        </button>
                    {% endif %}
                    {% if peut_acceder('admin_cles_attestation_edit') %}
                        <a href="{{ path('admin_cles_attestation_edit') }}" class="fiche-menu-item">
                            {{ ui.icon('edit', 15) }}
                            Texte de l'attestation
                        </a>
                    {% endif %}
                    <a href="{{ path('admin_cles_attestation_recap') }}" class="fiche-menu-item">
                        {{ ui.icon('download', 15) }}
                        Récapitulatif PDF
                    </a>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# — Ce qui appelle une action, et rien d'autre : les encarts n'existent que s'ils
         ont quelque chose à dire. Club à jour, écran muet. — #}
    {% if nbEnAttente > 0 or stats.nbHorsEffectif > 0 %}
        <div class="effectif-alertes">
            {% if nbEnAttente > 0 %}
                <div class="effectif-alerte">
                    <p class="effectif-alerte-texte">
                        <strong>{{ nbEnAttente }}</strong> détenteur{{ nbEnAttente > 1 ? 's' }}
                        n'{{ nbEnAttente > 1 ? 'ont' : 'a' }} pas d'engagement à jour pour la saison {{ season.label }}.
                    </p>
                    {% if peut_acceder('admin_cles_campagne') %}
                        <form method="post" action="{{ path('admin_cles_campagne') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cle_campagne_' ~ season.id) }}">
                            <button type="submit" class="btn btn-primary btn-sm">
                                {{ ui.icon('send', 14) }}
                                Demander les signatures
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}

            {% if stats.nbHorsEffectif > 0 %}
                <div class="effectif-alerte">
                    <p class="effectif-alerte-texte">
                        <strong>{{ stats.nbHorsEffectif }}</strong> détenteur{{ stats.nbHorsEffectif > 1 ? 's' }}
                        {{ stats.nbHorsEffectif > 1 ? 'détiennent' : 'détient' }} des clés sans figurer à l'effectif {{ season.label }}.
                    </p>
                    <a href="{{ path('admin_cles_detenteurs', {statut: 'hors_effectif'}) }}" class="btn btn-secondary btn-sm">
                        Voir {{ stats.nbHorsEffectif > 1 ? 'ces détenteurs' : 'ce détenteur' }}
                    </a>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# — Accès rapides — #}
    <div class="section-home-section">
        <div class="section-home-section-header">
            <h2 class="section-home-section-title">Accès rapides</h2>
        </div>
        <div class="quicklink-grid">
            <a href="{{ path('admin_cles_detenteurs') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('key', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Détenteurs</span>
                    <span class="quicklink-text">
                        {% if stats.nbDetenteurs > 0 %}
                            {{ stats.nbDetenteurs }} personne{{ stats.nbDetenteurs > 1 ? 's' }} —
                            {{ stats.clesEnCirculation }} clé{{ stats.clesEnCirculation > 1 ? 's' }} en circulation,
                            et l'état de chaque attestation
                        {% else %}
                            Personne ne détient de clé pour l'instant
                        {% endif %}
                    </span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>

            <a href="{{ path('admin_cles_mouvements') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('history', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Mouvements</span>
                    <span class="quicklink-text">
                        {% if nbMouvements > 0 %}
                            {{ nbMouvements }} remise{{ nbMouvements > 1 ? 's' }}, restitution{{ nbMouvements > 1 ? 's' }}
                            et perte{{ nbMouvements > 1 ? 's' }} — l'historique complet du club
                        {% else %}
                            Aucun mouvement enregistré
                        {% endif %}
                    </span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
        </div>
    </div>

    {# — Modale d'ajout d'une personne extérieure à l'effectif — #}
    {% if peut_acceder('admin_cles_detenteur_exterieur') %}
    <div class="modal-voile" x-show="modaleExterieur" x-cloak @click.self="modaleExterieur = false">
        <form method="post" action="{{ path('admin_cles_detenteur_exterieur') }}" class="modal">
            <div class="modal-header">
                <h2 class="modal-titre">Ajouter une personne extérieure</h2>
                <button type="button" class="modal-fermer" @click="modaleExterieur = false">✕</button>
            </div>

            <div class="modal-corps">
                <p class="cles-modal-hint">
                    Pour quelqu'un qui ne figure pas à l'effectif : mairie, entreprise d'entretien,
                    association qui utilise le local. Un dirigeant, lui, s'ajoute directement depuis
                    le formulaire de remise.
                </p>

                <input type="hidden" name="_token" value="{{ csrf_token('cle_detenteur_exterieur') }}">

                <div class="field">
                    <label class="field-label" for="cle-ext-nom">Nom</label>
                    <input type="text" name="nom" id="cle-ext-nom" class="field-input" required>
                </div>

                <div class="field">
                    <label class="field-label" for="cle-ext-prenom">Prénom</label>
                    <input type="text" name="prenom" id="cle-ext-prenom" class="field-input" required>
                </div>

                <div class="field">
                    <label class="field-label" for="cle-ext-qualite">Qualité (facultatif)</label>
                    <input type="text" name="qualite" id="cle-ext-qualite" class="field-input"
                           placeholder="Ex. : Mairie de Soudron">
                </div>

                <div class="field">
                    <label class="field-label" for="cle-ext-email">Email (facultatif)</label>
                    <input type="email" name="email" id="cle-ext-email" class="field-input"
                           placeholder="Sans adresse, l'attestation se signe sur place">
                </div>

                <div class="field">
                    <label class="field-label" for="cle-ext-telephone">Téléphone (facultatif)</label>
                    <input type="tel" name="telephone" id="cle-ext-telephone" class="field-input">
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" @click="modaleExterieur = false">Annuler</button>
                <button type="submit" class="btn btn-primary">Ajouter</button>
            </div>
        </form>
    </div>
    {% endif %}

</div>
{% endblock %}
