{% extends 'admin/layout.html.twig' %}

{#
  Relance groupée des licences non soldées.

  C'est la liste que le cron enverrait cette nuit, sous les yeux d'un admin. Elle reste
  affichable robot éteint — c'est même le seul moyen de relancer tant qu'on ne l'a pas
  allumé, et de voir ce qu'il ferait avant de le laisser faire.

  Deux étapes cohabitent et ne se confondent pas : « dossier » redonne un lien à qui n'a
  rien rempli, « paiement » rappelle un montant à qui a rempli. Le mail diffère.
#}

{% block title %}CoSync — Relancer les licences en attente{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Joueurs', route: 'admin_licencies_list' },
    { label: 'Relancer' }
] } %}

<div class="envoi-liens-page">
    <div class="envoi-liens-card">

        <h1 class="envoi-liens-title">Relancer les licences en attente</h1>
        <p class="envoi-liens-intro">
            Les licences non soldées dont le dernier mail remonte à plus de
            <strong>{{ settings.relanceDelaiJours }} jours</strong>, dans la limite de
            <strong>{{ settings.relanceMax }} relance{{ settings.relanceMax > 1 ? 's' }}</strong>
            par personne. Le délai part du dernier mail reçu, quel qu'il soit : relancer ici
            repousse d'autant la relance automatique, personne ne reçoit deux messages le
            même jour. Les personnes sans adresse email ne sont pas listées — elles se
            rattrapent au téléphone.
        </p>

        <p class="envoi-liens-intro">
            {% if settings.relanceActive %}
                La relance automatique est <strong>active</strong> : cette liste part d'elle-même chaque matin à 9 h.
            {% else %}
                La relance automatique est <strong>désactivée</strong> : rien ne part sans un envoi depuis cet écran.
            {% endif %}
            <a href="{{ path('admin_club_relances') }}">Modifier les réglages</a>
        </p>

        <hr class="envoi-liens-divider">

        {% if dues is empty %}
            <p class="envoi-liens-empty">Personne à relancer aujourd'hui.</p>
            <div class="envoi-liens-actions">
                <a href="{{ path('admin_licencies_list') }}" class="btn btn-secondary">Retour</a>
            </div>
        {% else %}
            <form method="post" action="{{ path('admin_licencies_relancer') }}"
                  class="envoi-liens-form"
                  x-data='{ retenus: {{ uuids|json_encode|raw }}, tous: {{ uuids|json_encode|raw }} }'>
                <input type="hidden" name="_token" value="{{ csrf_token('relancer_licencies') }}">

                <p class="envoi-liens-resume">
                    <strong>{{ dues|length }}</strong> licence{{ dues|length > 1 ? 's' }} en attente, du contact le plus ancien au plus récent.
                </p>

                <div class="envoi-liens-selection">
                    <button type="button" class="btn btn-secondary btn-sm" @click="retenus = [...tous]">Tout cocher</button>
                    <button type="button" class="btn btn-secondary btn-sm" @click="retenus = []">Tout décocher</button>
                </div>

                <ul class="envoi-liens-list">
                    {% for due in dues %}
                        <li class="envoi-liens-item">
                            <input type="checkbox"
                                   name="personnes[]"
                                   value="{{ due.uuid }}"
                                   class="envoi-liens-case"
                                   x-model="retenus"
                                   checked>
                            <span class="envoi-liens-nom">{{ due.nomPrenom }}</span>
                            <span class="envoi-liens-equipe">{{ due.equipe }}</span>
                            <span class="relance-etape relance-etape-{{ due.etape.value }}">{{ due.etape.label() }}</span>
                            <span class="envoi-liens-email">Dernier contact {{ due.dernierContact.anciennete }}</span>
                            <span class="envoi-liens-detail">Relance n°{{ due.numero }} sur {{ settings.relanceMax }}</span>
                        </li>
                    {% endfor %}
                </ul>

                <hr class="envoi-liens-divider">

                <div class="envoi-liens-actions">
                    <a href="{{ path('admin_licencies_list') }}" class="btn btn-ghost">Annuler</a>
                    <button type="submit" class="btn btn-primary"
                            :disabled="retenus.length === 0"
                            x-text="'Relancer ' + retenus.length + ' licencié' + (retenus.length > 1 ? 's' : '')">
                        Relancer {{ dues|length }} licencié{{ dues|length > 1 ? 's' }}
                    </button>
                </div>
            </form>
        {% endif %}

    </div>
</div>
{% endblock %}
