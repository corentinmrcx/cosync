{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Diagnostic{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Diagnostic' }
] } %}

<div class="diag-page">

    {# ── Bandeau statut beta ── #}
    {% if betaActive %}
    <div class="diag-banner diag-banner-active">
        <span class="diag-banner-dot"></span>
        <div>
            <strong>Mode beta actif</strong> — Les mails sont redirigés vers la boite de l'utilisateur connecté.
            Les licenciés et dirigeants ne reçoivent rien.
        </div>
    </div>
    {% else %}
    <div class="diag-banner diag-banner-inactive">
        <span class="diag-banner-dot"></span>
        <div>
            <strong>Mode beta inactif</strong> — Les mails partent vers les vrais destinataires.
        </div>
    </div>
    {% endif %}

    {# ── Mode beta ── #}
    <div class="diag-card">
        <h2 class="diag-card-title">Mode beta</h2>
        <p class="diag-card-desc">
            En mode beta, les mails destinés aux licenciés et dirigeants sont redirigés vers la boite de <strong>l'utilisateur connecté</strong> au moment de l'action.
            Le sujet est préfixé avec le vrai destinataire pour identifier chaque mail.
            Active ce mode avant de partager le site pour les tests.
        </p>
        <hr class="diag-divider">
        <div class="diag-beta-actions">
            {% if not betaActive %}
            <form method="post" action="{{ path('admin_diag_beta_enable') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('beta_enable') }}">
                <button type="submit" class="btn btn-primary btn-lg diag-btn-success">Activer le mode beta</button>
            </form>
            {% else %}
            <form method="post" action="{{ path('admin_diag_beta_disable') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('beta_disable') }}">
                <button type="submit" class="btn btn-primary btn-lg diag-btn-outline">Désactiver le mode beta</button>
            </form>
            {% endif %}
        </div>
    </div>

    {# ── Purge des données (beta uniquement) ── #}
    {% if betaActive %}
    <div class="diag-card diag-card-danger"
         x-data="confirmationPurge()">
        <h2 class="diag-card-title diag-card-title-danger">Purge des données de test</h2>
        <p class="diag-card-desc">
            Supprime <strong>toutes</strong> les données métier : saisons, équipes, licenciés, dirigeants, dossiers,
            transactions, stock, dotations, commandes, fournisseurs et catégories de stock.
            Seuls sont conservés les <strong>comptes admin</strong> et les <strong>référentiels FFF</strong>
            (catégories U6→SENIOR, rôles dirigeants).
            Cette action est <strong>irréversible</strong>.
        </p>
        <hr class="diag-divider">
        <form method="post" action="{{ path('admin_diag_purge') }}" class="diag-purge-form">
            <input type="hidden" name="_token" value="{{ csrf_token('purge') }}">
            <label class="diag-purge-label">
                Tape <strong>SUPPRIMER</strong> pour déverrouiller le bouton
            </label>
            <input
                type="text"
                name="confirmation"
                x-model="mot"
                @input="verifier()"
                autocomplete="off"
                placeholder="SUPPRIMER"
                class="field-input diag-purge-input"
            >
            <div class="diag-purge-footer">
                <button
                    type="submit"
                    class="btn btn-primary btn-lg diag-btn-danger"
                    :disabled="!pret"
                    x-bind:class="pret ? '' : 'diag-btn-disabled'"
                >
                    Supprimer toutes les données
                </button>
                <span class="diag-countdown" x-show="mot === 'SUPPRIMER' && !pret && compteARebours > 0">
                    Disponible dans <strong x-text="compteARebours"></strong>s…
                </span>
            </div>
        </form>
    </div>
    {% endif %}

    {# ── Test d'envoi mail ── #}
    <div class="diag-card">
        <h2 class="diag-card-title">Test d'envoi mail</h2>
        <p class="diag-card-desc">Envoie un mail de test pour vérifier que la configuration SMTP est opérationnelle. Aucun licencié ne sera contacté.</p>
        <hr class="diag-divider">
        <form method="post" action="{{ path('admin_diag_test_mail') }}" class="diag-form">
            <input type="hidden" name="_token" value="{{ csrf_token('test_mail') }}">
            <input type="email" name="test_email" placeholder="votre@email.fr" required class="field-input">
            <button type="submit" class="btn btn-primary btn-lg">Envoyer</button>
        </form>
    </div>

    {# ── Test mail de validation ── #}
    <div class="diag-card">
        <h2 class="diag-card-title">Test mail de validation de licence</h2>
        <p class="diag-card-desc">Envoie un aperçu du mail de validation envoyé aux licenciés une fois leur dossier complet et leur paiement confirmé.</p>
        <hr class="diag-divider">
        <form method="post" action="{{ path('admin_diag_test_validation_mail') }}" class="diag-form">
            <input type="hidden" name="_token" value="{{ csrf_token('test_validation_mail') }}">
            <input type="email" name="test_email" placeholder="votre@email.fr" required class="field-input">
            <div class="diag-radio-group">
                <label class="diag-radio-label">
                    <input type="radio" name="profil" value="jeune" checked> Jeune (U6–U19)
                </label>
                <label class="diag-radio-label">
                    <input type="radio" name="profil" value="senior"> Senior
                </label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Envoyer</button>
        </form>
    </div>

</div>
{% endblock %}
