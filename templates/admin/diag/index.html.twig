{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Diagnostic{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Diagnostic' }
] } %}

<div class="diag-page">

    <div class="diag-card">
        <h2 class="diag-card-title">Test d'envoi mail</h2>
        <p class="diag-card-desc">Envoie un mail de test pour vérifier que la configuration SMTP est opérationnelle. Aucun licencié ne sera contacté.</p>
        <hr class="diag-divider">
        <form method="post" action="{{ path('admin_diag_test_mail') }}" class="diag-form">
            <input type="hidden" name="_token" value="{{ csrf_token('test_mail') }}">
            <input type="email" name="test_email" placeholder="votre@email.fr" required class="diag-input">
            <button type="submit" class="diag-btn">Envoyer</button>
        </form>
    </div>

    <div class="diag-card">
        <h2 class="diag-card-title">Test mail de validation de licence</h2>
        <p class="diag-card-desc">Envoie un aperçu du mail de validation envoyé aux licenciés une fois leur dossier complet et leur paiement confirmé.</p>
        <hr class="diag-divider">
        <form method="post" action="{{ path('admin_diag_test_validation_mail') }}" class="diag-form">
            <input type="hidden" name="_token" value="{{ csrf_token('test_validation_mail') }}">
            <input type="email" name="test_email" placeholder="votre@email.fr" required class="diag-input">
            <div class="diag-radio-group">
                <label class="diag-radio-label">
                    <input type="radio" name="profil" value="jeune" checked> Jeune (U6–U19)
                </label>
                <label class="diag-radio-label">
                    <input type="radio" name="profil" value="senior"> Senior
                </label>
            </div>
            <button type="submit" class="diag-btn">Envoyer</button>
        </form>
    </div>

</div>
{% endblock %}
