{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Cotisations{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Cotisations' }
] } %}

<div class="season-form-page">

    <div class="season-form-card">
        <h1 class="season-form-header">Cotisations</h1>
        <p class="config-teams-intro">
            Le montant dû par un licencié est celui de son équipe. À défaut d'équipe, ou si
            l'équipe n'a pas de montant propre, c'est la cotisation par défaut qui s'applique.
        </p>
        <hr class="season-form-divider">

        <form method="post" action="{{ path('admin_cotisations_defaut') }}" class="cotisations-defaut">
            <input type="hidden" name="_token" value="{{ csrf_token('cotisation_defaut') }}">
            <div class="field">
                <label class="field-label" for="cotisation_defaut">Cotisation par défaut (€)</label>
                <input type="number" min="0" step="1" id="cotisation_defaut" name="cotisation_defaut"
                       value="{{ season.cotisationDefaut }}" class="field-input" required>
            </div>
            <div class="season-form-actions cotisations-defaut-actions">
                <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
            </div>
        </form>
    </div>

    <div class="season-form-card">
        <h2 class="season-form-subheader">Cotisation par équipe</h2>
        <hr class="season-form-divider">

        {% if teams is empty %}
            <p class="season-form-empty">Aucune équipe configurée.</p>
        {% else %}
            <form method="post" action="{{ path('admin_cotisations_equipes') }}" class="cotisations-equipes">
                <input type="hidden" name="_token" value="{{ csrf_token('cotisations_equipes') }}">

                <ul class="config-teams-list">
                    {% for team in teams %}
                        <li class="config-teams-item">
                            <div class="config-teams-row">
                                <label class="config-teams-name cotisations-team-name"
                                       for="cotisation_team_{{ team.id }}">{{ team.name }}</label>
                                <div class="cotisations-team-champ">
                                    <input type="number" min="0" step="1"
                                           id="cotisation_team_{{ team.id }}"
                                           name="cotisations[{{ team.id }}]"
                                           value="{{ team.cotisation }}"
                                           placeholder="{{ season.cotisationDefaut }}"
                                           class="field-input cotisations-team-input">
                                    <span class="cotisations-team-unite" aria-hidden="true">€</span>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <p class="config-teams-hint">
                    Champ vide = cotisation par défaut ({{ season.cotisationDefaut }} €).
                </p>

                <div class="season-form-actions cotisations-defaut-actions">
                    <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
                </div>
            </form>
        {% endif %}
    </div>

</div>
{% endblock %}
