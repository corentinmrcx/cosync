{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Suivi des dotations{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Dotations', route: 'admin_stock_dotations_index' },
    { label: 'Suivi' }
] } %}

<div class="dot-page">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">Suivi des dotations</h1>
            <p class="dot-subtitle">Ce que chaque personne doit recevoir et ce qui a déjà été remis.</p>
        </div>
        <div class="dot-header-actions">
            <form method="post" action="{{ path('admin_stock_dotations_recalculer') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('dotation_recalculer') }}">
                <button type="submit" class="dot-btn-secondary">↻ Recalculer les besoins</button>
            </form>
        </div>
    </div>

    {% if groupes is empty %}
        <div class="dot-card">
            <p class="dot-empty">
                Aucun besoin. Configurez des modèles + affectations, validez des licenciés (paiement confirmé)
                ou complétez des dossiers dirigeants, puis cliquez sur « Recalculer les besoins ».
            </p>
        </div>
    {% endif %}

    {% for equipe, besoins in groupes %}
        <div class="dot-card">
            <div class="dot-card-header">
                <h2 class="dot-card-title">{{ equipe }}</h2>
                <span class="dot-card-count">{{ besoins|length }}</span>
            </div>

            <div class="dot-table-wrapper">
                <table class="dot-table">
                    <thead>
                        <tr>
                            <th>Personne</th>
                            <th>Article</th>
                            <th>Taille</th>
                            <th>Qté</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for besoin in besoins %}
                            <tr>
                                <td>
                                    <span class="dot-person-name">{{ besoin.nomPrenom }}</span>
                                    <span class="dot-person-role">{{ besoin.roleLabel }}</span>
                                </td>
                                <td><span class="dot-item-nom">{{ besoin.stockItem.nom }}</span></td>
                                <td>
                                    {% if besoin.statut.value == 'donne' %}
                                        {% if besoin.taille %}<span class="dot-item-taille">{{ besoin.taille }}</span>{% else %}—{% endif %}
                                    {% else %}
                                        <div x-data="{ editing: false }" class="dot-taille-edit">
                                            <div x-show="!editing" class="dot-taille-display{% if not besoin.taille and besoin.stockItem.typeVetement %} is-missing{% endif %}">
                                                {% if besoin.taille %}
                                                    <span class="dot-item-taille">{{ besoin.taille }}</span>
                                                {% elseif besoin.stockItem.typeVetement %}
                                                    <span class="dot-item-taille-missing">manquante</span>
                                                {% else %}
                                                    <span class="dot-item-taille-none">—</span>
                                                {% endif %}
                                                <button type="button" class="dot-taille-pen" @click="editing = true" title="Modifier la taille">✎</button>
                                            </div>
                                            <form x-show="editing" x-cloak method="post"
                                                  action="{{ path('admin_stock_dotations_besoin_taille', {id: besoin.id}) }}"
                                                  class="dot-taille-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('dotation_besoin_taille_' ~ besoin.id) }}">
                                                <input type="text" name="taille" value="{{ besoin.taille }}"
                                                       list="dot-tailles-list" class="dot-taille-input"
                                                       placeholder="taille" x-init="$watch('editing', v => v && $nextTick(() => $el.focus()))">
                                                <button type="submit" class="dot-taille-ok" title="Valider">✓</button>
                                                <button type="button" class="dot-taille-cancel" @click="editing = false" title="Annuler">✕</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ besoin.quantite }}</td>
                                <td>
                                    {% if besoin.statut.value == 'donne' %}
                                        <span class="dot-badge dot-badge-done">{{ besoin.statut.label }}</span>
                                    {% else %}
                                        <span class="dot-badge dot-badge-todo">{{ besoin.statut.label }}</span>
                                    {% endif %}
                                </td>
                                <td class="dot-table-action">
                                    {% if besoin.statut.value == 'donne' %}
                                        <form method="post" action="{{ path('admin_stock_dotations_besoin_annuler', {id: besoin.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_besoin_annuler_' ~ besoin.id) }}">
                                            <button type="submit" class="dot-action-delete">Annuler</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_stock_dotations_besoin_remise', {id: besoin.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_besoin_remise_' ~ besoin.id) }}">
                                            <button type="submit" class="dot-btn-sm">Marquer remis</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endfor %}

    <datalist id="dot-tailles-list">
        {% for t in taillesConnues %}<option value="{{ t }}">{% endfor %}
    </datalist>

</div>
{% endblock %}
