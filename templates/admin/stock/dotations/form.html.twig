{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ modele.nom }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Dotations', route: 'admin_stock_dotations_index' },
    { label: modele.nom }
] } %}

<div class="dot-page">

    <div class="dot-header">
        <h1 class="dot-title">{{ modele.nom }}</h1>
    </div>

    {# — Réglages du modèle — #}
    <div class="dot-card">
        <h2 class="dot-card-title">Réglages</h2>
        <form method="post" action="{{ path('admin_stock_dotations_edit', {id: modele.id}) }}" class="dot-inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('dotation_modele_edit_' ~ modele.id) }}">
            <input type="text" name="nom" class="dot-input" value="{{ modele.nom }}" required>
            <label class="dot-check">
                <input type="checkbox" name="actif" value="1" {{ modele.actif ? 'checked' : '' }}> Actif
            </label>
            <button type="submit" class="dot-btn-primary">Enregistrer</button>
        </form>
    </div>

    {# — Articles du modèle — #}
    {% set vetements = articles|filter(a => a.typeVetement) %}
    {% set autres = articles|filter(a => not a.typeVetement) %}
    {% set fixes = modele.lignes|filter(l => l.groupeChoix is null) %}
    {% set choixGroupes = {} %}
    {% for l in modele.lignes|filter(l => l.groupeChoix is not null) %}
        {% set choixGroupes = choixGroupes|merge({ (l.groupeChoix): (choixGroupes[l.groupeChoix]|default([]))|merge([l]) }) %}
    {% endfor %}

    <div class="dot-card">
        <div class="dot-card-header">
            <h2 class="dot-card-title">Articles à recevoir</h2>
            <span class="dot-card-count">{{ modele.lignes|length }}</span>
        </div>

        {% if modele.lignes is empty %}
            <p class="dot-empty">Aucun article. Ajoutez ce que cette dotation doit contenir.</p>
        {% else %}
            <ul class="dot-list">
                {% for ligne in fixes %}
                    <li class="dot-list-item">
                        <div class="dot-list-main">
                            <span class="dot-list-name">{{ ligne.stockItem.nom }}</span>
                            <span class="dot-list-meta">
                                ×{{ ligne.quantite }}
                                {% if ligne.stockItem.typeVetement %} · {{ ligne.stockItem.typeVetement.label }}{% endif %}
                            </span>
                        </div>
                        <form method="post" action="{{ path('admin_stock_dotations_ligne_delete', {id: ligne.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_delete_' ~ ligne.id) }}">
                            <button type="submit" class="dot-action-delete">Retirer</button>
                        </form>
                    </li>
                {% endfor %}

                {% for nom, lignes in choixGroupes %}
                    <li class="dot-list-item dot-list-item-choix">
                        <div class="dot-choix-head">
                            <div class="dot-list-main">
                                <span class="dot-list-name">
                                    <span class="dot-choix-tag">Choix</span> {{ nom }}
                                </span>
                                <span class="dot-list-meta">
                                    {{ lignes|length }} option(s){% if lignes[0].quantite > 1 %} · ×{{ lignes[0].quantite }}{% endif %}
                                </span>
                            </div>
                            <form method="post" action="{{ path('admin_stock_dotations_choix_delete', {id: modele.id}) }}" style="display:inline"
                                  onsubmit="return confirm('Retirer ce choix et ses {{ lignes|length }} options ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_delete_' ~ modele.id) }}">
                                <input type="hidden" name="nom" value="{{ nom }}">
                                <button type="submit" class="dot-action-delete">Retirer</button>
                            </form>
                        </div>

                        <ul class="dot-option-list">
                            {% for ligne in lignes %}
                                {% include 'admin/stock/dotations/_option_reglages.html.twig' with {
                                    ligne: ligne,
                                    eligibilites: eligibilites,
                                    personnalisationMaxDefaut: personnalisationMaxDefaut,
                                } only %}
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {# — Ajout : article fixe OU choix — #}
        <div class="dot-add" x-data="{ mode: 'fixe' }">
            <div class="dot-add-tabs">
                <button type="button" class="dot-add-tab" :class="{ 'is-active': mode === 'fixe' }" @click="mode = 'fixe'">Article fixe</button>
                <button type="button" class="dot-add-tab" :class="{ 'is-active': mode === 'choix' }" @click="mode = 'choix'">Choix (le licencié choisit)</button>
            </div>

            {# Mode 1 : un article que tout le monde reçoit #}
            <form x-show="mode === 'fixe'" method="post" action="{{ path('admin_stock_dotations_ligne_add', {id: modele.id}) }}" class="dot-affect-form">
                <input type="hidden" name="_token" value="{{ csrf_token('dotation_ligne_add_' ~ modele.id) }}">
                <select name="stock_item_id" class="dot-input" required>
                    <option value="">— Article —</option>
                    {% if vetements is not empty %}
                        <optgroup label="Vêtements (taille automatique)">
                            {% for item in vetements %}
                                <option value="{{ item.id }}">{{ item.nom }} — {{ item.typeVetement.label }}{% if item.couleur %} · {{ item.couleur }}{% endif %}</option>
                            {% endfor %}
                        </optgroup>
                    {% endif %}
                    {% if autres is not empty %}
                        <optgroup label="Autres articles">
                            {% for item in autres %}
                                <option value="{{ item.id }}">{{ item.nom }}{% if item.couleur %} · {{ item.couleur }}{% endif %}</option>
                            {% endfor %}
                        </optgroup>
                    {% endif %}
                </select>
                <input type="number" name="quantite" class="dot-input dot-input-qty" min="1" value="1" title="Quantité">
                <button type="submit" class="dot-btn-primary">+ Ajouter</button>
            </form>

            {# Mode 2 : plusieurs articles, le licencié en choisit un dans son formulaire #}
            <form x-show="mode === 'choix'" x-cloak method="post" action="{{ path('admin_stock_dotations_ligne_choix_add', {id: modele.id}) }}" class="dot-choix-form">
                <input type="hidden" name="_token" value="{{ csrf_token('dotation_choix_add_' ~ modele.id) }}">
                <div class="dot-choix-row">
                    <input type="text" name="nom" class="dot-input" placeholder="Nom du choix (ex : Veste)" required>
                    <input type="number" name="quantite" class="dot-input dot-input-qty" min="1" value="1" title="Quantité">
                </div>
                <p class="dot-hint">
                    Cochez les articles proposés (au moins 2). Le licencié en choisira un seul lors de son inscription.
                    Par défaut tout le monde voit l'option ; restreignez-la si elle est réservée aux nouveaux licenciés
                    ou aux renouvellements. Le texte à personnaliser se règle ensuite, option par option.
                </p>
                <div class="dot-choix-options">
                    {% for item in vetements|merge(autres) %}
                        <div class="dot-choix-option-row">
                            <label class="dot-choix-option">
                                <input type="checkbox" name="stock_item_ids[]" value="{{ item.id }}">
                                <span>{{ item.nom }}{% if item.typeVetement %} — {{ item.typeVetement.label }}{% endif %}{% if item.couleur %} · {{ item.couleur }}{% endif %}</span>
                            </label>
                            <select name="eligibilite[{{ item.id }}]" class="dot-input dot-option-eligibilite">
                                {% for cas in eligibilites %}
                                    <option value="{{ cas.value }}">{{ cas.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endfor %}
                </div>
                <button type="submit" class="dot-btn-primary">+ Ajouter le choix</button>
            </form>
        </div>

        <p class="dot-hint">La taille n'est pas à choisir ici : pour un vêtement, elle est déterminée automatiquement pour chaque joueur d'après sa fiche d'inscription.</p>
    </div>

</div>
{% endblock %}
