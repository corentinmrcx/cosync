{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Catégories de stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Catégories' }
] } %}

<div class="dot-page" x-data="{ editingId: null, adding: false }">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">Catégories de stock</h1>
            <p class="dot-subtitle">Les articles du catalogue sont regroupés par catégorie, dans l'ordre défini ici.</p>
        </div>
        <div class="dot-header-actions">
            <button type="button" class="btn btn-primary" @click="adding = !adding">
                <span x-text="adding ? 'Annuler' : '+ Nouvelle catégorie'"></span>
            </button>
        </div>
    </div>

    <div class="dot-card" x-data="listeTriable">

        <div class="dot-card-header">
            <h2 class="dot-card-title">Liste</h2>
            <span class="dot-card-count">{{ categories|length }}</span>
        </div>

        {% if categories is empty %}
            <p class="dot-empty">Aucune catégorie.</p>
        {% else %}
            {% if categories|length > 1 %}
                <p class="triable-aide">{{ ui.icon('grip', 14) }} Glissez une catégorie par sa poignée pour changer l'ordre d'affichage.</p>
            {% endif %}

            {% if peut_acceder('admin_stock_categories_reorder') %}
            <form method="post"
                  action="{{ path('admin_stock_categories_reorder') }}"
                  x-ref="formulaire"
                  data-ordre-initial="{{ categories|map(c => c.id)|join(',') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('stock_categories_reorder') }}">
                <span x-ref="ordre"></span>
            </form>
            {% endif %}

            <ul class="dot-list triable-liste"
                x-ref="liste"
                @pointermove.window="deplacer($event)"
                @pointerup.window="terminer()"
                @pointercancel.window="terminer()">
                {% for category in categories %}
                    <li class="dot-list-item triable-ligne" data-triable="{{ category.id }}">
                        <span class="triable-poignee"
                              title="Déplacer"
                              @pointerdown="saisir($event)"
                              aria-hidden="true">{{ ui.icon('grip', 16) }}</span>

                        <div x-show="editingId !== {{ category.id }}" class="dot-list-main">
                            <span class="dot-list-name">{{ category.name }}</span>
                        </div>
                        {% if peut_acceder('admin_stock_categories_edit') %}
                        <div x-show="editingId !== {{ category.id }}" class="dot-list-actions">
                            <button type="button" class="btn btn-secondary btn-sm" @click="editingId = {{ category.id }}">Modifier</button>
                            {% include 'components/_form_suppression.html.twig' with {
                                action: path('admin_stock_categories_delete', {id: category.id}),
                                jeton: 'delete_category_' ~ category.id,
                                message: 'Supprimer cette catégorie ?',
                            } only %}
                        </div>

                        <form x-show="editingId === {{ category.id }}" x-cloak method="post" action="{{ path('admin_stock_categories_edit', {id: category.id}) }}" class="dot-affect-form">
                            <input type="hidden" name="stock_category[_token]" value="{{ csrf_token('stock_category') }}">
                            <input type="text" name="stock_category[name]" class="field-input" value="{{ category.name }}" required>
                            <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
                            <button type="button" class="btn btn-ghost btn-sm" @click="editingId = null">Annuler</button>
                        </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        {{ form_start(newCategoryForm, {attr: {class: 'dot-affect-form', 'x-show': 'adding', 'x-cloak': true}}) }}
            {{ form_widget(newCategoryForm.name, {attr: {class: 'field-input', placeholder: 'Nom de la catégorie'}}) }}
            <button type="submit" class="btn btn-primary">Ajouter</button>
        {{ form_end(newCategoryForm) }}
    </div>

</div>
{% endblock %}
