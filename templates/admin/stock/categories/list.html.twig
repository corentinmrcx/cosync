{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Catégories de stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Catégories' }
] } %}

<div class="stock-categories-page" x-data="{ editingId: null }">

    <div class="stock-categories-header">
        <h1 class="stock-categories-title">Catégories de stock</h1>
    </div>

    <div class="stock-categories-layout">

        {# Nouvelle catégorie #}
        <div class="stock-categories-card">
            <h2 class="stock-categories-card-title">Nouvelle catégorie</h2>
            {{ form_start(newCategoryForm, {attr: {class: 'stock-categories-form'}}) }}
                <div class="stock-categories-form-row">
                    <div class="stock-categories-field" style="flex:3">
                        {{ form_label(newCategoryForm.name) }}
                        {{ form_widget(newCategoryForm.name, {attr: {class: 'stock-categories-input'}}) }}
                        {{ form_errors(newCategoryForm.name) }}
                    </div>
                    <div class="stock-categories-field">
                        {{ form_label(newCategoryForm.position) }}
                        {{ form_widget(newCategoryForm.position, {attr: {class: 'stock-categories-input stock-categories-input-position'}}) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Créer</button>
            {{ form_end(newCategoryForm) }}
        </div>

        {# Liste des catégories existantes #}
        <div class="stock-categories-card">
            <h2 class="stock-categories-card-title">Catégories existantes</h2>

            {% if categories is empty %}
                <p class="stock-categories-empty">Aucune catégorie configurée.</p>
            {% else %}
                <ul class="stock-categories-list">
                    {% for category in categories %}
                        <li class="stock-categories-item">

                            <div class="stock-categories-item-view" x-show="editingId !== {{ category.id }}">
                                <span class="stock-categories-item-name">{{ category.name }}</span>
                                <span class="stock-categories-item-position">#{{ category.position }}</span>
                                <div class="stock-categories-item-actions">
                                    <button type="button" class="btn btn-secondary btn-sm" @click="editingId = {{ category.id }}">Modifier</button>
                                    {% include 'components/_form_suppression.html.twig' with {
                                        action: path('admin_stock_categories_delete', {id: category.id}),
                                        jeton: 'delete_category_' ~ category.id,
                                        message: 'Supprimer cette catégorie ?',
                                    } only %}
                                </div>
                            </div>

                            <form
                                method="post"
                                action="{{ path('admin_stock_categories_edit', {id: category.id}) }}"
                                class="stock-categories-edit-form"
                                x-show="editingId === {{ category.id }}"
                                style="display:none"
                            >
                                <input type="hidden" name="stock_category[_token]" value="{{ csrf_token('stock_category') }}">
                                <input type="text" name="stock_category[name]" value="{{ category.name }}" class="stock-categories-input" required>
                                <input type="number" name="stock_category[position]" value="{{ category.position }}" class="stock-categories-input stock-categories-input-position">
                                <button type="submit" class="btn btn-primary btn-sm">Sauvegarder</button>
                                <button type="button" class="btn btn-ghost btn-sm" @click="editingId = null">Annuler</button>
                            </form>

                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}
