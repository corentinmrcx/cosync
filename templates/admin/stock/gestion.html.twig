{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Gestion du stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Gestion' }
] } %}

<div class="stock-dashboard-page" x-data="stockMouvementModal({
        urlMouvement: '{{ path('admin_stock_items_movement', {id: '__ID__'}) }}',
        urlArticle: '{{ path('admin_stock_items_edit', {id: '__ID__'}) }}',
        ordreTailles: {{ tailles_ordre()|json_encode }},
     })">

    <div class="stock-dashboard-header">
        <h1 class="stock-dashboard-title">Gestion du stock</h1>
        <div class="stock-dashboard-actions">
            <a href="{{ showArchived ? path('admin_stock_gestion') : path('admin_stock_gestion', {archivés: 1}) }}" class="btn btn-secondary{% if showArchived %} stock-btn-archived-active{% endif %}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                {{ showArchived ? 'Masquer les archivés' : 'Voir les archivés' }}
            </a>
            <a href="{{ path('admin_stock_items_new') }}" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nouvel article
            </a>
        </div>
    </div>

    {% if summary is empty %}
        <div class="stock-dashboard-empty">
            <p>Aucun article.</p>
        </div>
    {% endif %}

    {# Le tableau et la modale de note partagent un même composant Alpine ; le conteneur
       s'efface de la mise en page (display: contents) pour ne pas casser la colonne. #}
    <div class="stock-note-scope" x-data="stockNoteModal">

    {% for section in summary %}
        <div class="stock-dashboard-section">
            <div class="stock-dashboard-section-header">
                {% if section.category %}
                    <h2 class="stock-dashboard-section-title">{{ section.category.name }}</h2>
                {% else %}
                    <h2 class="stock-dashboard-section-title">Sans catégorie</h2>
                {% endif %}
                <span class="stock-dashboard-section-count">{{ section.items|length }} article{{ section.items|length > 1 ? 's' : '' }}</span>
            </div>

            <div class="table-wrapper">
                <table class="table resp-table">
                    <thead>
                        <tr>
                            <th class="stock-col-nom">Article</th>
                            <th class="stock-col-stock">Stock actuel</th>
                            <th class="stock-col-seuil">Seuil alerte</th>
                            <th class="stock-col-actions">Actions</th>
                        </tr>
                    </thead>
                        {% for row in section.items %}
                        <tbody x-data="{ open: false }">
                            <tr{% if not row.item.actif %} class="stock-row-archived"{% endif %}>
                                <td class="stock-col-nom">
                                    <div class="stock-nom-wrap{% if row.hasTailles %} stock-nom-clickable{% endif %}"{% if row.hasTailles %} @click="open = !open" title="Voir le détail par taille"{% endif %}>
                                        {% if row.hasTailles %}
                                            <span class="stock-row-toggle" :class="{ 'is-open': open }">
                                                {{ ui.icon('chevron-right', 14) }}
                                            </span>
                                        {% endif %}
                                        <div class="stock-nom-texts">
                                            <span class="stock-item-nom">{{ row.item.nom }}</span>
                                            <span class="stock-item-meta">
                                                {% if not row.item.actif %}<span class="stock-badge-archived-label">Archivé</span>{% endif %}
                                                {% if row.item.marque %}{{ row.item.marque }}{% endif %}
                                                {% if row.item.marque and row.item.taille %} · {% endif %}
                                                {% if row.item.taille %}{{ row.item.taille }}{% endif %}
                                                {% if (row.item.marque or row.item.taille) and row.item.couleur %} · {% endif %}
                                                {% if row.item.couleur %}{{ row.item.couleur }}{% endif %}
                                            </span>
                                            {# Le texte vit dans la modale, pas dans la cellule : une note de
                                               trois lignes déformait la ligne de l'article. #}
                                            <button type="button"
                                                    class="stock-note-btn{{ row.item.note ? ' is-remplie' : '' }}"
                                                    @click.stop="ouvrir({{ {
                                                        titre: 'Note — ' ~ row.item.nom,
                                                        sousTitre: 'Note de l\'article, toutes tailles confondues',
                                                        action: path('admin_stock_items_note', {id: row.item.id}),
                                                        token: csrf_token('note_article_' ~ row.item.id),
                                                        note: row.item.note,
                                                    }|json_encode|e('html_attr') }})">
                                                {{ ui.icon('file-text', 12) }}
                                                {{ row.item.note ? 'Voir la note' : 'Ajouter une note' }}
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                <td class="stock-col-stock">
                                    <span class="stock-badge stock-badge-{{ row.niveau.value }}">
                                        {{ row.stock }}
                                        {{ row.niveau.label }}
                                    </span>
                                </td>
                                <td class="stock-col-seuil">
                                    {{ row.item.alertSeuil ?? '—' }}
                                </td>
                                <td class="stock-col-actions">
                                    <div class="table-actions-cellule">
                                        {% if row.item.actif %}
                                            <button
                                                type="button"
                                                class="btn btn-primary btn-sm"
                                                @click="openModal({{ row.item.id }}, '{{ row.item.nom|e('js') }}', {{ row.stock }})"
                                            >
                                                + / − Mouvement
                                            </button>
                                            <a href="{{ path('admin_stock_items_edit', {id: row.item.id}) }}" class="btn btn-secondary btn-sm">Modifier</a>
                                            {# Écran de confirmation plutôt qu'une boîte de dialogue : lui seul sait dire
                                               si l'article part avec ses mouvements ou s'il sera archivé, et pourquoi. #}
                                            <a href="{{ path('admin_stock_items_delete_confirm', {id: row.item.id}) }}" class="btn btn-danger btn-sm">Supprimer</a>
                                        {% else %}
                                            <form method="post" action="{{ path('admin_stock_items_restore', {id: row.item.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('restore_stock_item_' ~ row.item.id) }}">
                                                <button type="submit" class="btn btn-secondary btn-sm">Désarchiver</button>
                                            </form>
                                            {# Un article archivé par erreur doit pouvoir partir pour de bon : l'écran
                                               de confirmation dira, là aussi, si son historique s'y oppose. #}
                                            <a href="{{ path('admin_stock_items_delete_confirm', {id: row.item.id}) }}" class="btn btn-danger btn-sm">Supprimer</a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                            {% if row.hasTailles %}
                                <tr class="stock-taille-detail" x-show="open" x-cloak>
                                    <td colspan="4">
                                        <table class="stock-taille-table">
                                            <thead>
                                                <tr><th>Taille</th><th>Stock</th><th class="stock-taille-table-note">Note</th></tr>
                                            </thead>
                                            <tbody>
                                                {% for t in row.tailles %}
                                                    <tr>
                                                        <td>{{ t.taille }}</td>
                                                        <td class="stock-taille-table-stock">{{ t.stock }}</td>
                                                        <td class="stock-taille-table-note">
                                                            {# Une ligne sans taille (« — ») ne porte pas de note :
                                                               celle de l'article la couvre déjà. #}
                                                            {% if t.sansTaille %}
                                                                <span class="stock-taille-note-vide">—</span>
                                                            {% else %}
                                                                <button type="button"
                                                                        class="stock-note-btn{{ t.note ? ' is-remplie' : '' }}"
                                                                        @click="ouvrir({{ {
                                                                            titre: 'Note — ' ~ row.item.nom,
                                                                            sousTitre: 'Taille ' ~ t.taille,
                                                                            action: path('admin_stock_items_note_taille', {id: row.item.id}),
                                                                            token: csrf_token('note_taille_' ~ row.item.id),
                                                                            taille: t.taille,
                                                                            note: t.note,
                                                                        }|json_encode|e('html_attr') }})">
                                                                    {{ ui.icon('file-text', 12) }}
                                                                    {{ t.note ? 'Voir la note' : 'Ajouter une note' }}
                                                                </button>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                        {% endfor %}
                </table>
            </div>
        </div>
    {% endfor %}

    {# Modale de note — article ou taille, selon ce que la ligne lui passe au clic #}
    <div class="modal-voile" x-show="ouverte" x-cloak @click.self="fermer()">
        <div class="modal">
            <div class="modal-header">
                <div>
                    <h3 class="modal-titre" x-text="titre"></h3>
                    <p class="stock-note-modal-soustitre" x-text="sousTitre"></p>
                </div>
                <button type="button" class="modal-fermer" @click="fermer()">✕</button>
            </div>

            <template x-if="lecture">
                <div>
                    <div class="modal-corps">
                        <p class="stock-note-modal-texte" x-text="note"></p>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn btn-ghost" @click="fermer()">Fermer</button>
                        <button type="button" class="btn btn-secondary" @click="modifier()">Modifier</button>
                    </div>
                </div>
            </template>

            <template x-if="!lecture">
                <form :action="action" method="post">
                    <div class="modal-corps">
                        <input type="hidden" name="_token" :value="token">
                        <template x-if="taille !== null">
                            <input type="hidden" name="taille" :value="taille">
                        </template>

                        <div class="field">
                            <label class="field-label" for="stock-note-texte">Note</label>
                            <textarea id="stock-note-texte" name="note" class="field-input" rows="5"
                                      x-model="note"
                                      placeholder="ex : taille petit, rangé dans l'armoire du local"></textarea>
                            <span class="stock-modal-hint">Videz le champ pour supprimer la note.</span>
                        </div>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn btn-ghost" @click="fermer()">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </form>
            </template>
        </div>
    </div>

    </div>{# fin du composant de note #}

    {# Modale mouvement #}
    <div class="modal-voile" x-show="modalOpen" x-transition.opacity style="display:none">
        <div class="modal" @click.outside="closeModal()">
            <div class="modal-header">
                <h3 class="modal-titre" x-text="'Mouvement — ' + itemNom"></h3>
                <button type="button" class="modal-fermer" @click="closeModal()">✕</button>
            </div>

            <form :action="formAction" method="post" class="modal-corps">
                <input type="hidden" name="_token" :value="csrfToken">

                <div class="field">
                    <label class="field-label">Action</label>
                    <div class="stock-modal-actions-grid">
                        <label class="stock-modal-radio" :class="{ active: action === 'entree' }">
                            <input type="radio" name="action" value="entree" x-model="action"> Entrée (réassort)
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'sortie' }">
                            <input type="radio" name="action" value="sortie" x-model="action"> Sortie
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'dotation' }">
                            <input type="radio" name="action" value="dotation" x-model="action"> Dotation joueur
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'rebut' }">
                            <input type="radio" name="action" value="rebut" x-model="action"> Rebut / perte
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label class="field-label">Quantité</label>
                    <input type="number" name="quantite" min="1" x-model="quantite" class="field-input" required>
                    <span class="stock-modal-hint" x-text="'Stock total : ' + stockActuel"></span>
                    <div class="stock-modal-stocklist" x-show="taillesEntries.length">
                        <span class="stock-modal-stocklist-label">En stock par taille</span>
                        <div class="stock-modal-chips">
                            <template x-for="[t, q] in taillesEntries" :key="t">
                                <span class="stock-modal-chip" :class="{ 'is-empty': q <= 0 }">
                                    <span class="stock-modal-chip-taille" x-text="t"></span>
                                    <span class="stock-modal-chip-qty" x-text="q"></span>
                                </span>
                            </template>
                        </div>
                    </div>
                </div>

                {# Les tailles proposées suivent le type de l'article : pointures pour les pieds,
                   tailles de vêtement pour le reste, aucune pour l'épicerie. #}
                <div class="field" x-show="taillesOptions.length" x-cloak>
                    <label class="field-label">Taille <span style="color:var(--color-text-muted);font-weight:400;font-size:var(--font-size-xs)">(optionnel)</span></label>
                    <select name="taille" x-model="taille" class="field-input">
                        <option value="">— Sans taille —</option>
                        <template x-for="t in taillesOptions" :key="t">
                            <option :value="t" x-text="t"></option>
                        </template>
                    </select>
                    <span class="stock-modal-dispo"
                          x-show="taille && action !== 'entree'"
                          :class="{ 'is-empty': dispoTaille <= 0 }"
                          x-text="'Disponible en ' + taille + ' : ' + dispoTaille"></span>
                </div>

                <p class="stock-modal-hint" x-show="!taillesOptions.length && typeVetementARenseigner" x-cloak>
                    Cet article n'a pas de déclinaison de taille. Renseignez son
                    <a :href="urlArticle">type de vêtement</a> pour gérer le stock par taille.
                </p>

                <div class="field" x-show="action === 'dotation'" x-transition>
                    <label class="field-label">Licencié <span style="color:var(--color-text-muted);font-weight:400;font-size:var(--font-size-xs)">(paiement confirmé uniquement)</span></label>
                    <select name="licencie_uuid" class="field-input">
                        <option value="">— Sélectionner un licencié —</option>
                        {% if licenciesSoldes is empty %}
                            <option disabled>Aucun licencié avec paiement confirmé</option>
                        {% else %}
                            {% for licencie in licenciesSoldes %}
                                <option value="{{ licencie.uuid }}">{{ licencie.nom }} {{ licencie.prenom }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>

                <div class="field" x-show="action === 'rebut' || action === 'sortie' || action === 'dotation'" x-transition>
                    <label class="field-label">
                        Note / justification
                        <span x-show="action === 'rebut'" style="color: var(--color-danger)">*</span>
                    </label>
                    <textarea name="note" class="field-input" :required="action === 'rebut'" rows="2" placeholder="Raison, contexte…"></textarea>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @click="closeModal()">Annuler</button>
                    <button type="submit" class="btn btn-primary" :disabled="!action || quantite < 1">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

</div>


{# Tokens CSRF + tailles de chaque article (stock et options), lus par la modale #}
{% for section in summary %}
    {% for row in section.items %}
        <input type="hidden" id="csrf-{{ row.item.id }}" value="{{ csrf_token('stock_movement_' ~ row.item.id) }}">
        <input type="hidden" id="tailles-{{ row.item.id }}" value="{{ {
            stock: row.taillesMap,
            options: row.taillesOptions,
            typeARenseigner: row.typeVetementARenseigner,
        }|json_encode }}">
    {% endfor %}
{% endfor %}

{% endblock %}
