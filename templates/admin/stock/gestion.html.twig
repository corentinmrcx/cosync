{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Gestion du stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: 'Gestion' }
] } %}

<div class="stock-dashboard-page" x-data="stockMovementModal()">

    <div class="stock-dashboard-header">
        <h1 class="stock-dashboard-title">Gestion du stock</h1>
        <div class="stock-dashboard-actions">
            <a href="{{ showArchived ? path('admin_stock_gestion') : path('admin_stock_gestion', {archivés: 1}) }}" class="stock-dashboard-btn-secondary{% if showArchived %} stock-btn-archived-active{% endif %}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
                {{ showArchived ? 'Masquer les archivés' : 'Voir les archivés' }}
            </a>
            <a href="{{ path('admin_stock_items_new') }}" class="stock-dashboard-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nouvel article
            </a>
        </div>
    </div>

    {% if summary is empty %}
        <div class="stock-dashboard-empty">
            <p>Aucun article de stock pour cette saison.</p>
            <a href="{{ path('admin_stock_items_new') }}" class="stock-dashboard-btn-primary">Créer un article</a>
        </div>
    {% endif %}

    {% for section in summary %}
        <div class="stock-dashboard-section">
            <div class="stock-dashboard-section-header">
                {% if section.category %}
                    <h2 class="stock-dashboard-section-title">{{ section.category.name }}</h2>
                {% else %}
                    <h2 class="stock-dashboard-section-title">Sans catégorie</h2>
                {% endif %}
                <span class="stock-dashboard-section-count">{{ section.items|length }} article{{ section.items|length > 1 ? 's' : '' }}</span>
            </div>

            <div class="stock-dashboard-table-wrapper">
                <table class="stock-dashboard-table resp-table">
                    <thead>
                        <tr>
                            <th class="stock-col-nom">Article</th>
                            <th class="stock-col-stock">Stock actuel</th>
                            <th class="stock-col-seuil">Seuil alerte</th>
                            <th class="stock-col-actions">Actions</th>
                        </tr>
                    </thead>
                        {% for row in section.items %}
                        <tbody x-data="{ open: false }">
                            <tr{% if not row.item.actif %} class="stock-row-archived"{% endif %}>
                                <td class="stock-col-nom">
                                    <div class="stock-nom-wrap{% if row.hasTailles %} stock-nom-clickable{% endif %}"{% if row.hasTailles %} @click="open = !open" title="Voir le détail par taille"{% endif %}>
                                        {% if row.hasTailles %}
                                            <span class="stock-row-toggle" :class="{ 'is-open': open }">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                                            </span>
                                        {% endif %}
                                        <div class="stock-nom-texts">
                                            <span class="stock-item-nom">{{ row.item.nom }}</span>
                                            <span class="stock-item-meta">
                                                {% if not row.item.actif %}<span class="stock-badge-archived-label">Archivé</span>{% endif %}
                                                {% if row.item.marque %}{{ row.item.marque }}{% endif %}
                                                {% if row.item.marque and row.item.taille %} · {% endif %}
                                                {% if row.item.taille %}{{ row.item.taille }}{% endif %}
                                                {% if (row.item.marque or row.item.taille) and row.item.couleur %} · {% endif %}
                                                {% if row.item.couleur %}{{ row.item.couleur }}{% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="stock-col-stock">
                                    <span class="stock-badge stock-badge-{{ row.status }}">
                                        {{ row.stock }}
                                        {% if row.stock <= 0 %}Rupture{% elseif row.status == 'warning' %}Stock bas{% endif %}
                                    </span>
                                </td>
                                <td class="stock-col-seuil">
                                    {{ row.item.alertSeuil ?? '—' }}
                                </td>
                                <td class="stock-col-actions">
                                    {% if row.item.actif %}
                                        <button
                                            type="button"
                                            class="stock-action-mouvement"
                                            @click="openModal({{ row.item.id }}, '{{ row.item.nom|e('js') }}', {{ row.stock }})"
                                        >
                                            + / − Mouvement
                                        </button>
                                        <a href="{{ path('admin_stock_items_edit', {id: row.item.id}) }}" class="stock-action-edit">Modifier</a>
                                        <form method="post" action="{{ path('admin_stock_items_delete', {id: row.item.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cet article ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_stock_item_' ~ row.item.id) }}">
                                            <button type="submit" class="stock-action-delete">Supprimer</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_stock_items_restore', {id: row.item.id}) }}" style="display:inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('restore_stock_item_' ~ row.item.id) }}">
                                            <button type="submit" class="stock-action-restore">Désarchiver</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                            {% if row.hasTailles %}
                                <tr class="stock-taille-detail" x-show="open" x-cloak>
                                    <td colspan="4">
                                        <table class="stock-taille-table">
                                            <thead>
                                                <tr><th>Taille</th><th>Stock</th></tr>
                                            </thead>
                                            <tbody>
                                                {% for t in row.tailles %}
                                                    <tr>
                                                        <td>{{ t.taille }}</td>
                                                        <td class="stock-taille-table-stock">{{ t.stock }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                        {% endfor %}
                </table>
            </div>
        </div>
    {% endfor %}

    {# Modale mouvement #}
    <div class="stock-modal-backdrop" x-show="modalOpen" x-transition.opacity style="display:none">
        <div class="stock-modal" @click.outside="closeModal()">
            <div class="stock-modal-header">
                <h3 class="stock-modal-title" x-text="'Mouvement — ' + itemNom"></h3>
                <button type="button" class="stock-modal-close" @click="closeModal()">✕</button>
            </div>

            <form :action="formAction" method="post" class="stock-modal-form">
                <input type="hidden" name="_token" :value="csrfToken">

                <div class="stock-modal-field">
                    <label class="stock-modal-label">Action</label>
                    <div class="stock-modal-actions-grid">
                        <label class="stock-modal-radio" :class="{ active: action === 'entree' }">
                            <input type="radio" name="action" value="entree" x-model="action"> Entrée (réassort)
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'sortie' }">
                            <input type="radio" name="action" value="sortie" x-model="action"> Sortie
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'dotation' }">
                            <input type="radio" name="action" value="dotation" x-model="action"> Dotation joueur
                        </label>
                        <label class="stock-modal-radio" :class="{ active: action === 'rebut' }">
                            <input type="radio" name="action" value="rebut" x-model="action"> Rebut / perte
                        </label>
                    </div>
                </div>

                <div class="stock-modal-field">
                    <label class="stock-modal-label">Quantité</label>
                    <input type="number" name="quantite" min="1" x-model="quantite" class="stock-modal-input" required>
                    <span class="stock-modal-hint" x-text="'Stock total : ' + stockActuel"></span>
                    <div class="stock-modal-stocklist" x-show="taillesEntries.length">
                        <span class="stock-modal-stocklist-label">En stock par taille</span>
                        <div class="stock-modal-chips">
                            <template x-for="[t, q] in taillesEntries" :key="t">
                                <span class="stock-modal-chip" :class="{ 'is-empty': q <= 0 }">
                                    <span class="stock-modal-chip-taille" x-text="t"></span>
                                    <span class="stock-modal-chip-qty" x-text="q"></span>
                                </span>
                            </template>
                        </div>
                    </div>
                </div>

                <div class="stock-modal-field">
                    <label class="stock-modal-label">Taille <span style="color:var(--color-text-muted);font-weight:400;font-size:var(--font-size-xs)">(optionnel)</span></label>
                    <select name="taille" x-model="taille" class="stock-modal-select">
                        <option value="">— Sans taille —</option>
                        {% for t in taillesConnues %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
                    </select>
                    <span class="stock-modal-dispo"
                          x-show="taille && action !== 'entree'"
                          :class="{ 'is-empty': dispoTaille <= 0 }"
                          x-text="'Disponible en ' + taille + ' : ' + dispoTaille"></span>
                </div>

                <div class="stock-modal-field" x-show="action === 'dotation'" x-transition>
                    <label class="stock-modal-label">Licencié <span style="color:var(--color-text-muted);font-weight:400;font-size:var(--font-size-xs)">(paiement confirmé uniquement)</span></label>
                    <select name="licencie_uuid" class="stock-modal-select">
                        <option value="">— Sélectionner un licencié —</option>
                        {% if licenciesValides is empty %}
                            <option disabled>Aucun licencié avec paiement confirmé</option>
                        {% else %}
                            {% for licencie in licenciesValides %}
                                <option value="{{ licencie.uuid }}">{{ licencie.nom }} {{ licencie.prenom }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>

                <div class="stock-modal-field" x-show="action === 'rebut' || action === 'sortie' || action === 'dotation'" x-transition>
                    <label class="stock-modal-label">
                        Note / justification
                        <span x-show="action === 'rebut'" style="color: var(--color-danger)">*</span>
                    </label>
                    <textarea name="note" class="stock-modal-textarea" :required="action === 'rebut'" rows="2" placeholder="Raison, contexte…"></textarea>
                </div>

                <div class="stock-modal-footer">
                    <button type="button" class="stock-modal-cancel" @click="closeModal()">Annuler</button>
                    <button type="submit" class="stock-modal-submit" :disabled="!action || quantite < 1">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
function stockMovementModal() {
    return {
        modalOpen: false,
        itemId: null,
        itemNom: '',
        stockActuel: 0,
        taillesStock: {},
        action: 'entree',
        quantite: 1,
        taille: '',
        get formAction() {
            return `/admin/stock/items/${this.itemId}/mouvement`;
        },
        get csrfToken() {
            return document.getElementById('csrf-' + this.itemId)?.value ?? '';
        },
        get taillesEntries() {
            const order = {{ tailles_toutes()|json_encode|raw }};
            const rank = (t) => {
                const i = order.indexOf(t);
                return i === -1 ? order.length : i;
            };
            return Object.entries(this.taillesStock)
                .sort(([a], [b]) => rank(a) - rank(b) || a.localeCompare(b));
        },
        get dispoTaille() {
            return this.taillesStock[this.taille] ?? 0;
        },
        openModal(id, nom, stock) {
            this.itemId    = id;
            this.itemNom   = nom;
            this.stockActuel = stock;
            const raw = document.getElementById('tailles-' + id)?.value;
            this.taillesStock = raw ? JSON.parse(raw) : {};
            this.action    = 'entree';
            this.quantite  = 1;
            this.taille    = '';
            this.modalOpen = true;
        },
        closeModal() {
            this.modalOpen = false;
        },
    };
}
</script>

{# Tokens CSRF + stock par taille (JSON) cachés pour chaque item, lus par la modale #}
{% for section in summary %}
    {% for row in section.items %}
        <input type="hidden" id="csrf-{{ row.item.id }}" value="{{ csrf_token('stock_movement_' ~ row.item.id) }}">
        <input type="hidden" id="tailles-{{ row.item.id }}" value="{{ row.taillesMap|json_encode }}">
    {% endfor %}
{% endfor %}

{% endblock %}
