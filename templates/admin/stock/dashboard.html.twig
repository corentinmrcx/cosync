{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Stock' }
] } %}

<div class="stock-home-page">

    <div class="stock-home-header">
        <div>
            <h1 class="stock-home-title">Stock</h1>
        </div>
        <div class="stock-home-actions">
            <a href="{{ path('admin_stock_gestion') }}" class="btn btn-primary">
                {{ ui.icon('list') }}
                Gérer le stock
            </a>
        </div>
    </div>

    {# — Tuiles de synthèse — #}
    <div class="stat-grid">
        <div class="stat-card stat-card-primary">
            <span class="stat-card-icon">{{ ui.icon('box', 20) }}</span>
            <span class="stat-card-body">
                <span class="stat-card-value">{{ data.nbArticles }}</span>
                <span class="stat-card-label">Article{{ data.nbArticles > 1 ? 's' : '' }} au catalogue</span>
            </span>
        </div>
        <div class="stat-card {{ data.nbAlertes > 0 ? 'stat-card-warning' }}">
            <span class="stat-card-icon">{{ ui.icon('alert-triangle', 20) }}</span>
            <span class="stat-card-body">
                <span class="stat-card-value">{{ data.nbAlertes }}</span>
                <span class="stat-card-label">Stock bas</span>
            </span>
        </div>
        <div class="stat-card {{ data.nbRuptures > 0 ? 'stat-card-danger' }}">
            <span class="stat-card-icon">{{ ui.icon('package', 20) }}</span>
            <span class="stat-card-body">
                <span class="stat-card-value">{{ data.nbRuptures }}</span>
                <span class="stat-card-label">En rupture</span>
            </span>
        </div>
        <div class="stat-card {{ aCommanderCount > 0 ? 'stat-card-warning' }}">
            <span class="stat-card-icon">{{ ui.icon('cart', 20) }}</span>
            <span class="stat-card-body">
                <span class="stat-card-value">{{ aCommanderCount }}</span>
                <span class="stat-card-label">À commander</span>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-card-icon">{{ ui.icon('truck', 20) }}</span>
            <span class="stat-card-body">
                <span class="stat-card-value">{{ commandesEnAttente }}</span>
                <span class="stat-card-label">Commande{{ commandesEnAttente > 1 ? 's' : '' }} en attente</span>
            </span>
        </div>
    </div>

    {# — À réapprovisionner — #}
    <div class="stock-home-section">
        <div class="stock-home-section-header">
            <h2 class="stock-home-section-title">À réapprovisionner</h2>
            <span class="stock-home-section-count">{{ data.alertes|length }}</span>
        </div>

        {% if data.alertes is empty %}
            <p class="stock-home-empty">Aucun réapprovisionnement à prévoir</p>
        {% else %}
            <div class="table-wrapper">
                <table class="table resp-table">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th>Stock</th>
                            <th>Seuil</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in data.alertes %}
                            <tr>
                                <td>
                                    <span>
                                        <span class="stock-home-item-nom">{{ row.item.nom }}</span>
                                        <span class="stock-home-item-meta">
                                            {% if row.item.marque %}{{ row.item.marque }}{% endif %}
                                            {% if row.item.marque and row.item.taille %} · {% endif %}
                                            {% if row.item.taille %}{{ row.item.taille }}{% endif %}
                                            {% if (row.item.marque or row.item.taille) and row.item.couleur %} · {% endif %}
                                            {% if row.item.couleur %}{{ row.item.couleur }}{% endif %}
                                        </span>
                                    </span>
                                </td>
                                <td>
                                    <span class="stock-badge stock-badge-{{ row.niveau.value }}">
                                        {% if row.stock <= 0 %}Rupture{% else %}{{ row.stock }} · stock bas{% endif %}
                                    </span>
                                </td>
                                <td>{{ row.item.alertSeuil ?? '—' }}</td>
                                <td class="stock-home-table-action">
                                    {% if row.item.lienAchat %}
                                        <a href="{{ row.item.lienAchat }}" target="_blank" rel="noopener" class="stock-home-buy">Voir l'article ↗</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# — Accès rapides — #}
    <div class="stock-home-section">
        <div class="stock-home-section-header">
            <h2 class="stock-home-section-title">Accès rapides</h2>
        </div>
        <div class="quicklink-grid">
            <a href="{{ path('admin_stock_gestion') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('list', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Gérer le stock</span>
                    <span class="quicklink-text">Catalogue des articles, stock par taille, entrées et sorties</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_dotations_suivi') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('clipboard-list', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Suivi des dotations</span>
                    <span class="quicklink-text">Ce que chaque joueur doit recevoir et ce qui a été remis</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_dotations_index') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('layers', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Modèles de dotation</span>
                    <span class="quicklink-text">Configurer les articles attribués par équipe ou catégorie</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_commandes_index') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('cart', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Commandes</span>
                    <span class="quicklink-text">À commander, bons par fournisseur, réceptions</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_mouvements_list') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('history', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Historique des mouvements</span>
                    <span class="quicklink-text">Entrées, sorties et rebuts, filtrables par article et taille</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_inventaire_pdf') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('file-text', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Inventaire PDF</span>
                    <span class="quicklink-text">Feuille d'inventaire complète, ventilée par taille</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_fournisseurs_list') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('truck', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Fournisseurs</span>
                    <span class="quicklink-text">Carnet d'adresses des fournisseurs d'équipement</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
            <a href="{{ path('admin_stock_categories_list') }}" class="quicklink">
                <span class="quicklink-icon">{{ ui.icon('tag', 20) }}</span>
                <span class="quicklink-body">
                    <span class="quicklink-title">Catégories</span>
                    <span class="quicklink-text">Organiser les articles par catégorie</span>
                </span>
                <span class="quicklink-arrow">{{ ui.icon('arrow-right') }}</span>
            </a>
        </div>
    </div>

</div>
{% endblock %}
