{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Stock{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock' }
] } %}

<div class="stock-home-page">

    <div class="stock-home-header">
        <div>
            <h1 class="stock-home-title">Stock</h1>
        </div>
        <div class="stock-home-actions">
            <a href="{{ path('admin_stock_inventaire_pdf') }}" class="stock-home-btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                Inventaire PDF
            </a>
            <a href="{{ path('admin_stock_mouvements_list') }}" class="stock-home-btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                Historique
            </a>
            <a href="{{ path('admin_stock_gestion') }}" class="stock-home-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Gérer le stock
            </a>
        </div>
    </div>

    {# — Tuiles de synthèse — #}
    <div class="stock-home-tiles">
        <div class="stock-home-tile">
            <span class="stock-home-tile-value">{{ data.nbArticles }}</span>
            <span class="stock-home-tile-label">Article{{ data.nbArticles > 1 ? 's' : '' }} au catalogue</span>
        </div>
        <div class="stock-home-tile {{ data.nbAlertes > 0 ? 'stock-home-tile-warning' }}">
            <span class="stock-home-tile-value">{{ data.nbAlertes }}</span>
            <span class="stock-home-tile-label">Stock bas</span>
        </div>
        <div class="stock-home-tile {{ data.nbRuptures > 0 ? 'stock-home-tile-danger' }}">
            <span class="stock-home-tile-value">{{ data.nbRuptures }}</span>
            <span class="stock-home-tile-label">En rupture</span>
        </div>
        <div class="stock-home-tile {{ aCommanderCount > 0 ? 'stock-home-tile-warning' }}">
            <span class="stock-home-tile-value">{{ aCommanderCount }}</span>
            <span class="stock-home-tile-label">À commander</span>
        </div>
        <div class="stock-home-tile">
            <span class="stock-home-tile-value">{{ commandesEnAttente }}</span>
            <span class="stock-home-tile-label">Commande{{ commandesEnAttente > 1 ? 's' : '' }} en attente</span>
        </div>
        {% if data.valeurStock > 0 %}
        <div class="stock-home-tile">
            <span class="stock-home-tile-value">{{ data.valeurStock|number_format(0, ',', ' ') }} €</span>
            <span class="stock-home-tile-label">Valeur du stock</span>
        </div>
        {% endif %}
    </div>

    {# — À réapprovisionner — #}
    <div class="stock-home-section">
        <div class="stock-home-section-header">
            <h2 class="stock-home-section-title">À réapprovisionner</h2>
            <span class="stock-home-section-count">{{ data.alertes|length }}</span>
        </div>

        {% if data.alertes is empty %}
            <p class="stock-home-empty">Aucun réapprovisionnement à prévoir</p>
        {% else %}
            <div class="stock-home-table-wrapper">
                <table class="stock-home-table">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th>Stock</th>
                            <th>Seuil</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in data.alertes %}
                            <tr>
                                <td>
                                    <span class="stock-home-item-nom">{{ row.item.nom }}</span>
                                    <span class="stock-home-item-meta">
                                        {% if row.item.marque %}{{ row.item.marque }}{% endif %}
                                        {% if row.item.marque and row.item.taille %} · {% endif %}
                                        {% if row.item.taille %}{{ row.item.taille }}{% endif %}
                                        {% if (row.item.marque or row.item.taille) and row.item.couleur %} · {% endif %}
                                        {% if row.item.couleur %}{{ row.item.couleur }}{% endif %}
                                    </span>
                                </td>
                                <td>
                                    <span class="stock-badge stock-badge-{{ row.status }}">
                                        {% if row.stock <= 0 %}Rupture{% else %}{{ row.stock }} · stock bas{% endif %}
                                    </span>
                                </td>
                                <td>{{ row.item.alertSeuil ?? '—' }}</td>
                                <td class="stock-home-table-action">
                                    {% if row.item.lienAchat %}
                                        <a href="{{ row.item.lienAchat }}" target="_blank" rel="noopener" class="stock-home-buy">Commander ↗</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# — Accès rapides — #}
    <div class="stock-home-section">
        <div class="stock-home-section-header">
            <h2 class="stock-home-section-title">Accès rapides</h2>
        </div>
        <div class="stock-home-links">
            <a href="{{ path('admin_stock_dotations_index') }}" class="stock-home-link-card">
                <span class="stock-home-link-title">Dotations</span>
                <span class="stock-home-link-text">Modèles, affectations et suivi des remises</span>
            </a>
            <a href="{{ path('admin_stock_commandes_index') }}" class="stock-home-link-card">
                <span class="stock-home-link-title">Commandes</span>
                <span class="stock-home-link-text">À commander, bons par fournisseur, réceptions</span>
            </a>
            <a href="{{ path('admin_stock_fournisseurs_list') }}" class="stock-home-link-card">
                <span class="stock-home-link-title">Fournisseurs</span>
                <span class="stock-home-link-text">Carnet d'adresses des fournisseurs d'équipement</span>
            </a>
            <a href="{{ path('admin_stock_categories_list') }}" class="stock-home-link-card">
                <span class="stock-home-link-title">Catégories</span>
                <span class="stock-home-link-text">Organiser les articles par catégorie</span>
            </a>
        </div>
    </div>

</div>
{% endblock %}
