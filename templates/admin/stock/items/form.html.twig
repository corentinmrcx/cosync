{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ title }}{% endblock %}

{% set initialKind = item and item.kind ? item.kind.value : 'equipement' %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: title }
] } %}

<div class="stock-items-page">
    <div class="stock-items-card">

        <div class="stock-items-card-header">
            <h1 class="stock-items-card-title">{{ title }}</h1>
        </div>

        {{ form_start(form, {attr: {class: 'stock-items-form', 'x-data': "{ kind: '" ~ initialKind ~ "' }"}}) }}

            {# ── Type d'article ── #}
            <div class="stock-items-section-title">Type d'article</div>

            <div class="field">
                <label class="field-label">Type</label>
                <select name="kind" x-model="kind" class="field-input">
                    {% for kind in kinds %}
                        <option value="{{ kind.value }}" {{ initialKind == kind.value ? 'selected' }}>{{ kind.label() }}</option>
                    {% endfor %}
                </select>
            </div>

            {# ── Identification ── #}
            <div class="stock-items-section-title">Identification</div>

            <div class="field">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="stock-items-row">
                <div class="field">
                    {% include 'components/text-combobox.html.twig' with {
                        name: 'marque',
                        label: 'Marque',
                        suggestions: marques,
                        current: item ? item.marque : null,
                        placeholder: 'ex: Nike, Coca-Cola…'
                    } %}
                </div>

                {# — Contenance : affichée uniquement pour l'épicerie — #}
                <template x-if="kind === 'epicerie'">
                    <div class="field">
                        {% include 'components/text-combobox.html.twig' with {
                            name: 'taille',
                            label: 'Contenance',
                            suggestions: contenances,
                            current: item and item.kind and item.kind.value == 'epicerie' ? item.taille : null,
                            placeholder: 'ex: 33cl, 50cl, 1L…'
                        } %}
                    </div>
                </template>
            </div>

            {# — Champs spécifiques équipement — #}
            <template x-if="kind === 'equipement'">
                <div class="stock-items-row">
                    <div class="field">
                        {% include 'components/text-combobox.html.twig' with {
                            name: 'couleur',
                            label: 'Couleur',
                            suggestions: couleurs,
                            current: item ? item.couleur : null,
                            placeholder: 'ex: Rouge, Blanc…'
                        } %}
                    </div>
                    <div class="field">
                        <label class="field-label">Type de vêtement</label>
                        <select name="typeVetement" class="field-input">
                            <option value="">— Non applicable —</option>
                            {% for type in vetementTypes %}
                                <option value="{{ type.value }}"
                                        {{ item and item.typeVetement == type ? 'selected' }}>
                                    {{ type.label() }}
                                </option>
                            {% endfor %}
                        </select>
                        <p class="stock-items-help">Un article = un modèle (sans taille figée). Les tailles sont gérées comme déclinaisons de stock à l'entrée, et la dotation choisit automatiquement la bonne taille selon la fiche du joueur.</p>
                    </div>
                </div>
            </template>

            {# ── Catégorisation ── #}
            <div class="stock-items-section-title">Catégorisation</div>

            <div class="field">
                <div class="stock-items-label-row">
                    {{ form_label(form.category) }}
                    <a href="{{ path('admin_stock_categories_list') }}" class="stock-items-label-link" target="_blank">Gérer ↗</a>
                </div>
                {{ form_widget(form.category) }}
            </div>

            <div class="field">
                <div class="stock-items-label-row">
                    {{ form_label(form.fournisseur) }}
                    <a href="{{ path('admin_stock_fournisseurs_list') }}" class="stock-items-label-link" target="_blank">Gérer ↗</a>
                </div>
                {{ form_widget(form.fournisseur) }}
                {{ form_help(form.fournisseur) }}
            </div>

            {# ── Stock & budget ── #}
            <div class="stock-items-section-title">Stock & budget</div>

            <div class="stock-items-row">
                <div class="field">
                    {{ form_label(form.alertSeuil) }}
                    {{ form_widget(form.alertSeuil) }}
                    {{ form_help(form.alertSeuil) }}
                </div>
                <div class="field">
                    {{ form_label(form.prixAchat) }}
                    {{ form_widget(form.prixAchat) }}
                    {{ form_help(form.prixAchat) }}
                </div>
            </div>

            {# ── Référence ── #}
            <div class="stock-items-section-title">Référence</div>

            <div class="stock-items-row">
                <div class="field">
                    {{ form_label(form.refCatalogue) }}
                    {{ form_widget(form.refCatalogue) }}
                </div>
                <div class="field">
                    {{ form_label(form.lienAchat) }}
                    {{ form_widget(form.lienAchat) }}
                </div>
            </div>

            <div class="stock-items-actions">
                <a href="{{ path('admin_stock_dashboard') }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary btn-lg">
                    {{ item ? 'Enregistrer les modifications' : 'Créer l\'article' }}
                </button>
            </div>

        {{ form_end(form) }}

    </div>
</div>
{% endblock %}
