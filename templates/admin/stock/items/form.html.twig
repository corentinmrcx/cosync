{% extends 'admin/layout.html.twig' %}
{% import 'components/_stock_item_label.html.twig' as article %}

{% block title %}CoSync — {{ title }}{% endblock %}

{% set initialKind = item and item.kind ? item.kind.value : 'equipement' %}
{% set initialTypeVetement = item and item.typeVetement ? item.typeVetement.value : '' %}
{% set initialGrille = item and item.grilleTaille ? item.grilleTaille.id : '' %}

{# Échelle de tailles impliquée par le type de vêtement : elle décide des grilles proposées.
   Le serveur refait le contrôle — un onglet resté ouvert pendant qu'une grille changeait
   d'échelle enverrait sinon un rattachement incohérent. #}
{% set etatFormulaire = {
    kind: initialKind,
    typeVetement: initialTypeVetement,
    grille: initialGrille,
}|json_encode %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Stock', route: 'admin_stock_dashboard' },
    { label: title }
] } %}

<div class="stock-items-page">
    <div class="stock-items-card">

        <div class="stock-items-card-header">
            <h1 class="stock-items-card-title">{{ title }}</h1>
        </div>

        {{ form_start(form, {attr: {class: 'stock-items-form', 'x-data': 'stockItemForm(' ~ etatFormulaire ~ ')'}}) }}

            {# ── Type d'article ── #}
            <div class="stock-items-section-title">Type d'article</div>

            <div class="field">
                <label class="field-label">Type</label>
                <select name="kind" x-model="kind" class="field-input">
                    {% for kind in kinds %}
                        <option value="{{ kind.value }}" {{ initialKind == kind.value ? 'selected' }}>{{ kind.label() }}</option>
                    {% endfor %}
                </select>
            </div>

            {# ── Identification ── #}
            <div class="stock-items-section-title">Identification</div>

            <div class="field">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>

            <div class="stock-items-row">
                <div class="field">
                    {% include 'components/text-combobox.html.twig' with {
                        name: 'marque',
                        label: 'Marque',
                        suggestions: marques,
                        current: item ? item.marque : null,
                        placeholder: 'ex: Nike, Coca-Cola…'
                    } %}
                </div>

                {# — Contenance : affichée uniquement pour l'épicerie — #}
                <template x-if="kind === 'epicerie'">
                    <div class="field">
                        {% include 'components/text-combobox.html.twig' with {
                            name: 'taille',
                            label: 'Contenance',
                            suggestions: contenances,
                            current: item and item.kind and item.kind.value == 'epicerie' ? item.taille : null,
                            placeholder: 'ex: 33cl, 50cl, 1L…'
                        } %}
                    </div>
                </template>
            </div>

            {# — Champs spécifiques équipement — #}
            <template x-if="kind === 'equipement'">
                <div class="stock-items-row">
                    <div class="field">
                        {% include 'components/text-combobox.html.twig' with {
                            name: 'couleur',
                            label: 'Couleur',
                            suggestions: couleurs,
                            current: item ? item.couleur : null,
                            placeholder: 'ex: Rouge, Blanc…'
                        } %}
                    </div>
                    <div class="field">
                        <label class="field-label">Type de vêtement</label>
                        <select name="typeVetement" class="field-input" x-model="typeVetement">
                            <option value="">— Non applicable —</option>
                            {% for type in vetementTypes %}
                                <option value="{{ type.value }}">{{ type.label() }}</option>
                            {% endfor %}
                        </select>
                        <p class="stock-items-help">Un article = un modèle (sans taille figée). Les tailles sont gérées comme déclinaisons de stock à l'entrée, et la dotation choisit automatiquement la bonne taille selon la fiche du joueur.</p>
                    </div>
                </div>
            </template>

            {# La grille ne se pose que sur un vêtement : sans type, on ne sait pas quelle
               échelle traduire. #}
            <template x-if="kind === 'equipement' && typeVetement !== ''">
                <div class="field">
                    <div class="stock-items-label-row">
                        <label class="field-label">Grille de tailles</label>
                        <a href="{{ path('admin_grilles_index') }}" class="stock-items-label-link" target="_blank">Gérer ↗</a>
                    </div>
                    <select name="grilleTaille" class="field-input" x-model="grille">
                        <option value="">— Aucune : les tailles déclarées telles quelles —</option>
                        {% for g in grilles %}
                            <option value="{{ g.id }}"
                                    :hidden="echelle !== '{{ g.type.value }}'">{{ g.nom }}</option>
                        {% endfor %}
                    </select>
                    <p class="stock-items-help">
                        À renseigner quand le fournisseur ne vend pas cet article dans les tailles
                        du formulaire : des chaussettes en « 43-46 », une veste enfant en « 128 ».
                        La dotation traduira la taille déclarée avant de sortir l'article du stock.
                    </p>
                </div>
            </template>

            {# ── Écoulement, en lecture seule ──
               La règle ne se déclare plus ici. Vue depuis la fiche de l'ancien stock, elle se
               lit à l'envers de la décision qu'elle traduit — on ne se dit pas « ces Nike
               remplacent les ERIMA », on se dit « je commande de l'ERIMA, il me reste des
               Nike ». Elle se pose donc sur /admin/stock/ecoulement, dans ce sens-là, et un
               seul écran la porte. La mention reste : consulter un article sans savoir que
               son stock part en dotation à la place d'un autre serait pire que le silence. #}
            {% if item and (item.remplaceArticle or substituts is not empty) %}
                <div class="field">
                    <div class="stock-items-section-title">Écoulement de stock</div>
                    <p class="stock-items-help">
                        {% if item.remplaceArticle %}
                            Cet article est <strong>écoulé avant de commander</strong>
                            {{ article.label(item.remplaceArticle) }}.
                        {% endif %}
                        {% if substituts is not empty %}
                            Écoulé d'abord à sa place :
                            {% for substitut in substituts %}{{ article.label(substitut) }}{{ not loop.last ? ', ' }}{% endfor %}.
                        {% endif %}
                        <a href="{{ path('admin_stock_ecoulement_index') }}">Gérer les correspondances ↗</a>
                    </p>
                </div>
            {% endif %}

            {# ── Catégorisation ── #}
            <div class="stock-items-section-title">Catégorisation</div>

            <div class="field">
                <div class="stock-items-label-row">
                    {{ form_label(form.category) }}
                    <a href="{{ path('admin_stock_categories_list') }}" class="stock-items-label-link" target="_blank">Gérer ↗</a>
                </div>
                {{ form_widget(form.category) }}
            </div>

            <div class="field">
                <div class="stock-items-label-row">
                    {{ form_label(form.fournisseur) }}
                    <a href="{{ path('admin_stock_fournisseurs_list') }}" class="stock-items-label-link" target="_blank">Gérer ↗</a>
                </div>
                {{ form_widget(form.fournisseur) }}
                {{ form_help(form.fournisseur) }}
            </div>

            {# ── Stock & budget ── #}
            <div class="stock-items-section-title">Stock & budget</div>

            <div class="stock-items-row">
                <div class="field">
                    {{ form_label(form.alertSeuil) }}
                    {{ form_widget(form.alertSeuil) }}
                    {{ form_help(form.alertSeuil) }}
                </div>
                <div class="field">
                    {{ form_label(form.prixAchat) }}
                    {{ form_widget(form.prixAchat) }}
                    {{ form_help(form.prixAchat) }}
                </div>
            </div>

            <div class="field">
                {{ form_label(form.note) }}
                {{ form_widget(form.note) }}
                {{ form_help(form.note) }}
                {{ form_errors(form.note) }}
            </div>

            {# ── Référence ── #}
            <div class="stock-items-section-title">Référence</div>

            <div class="stock-items-row">
                <div class="field">
                    {{ form_label(form.refCatalogue) }}
                    {{ form_widget(form.refCatalogue) }}
                </div>
                <div class="field">
                    {{ form_label(form.lienAchat) }}
                    {{ form_widget(form.lienAchat) }}
                </div>
            </div>

            <div class="stock-items-actions">
                {# Même destination que l'enregistrement : on repart d'où l'on vient. #}
                <a href="{{ path('admin_stock_gestion') }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary btn-lg">
                    {{ item ? 'Enregistrer les modifications' : 'Créer l\'article' }}
                </button>
            </div>

        {{ form_end(form) }}

    </div>
</div>
{% endblock %}
