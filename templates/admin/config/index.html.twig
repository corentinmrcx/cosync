{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Configuration{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Configuration' }
] } %}

<div class="config-page">

    <div class="config-header">
        <h1 class="config-title">Configuration</h1>
    </div>

    <section class="config-section">
        <h2 class="config-section-title">Saison sélectionnée</h2>

        {% if currentSeason %}
            <div class="config-season-card">
                <div class="config-season-card-body">
                    <span class="config-season-card-label">{{ currentSeason.label }}</span>
                    <div class="config-season-card-costs">
                        <span>Jeunes : <strong>{{ currentSeason.baseCosts.jeunes ?? '—' }} €</strong></span>
                        <span>Seniors : <strong>{{ currentSeason.baseCosts.seniors ?? '—' }} €</strong></span>
                    </div>
                </div>
                <a href="{{ path('admin_seasons_edit', {id: currentSeason.id}) }}" class="config-action-link">
                    Modifier la saison
                </a>
            </div>
        {% else %}
            <div class="config-empty">
                Aucune saison sélectionnée.
                <a href="{{ path('admin_seasons_new') }}">Créer une saison →</a>
            </div>
        {% endif %}
    </section>

</div>
{% endblock %}
