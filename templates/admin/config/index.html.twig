{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Configuration{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Configuration' }
] } %}

<div class="season-form-page">

    {% if season is null %}

        <div class="season-form-card">
            <h1 class="season-form-header">Configuration</h1>
            <hr class="season-form-divider">
            <p class="season-form-empty">Aucune saison sélectionnée. Commencez par créer une saison.</p>
            <a href="{{ path('admin_seasons_new') }}" class="season-form-submit" style="text-decoration:none; align-self:flex-start;">
                Créer une saison →
            </a>
        </div>

    {% else %}

    <div class="config-row">

        {# — Paramètres saison — #}
        {{ form_start(form, { attr: { class: 'season-form-card' } }) }}

            <h1 class="season-form-header">Saison {{ season.label }}</h1>
            <hr class="season-form-divider">

            <div class="season-form-years">
                <div class="season-form-field">
                    {{ form_label(form.startYear) }}
                    {{ form_widget(form.startYear) }}
                </div>
                <div class="season-form-years-sep">→</div>
                <div class="season-form-field">
                    {{ form_label(form.endYear) }}
                    {{ form_widget(form.endYear) }}
                </div>
            </div>

            <div class="season-form-field">
                {{ form_label(form.coutJeunes) }}
                {{ form_widget(form.coutJeunes, { attr: { placeholder: '85' } }) }}
            </div>

            <div class="season-form-field">
                {{ form_label(form.coutSeniors) }}
                {{ form_widget(form.coutSeniors, { attr: { placeholder: '120' } }) }}
            </div>

            <button type="submit" class="season-form-submit">Enregistrer</button>
            <hr class="season-form-divider">
            <a href="{{ path('admin_seasons_reglement', {id: season.id}) }}" class="season-form-reglement-link">
                Éditer le règlement intérieur →
            </a>

        {{ form_end(form) }}

        {# — Équipes — #}
        <div class="season-form-card config-teams-card" x-data="{ editingTeam: null }">

            <h2 class="season-form-header" style="font-size:var(--font-size-lg)">Équipes de la saison</h2>
            <p class="config-teams-intro">Les licenciés importés sont automatiquement assignés à l'équipe correspondant à leur catégorie FFF.</p>
            <hr class="season-form-divider">

            {% if teams is empty %}
                <p class="season-form-empty">Aucune équipe configurée.</p>
            {% else %}
                <ul class="config-teams-list">
                    {% for team in teams %}
                        <li class="config-teams-item">
                            <div class="config-teams-row" x-show="editingTeam !== {{ team.id }}">
                                <div class="config-teams-info">
                                    <span class="config-teams-name">{{ team.name }}</span>
                                </div>
                                <div class="config-teams-btns">
                                    <button type="button" class="config-teams-btn-edit" @click="editingTeam = {{ team.id }}">Renommer</button>
                                    <form method="post" action="{{ path('admin_config_teams_delete', {id: team.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cette équipe ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}">
                                        <button type="submit" class="config-teams-btn-delete">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                            <form method="post" action="{{ path('admin_config_teams_edit', {id: team.id}) }}"
                                  class="config-teams-edit-row"
                                  x-show="editingTeam === {{ team.id }}"
                                  style="display:none">
                                <input type="text" name="team[name]" value="{{ team.name }}" class="season-form-input config-teams-edit-input" required>
                                <button type="submit" class="season-form-submit" style="padding:0.4rem 0.875rem;font-size:var(--font-size-xs)">OK</button>
                                <button type="button" style="background:none;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:0.4rem 0.625rem;font-size:var(--font-size-xs);cursor:pointer;font-family:var(--font-sans);color:var(--color-text-muted)" @click="editingTeam = null">✕</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <hr class="season-form-divider">

            <p class="season-form-header" style="font-size:var(--font-size-sm);font-weight:700;color:var(--color-text-body)">Ajouter une équipe</p>

            {{ form_start(newTeamForm, {attr: {class: 'config-teams-add-form'}}) }}
                <div class="season-form-field">
                    {{ form_label(newTeamForm.category) }}
                    {{ form_widget(newTeamForm.category) }}
                    {{ form_errors(newTeamForm.category) }}
                </div>
                <div class="season-form-field">
                    {{ form_label(newTeamForm.suffix) }}
                    {{ form_widget(newTeamForm.suffix) }}
                </div>
                <p class="config-teams-hint">Nom généré automatiquement depuis la catégorie, ex : <strong>SENIOR</strong>, <strong>U15 A</strong></p>
                <button type="submit" class="season-form-submit">Ajouter l'équipe</button>
            {{ form_end(newTeamForm) }}

        </div>

    </div>{# fin config-row #}

    {% endif %}

</div>
{% endblock %}
