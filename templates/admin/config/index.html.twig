{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Configuration{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Configuration' }
] } %}

<div class="season-form-page">

    {% if season is null %}

        <div class="season-form-card">
            <h1 class="season-form-header">Configuration</h1>
            <hr class="season-form-divider">
            <p class="season-form-empty">Aucune saison sélectionnée. Commencez par créer une saison.</p>
            <a href="{{ path('admin_seasons_new') }}" class="season-form-submit" style="text-decoration:none; align-self:flex-start;">
                Créer une saison →
            </a>
        </div>

    {% else %}

    {# Options partagées entre formulaire de création et formulaires d'édition #}
    {% set ms_opts = categories|map(c => {value: c.id, label: c.code}) %}

    <div class="config-row">

        {# — Paramètres saison — #}
        {{ form_start(form, { attr: { class: 'season-form-card' } }) }}

            <h1 class="season-form-header">Paramètres de la saison</h1>
            <hr class="season-form-divider">

            <div class="season-form-field" x-data="{ year: {{ form.startYear.vars.value }} }">
                {{ form_label(form.startYear) }}
                {{ form_widget(form.startYear, { attr: { 'x-model.number': 'year' } }) }}
                <p class="season-form-preview" x-text="'Saison ' + year + '–' + (year + 1)"></p>
            </div>

            <div class="season-form-field">
                {{ form_label(form.cotisationDefaut) }}
                {{ form_widget(form.cotisationDefaut) }}
                {{ form_help(form.cotisationDefaut) }}
                {{ form_errors(form.cotisationDefaut) }}
            </div>

            <button type="submit" class="season-form-submit">Enregistrer</button>
            <hr class="season-form-divider">
            <a href="{{ path('admin_seasons_reglement', {id: season.id}) }}" class="season-form-reglement-link">
                Éditer le règlement intérieur →
            </a>

        {{ form_end(form) }}

        {# — Équipes — #}
        <div class="season-form-card config-teams-card" x-data="{ editingTeam: null }">

            <h2 class="season-form-header" style="font-size:var(--font-size-lg)">Équipes de la saison</h2>
            <p class="config-teams-intro">Associez des catégories FFF à chaque équipe pour filtrer le tableau de bord et activer l'assignation automatique à l'import.</p>
            <hr class="season-form-divider">

            {% if teams is empty %}
                <p class="season-form-empty">Aucune équipe configurée.</p>
            {% else %}
                <ul class="config-teams-list">
                    {% for team in teams %}
                        <li class="config-teams-item">

                            {# — Vue normale — #}
                            <div class="config-teams-row" x-show="editingTeam !== {{ team.id }}">
                                <div class="config-teams-info">
                                    <span class="config-teams-name">{{ team.name }}</span>
                                    <span class="config-teams-cotisation">
                                        {% if team.cotisation is not null %}{{ team.cotisation }} €{% else %}Cotisation par défaut{% endif %}
                                    </span>
                                </div>
                                <div class="config-teams-btns">
                                    <button type="button" class="config-teams-btn-edit" @click="editingTeam = {{ team.id }}">Modifier</button>
                                    <form method="post" action="{{ path('admin_config_teams_delete', {id: team.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cette équipe ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_team_' ~ team.id) }}">
                                        <button type="submit" class="config-teams-btn-delete">Supprimer</button>
                                    </form>
                                </div>
                            </div>

                            {# — Formulaire d'édition — #}
                            <form method="post" action="{{ path('admin_config_teams_edit', {id: team.id}) }}"
                                  class="config-teams-edit-form"
                                  x-show="editingTeam === {{ team.id }}"
                                  style="display:none">
                                <input type="hidden" name="_token" value="{{ csrf_token('edit_team_' ~ team.id) }}">
                                <div class="season-form-field" style="margin:0">
                                    <label class="season-form-label" style="font-size:var(--font-size-xs)">Nom</label>
                                    <input type="text" name="team[name]" value="{{ team.name }}" class="season-form-input" required>
                                </div>
                                <div class="season-form-field" style="margin:0">
                                    <label class="season-form-label" style="font-size:var(--font-size-xs)">Cotisation (€)</label>
                                    <input type="number" min="0" step="1" name="team[cotisation]" value="{{ team.cotisation }}" class="season-form-input" placeholder="Cotisation par défaut">
                                </div>
                                <div class="season-form-field" style="margin:0">
                                    <label class="season-form-label" style="font-size:var(--font-size-xs)">Catégories FFF</label>
                                    {% include 'components/multi-select.html.twig' with {
                                        ms_name: 'team[categories][]',
                                        ms_options: ms_opts,
                                        ms_selected: team.categories|map(c => c.id),
                                        ms_placeholder: '— Aucune (ex : Loisirs) —'
                                    } %}
                                </div>
                                <div class="config-teams-edit-actions">
                                    <button type="submit" class="season-form-submit" style="padding:0.4rem 0.875rem;font-size:var(--font-size-xs)">Enregistrer</button>
                                    <button type="button" class="config-teams-btn-cancel" @click="editingTeam = null">Annuler</button>
                                </div>
                            </form>

                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <hr class="season-form-divider">

            <p class="season-form-header" style="font-size:var(--font-size-sm);font-weight:700;color:var(--color-text-body)">Ajouter une équipe</p>

            {{ form_start(newTeamForm, {attr: {class: 'config-teams-add-form'}}) }}
                <div class="season-form-field">
                    {{ form_label(newTeamForm.name) }}
                    {{ form_widget(newTeamForm.name) }}
                    {{ form_errors(newTeamForm.name) }}
                </div>
                <div class="season-form-field">
                    {{ form_label(newTeamForm.cotisation) }}
                    {{ form_widget(newTeamForm.cotisation) }}
                    {{ form_help(newTeamForm.cotisation) }}
                    {{ form_errors(newTeamForm.cotisation) }}
                </div>
                <div class="season-form-field">
                    {{ form_label(newTeamForm.categories) }}
                    {# Widget Symfony rendu caché — les coches sont gérées par le composant Alpine ci-dessous #}
                    <div style="display:none">{{ form_widget(newTeamForm.categories) }}</div>
                    {% include 'components/multi-select.html.twig' with {
                        ms_name: 'team_setup[categories][]',
                        ms_options: ms_opts,
                        ms_selected: [],
                        ms_placeholder: '— Aucune (ex : Loisirs) —'
                    } %}
                    <p class="config-teams-hint" style="margin-top:0.375rem">Assignation automatique à l'import. Laissez vide si non applicable.</p>
                    {{ form_errors(newTeamForm.categories) }}
                </div>
                <button type="submit" class="season-form-submit">Ajouter l'équipe</button>
            {{ form_end(newTeamForm) }}

        </div>

    </div>{# fin config-row #}

    {% endif %}

</div>
{% endblock %}
