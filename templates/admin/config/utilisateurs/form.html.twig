{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ title }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Utilisateurs', route: 'admin_users_list' },
    { label: title }
] } %}

<div class="users-form-page">

    {{ form_start(form, { attr: { class: 'users-form-card' } }) }}

        <h1 class="users-form-title">{{ title }}</h1>

        <hr class="users-form-divider">

        <div class="users-form-field">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="users-form-field">
            {{ form_label(form.plainPassword) }}
            {{ form_widget(form.plainPassword) }}
            {{ form_errors(form.plainPassword) }}
        </div>

        <hr class="users-form-divider">

        <div class="users-form-checkbox">
            {{ form_widget(form.isAdmin) }}
            {{ form_label(form.isAdmin) }}
            {{ form_errors(form.isAdmin) }}
        </div>

        <button type="submit" class="users-form-submit">Enregistrer</button>

    {{ form_end(form) }}

</div>
{% endblock %}
