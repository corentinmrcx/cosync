{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Utilisateurs{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Utilisateurs' }
] } %}

<div class="users-page">

    <div class="users-header">
        <h1 class="users-title">Utilisateurs</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nouvel utilisateur
        </a>
    </div>

    <div class="users-table-wrap">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    {% set user = ligne.user %}
                    <tr class="users-row">
                        <td class="users-td-email">
                            {{ user.email }}
                            {% if ligne.estSuperAdmin %}
                                <span class="users-badge-diag" title="Compte super-admin protégé">Super-admin</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="users-actions-cell">
                                {% if ligne.modifiable %}
                                    <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-secondary btn-sm">Modifier</a>
                                {% endif %}
                                {% if ligne.supprimable %}
                                    <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Supprimer cet utilisateur ?')">
                                            Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
