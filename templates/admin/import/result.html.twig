{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Résultat import{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: navbar_saison_label, route: 'admin_saison_dashboard' },
    { label: 'Effectif', route: 'admin_effectif_index' },
    { label: 'Import', route: 'admin_import_index' },
    { label: 'Résultat' }
] } %}

<div class="import-page">

    <div class="import-card">

        <div class="import-card-header">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            <h1 class="import-card-title">Résultat de l'import</h1>
        </div>

        {% if result.layoutLabel %}
            <div class="import-season-notice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                Format détecté : <strong>{{ result.layoutLabel }}</strong>
            </div>
        {% endif %}

        <div class="import-stats">
            <div class="import-stat import-stat-success">
                <span class="import-stat-value">{{ result.created }}</span>
                <span class="import-stat-label">Créés</span>
            </div>
            <div class="import-stat import-stat-info">
                <span class="import-stat-value">{{ result.updated }}</span>
                <span class="import-stat-label">Mis à jour</span>
            </div>
            {% if result.ignores > 0 %}
            <div class="import-stat import-stat-warning">
                <span class="import-stat-value">{{ result.ignores }}</span>
                <span class="import-stat-label">Écartés</span>
            </div>
            {% endif %}
            <div class="import-stat import-stat-danger">
                <span class="import-stat-value">{{ result.errors|length }}</span>
                <span class="import-stat-label">Erreurs</span>
            </div>
        </div>

        {# Lignes écartées d'après la colonne « Statut ». Le décompte est affiché même quand tout
           s'est bien passé : c'est ce qui permet de constater qu'un export non filtré a bien été
           rattrapé, plutôt que de le découvrir dans la liste des licenciés. #}
        {% if result.ignoresParStatut is not empty %}
            <div class="import-ignores">
                <p class="import-ignores-title">Lignes écartées d'après leur statut FootClubs</p>
                <ul class="import-ignores-list">
                    {% for libelle, nombre in result.ignoresParStatut %}
                        <li>
                            <strong>{{ nombre }}</strong> ligne{{ nombre > 1 ? 's' : '' }} au statut
                            « {{ libelle }} »
                            {%- if libelle in result.statutsInconnus %} — statut inconnu de CoSync{% endif -%}
                        </li>
                    {% endfor %}
                </ul>
                <p class="import-guide-note">
                    CoSync n'importe que les dossiers à partir de « En attente signature club » : avant, le
                    licencié n'a pas encore rempli sa part côté FFF et rien ne dit qu'il rejoindra le club.
                    Ces lignes reviendront d'elles-mêmes au prochain import, une fois leur dossier avancé.
                </p>
                {% if result.statutsInconnus is not empty %}
                    <p class="import-ignores-alerte">
                        Un ou plusieurs statuts ci-dessus ne sont pas reconnus : l'export FootClubs a
                        probablement changé de libellés. Par précaution ces lignes n'ont pas été importées —
                        signalez-le avant de relancer l'import.
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {# Répartition par nature de licence : elle pilote les options de dotation proposées
           au licencié, une répartition aberrante doit sauter aux yeux dès l'import. #}
        <div class="import-stats">
            <div class="import-stat import-stat-info">
                <span class="import-stat-value">{{ result.nouveaux }}</span>
                <span class="import-stat-label">Nouveaux licenciés</span>
            </div>
            <div class="import-stat import-stat-info">
                <span class="import-stat-value">{{ result.renouvellements }}</span>
                <span class="import-stat-label">Renouvellements</span>
            </div>
            {% if result.natureInconnue > 0 %}
            <div class="import-stat import-stat-danger">
                <span class="import-stat-value">{{ result.natureInconnue }}</span>
                <span class="import-stat-label">Nature inconnue</span>
            </div>
            {% endif %}
        </div>

        {% if result.natureInconnue > 0 %}
            <p class="import-guide-note">
                La colonne « Nature » manque ou n'a pas été comprise pour {{ result.natureInconnue }} licencié(s).
                Sans elle, ils garderont le choix de leur dotation comme un renouvellement.
                Corrigez-les au besoin depuis la liste des licenciés, filtre « Nature ».
            </p>
        {% endif %}

        {% if result.created > 0 %}
            <p class="import-guide-note">
                Aucun mail n'est parti : un import ne prévient personne de lui-même. Affectez d'abord les
                équipes, puis envoyez les liens depuis
                <a href="{{ path('admin_licencies_send_links') }}">Joueurs → Envoyer les liens</a>.
            </p>
        {% endif %}

        {% if result.errors %}
            <div class="import-errors">
                <p class="import-errors-title">Détail des erreurs</p>
                <ul class="import-errors-list">
                    {% for error in result.errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if result.notices %}
            <div class="import-notices">
                <p class="import-notices-title">Signalements (sans action requise)</p>
                <ul class="import-notices-list">
                    {% for notice in result.notices %}
                        <li>{{ notice }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="import-actions">
            <a href="{{ path('admin_import_index') }}" class="import-btn-secondary">
                Nouvel import
            </a>
            <a href="{{ path('admin_licencies_list') }}" class="btn btn-primary btn-lg">
                Voir les licenciés
            </a>
        </div>

    </div>

</div>
{% endblock %}
