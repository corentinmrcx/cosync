{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Lien de la boutique{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Boutique', route: 'admin_boutique_index' },
    { label: 'Lien de la boutique' }
] } %}

<div class="season-form-page">

    {{ form_start(form, { attr: { class: 'season-form-card' } }) }}

        <h1 class="season-form-header">Lien de la boutique</h1>
        <p class="config-teams-intro">
            Affiché au licencié sur la page de confirmation de son inscription une fois la
            boutique ouverte, et envoyé par mail le jour où vous décidez de l'annoncer. Il
            appartient au club : il reste valable d'une saison à l'autre.
        </p>
        <hr class="season-form-divider">

        <div class="field">
            {{ form_label(form.boutiqueUrl) }}
            {{ form_widget(form.boutiqueUrl) }}
            {{ form_help(form.boutiqueUrl) }}
            {{ form_errors(form.boutiqueUrl) }}
        </div>

        {# Le lien enregistré, et non `club_boutique_url` : celui-ci se tait tant que la
           boutique n'est pas ouverte, alors qu'ici l'admin doit relire ce qu'il a préparé. #}
        {% if form.vars.data.boutiqueUrl %}
            <p class="config-teams-intro">
                Lien actuel :
                <a href="{{ form.vars.data.boutiqueUrl }}" target="_blank" rel="noopener noreferrer">{{ form.vars.data.boutiqueUrl }}</a>
            </p>
        {% endif %}

        <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>

    {{ form_end(form) }}

</div>
{% endblock %}
