{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — Utilisateurs{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Le club', route: 'admin_club_index' },
    { label: 'Utilisateurs' }
] } %}

<div class="users-page">

    <div class="users-header">
        <h1 class="users-title">Utilisateurs</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nouvel utilisateur
        </a>
    </div>

    <div class="table-wrapper table-cartes">
        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    {% set user = ligne.user %}
                    <tr class="users-row">
                        <td class="users-td-email carte-titre">
                            {{ user.email }}
                            {% if ligne.estSuperAdmin %}
                                <span class="users-badge-diag" title="Compte super-admin protégé">Super-admin</span>
                            {% endif %}
                        </td>
                        <td data-label="Rôles">
                            {% if ligne.estSuperAdmin %}
                                <span class="users-role-puce">Tous les droits</span>
                            {% elseif user.rolesAcces|length > 0 %}
                                <div class="users-roles-liste">
                                    {% for role in user.rolesAcces %}
                                        <span class="users-role-puce">{{ role.nom }}</span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                {# Un compte sans rôle se connecte sur une application vide : le dire
                                   ici évite de chercher longtemps pourquoi la personne « ne voit rien ». #}
                                <span class="users-roles-aucun">Aucun rôle — ce compte ne voit rien</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="users-actions-cell">
                                {% if isDiag %}
                                    {% if not ligne.estSuperAdmin %}
                                        <form method="post" action="{{ path('admin_users_super_admin', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('super_admin_user_' ~ user.id) }}">
                                            <input type="hidden" name="valeur" value="1">
                                            <button type="submit" class="btn btn-secondary btn-sm"
                                                    onclick="return confirm('Donner tous les droits à {{ user.email|e('js') }} ?')">
                                                Passer super-admin
                                            </button>
                                        </form>
                                    {% elseif ligne.superAdminRetirable %}
                                        <form method="post" action="{{ path('admin_users_super_admin', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('super_admin_user_' ~ user.id) }}">
                                            <input type="hidden" name="valeur" value="0">
                                            <button type="submit" class="btn btn-secondary btn-sm"
                                                    onclick="return confirm('Retirer le statut de super-admin à {{ user.email|e('js') }} ?')">
                                                Retirer le super-admin
                                            </button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                                {% if ligne.modifiable %}
                                    <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-secondary btn-sm">Modifier</a>
                                {% endif %}
                                {% if ligne.supprimable %}
                                    <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Supprimer cet utilisateur ?')">
                                            Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
