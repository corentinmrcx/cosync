{% extends 'admin/layout.html.twig' %}

{% block title %}CoSync — {{ title }}{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Le club', route: 'admin_club_index' },
    { label: 'Utilisateurs', route: 'admin_users_list' },
    { label: title }
] } %}

<div class="users-form-page">

    {{ form_start(form, { attr: { class: 'users-form-card' } }) }}

        <h1 class="users-form-title">{{ title }}</h1>

        <hr class="users-form-divider">

        <div class="field">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            {{ form_errors(form.email) }}
        </div>

        {% if form.plainPassword is defined %}
            <div class="field">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword) }}
                {{ form_errors(form.plainPassword) }}
            </div>
        {% elseif user is not null %}
            <p class="users-form-password-notice">
                Le mot de passe d'un super-admin ne se change pas ici : il le fait depuis « Mon profil ».
            </p>
        {% endif %}

        <div class="field">
            {{ form_label(form.rolesAcces) }}
            <p class="users-form-roles-aide">
                Les droits de plusieurs rôles s'additionnent. Un compte sans aucun rôle se
                connecte, mais ne voit rien.
            </p>
            {{ form_widget(form.rolesAcces) }}
            {{ form_errors(form.rolesAcces) }}
        </div>

        <div class="users-form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Enregistrer</button>
            <a href="{{ path('admin_users_list') }}" class="btn btn-ghost btn-lg">Annuler</a>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
