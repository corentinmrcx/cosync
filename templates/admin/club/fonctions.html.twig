{% extends 'admin/layout.html.twig' %}
{% import 'components/_icon.html.twig' as ui %}

{% block title %}CoSync — Fonctions du club{% endblock %}

{% block content %}
{% include 'components/breadcrumb.html.twig' with { items: [
    { label: 'Tableau de bord', route: 'admin_dashboard' },
    { label: 'Le club', route: 'admin_club_index' },
    { label: 'Fonctions' }
] } %}

<div class="dot-page" x-data="{ editingId: null, adding: false }">

    <div class="dot-header">
        <div>
            <h1 class="dot-title">Fonctions du club</h1>
            <p class="dot-subtitle">
                Ce que chacun fait, tel qu'on le déclare à la mairie ou au conseil
                d'administration. À ne pas confondre avec le rôle d'un dirigeant, qui décide
                de son kit et des documents qu'il signe : trois personnes peuvent être au
                bureau du foot sans qu'aucune ne soit responsable de la section. Une fiche
                en porte autant qu'il en faut.
            </p>
        </div>
        <div class="dot-header-actions">
            {# Refermer un formulaire ne détruit rien : le bouton quitte le registre de l'action
               attendue pour celui du retrait discret. #}
            <button type="button" class="btn" :class="adding ? 'btn-ghost' : 'btn-primary'" @click="adding = !adding">
                <span x-text="adding ? 'Annuler' : '+ Nouvelle fonction'"></span>
            </button>
        </div>
    </div>

    <div class="dot-card" x-data="listeTriable">

        <div class="dot-card-header">
            <h2 class="dot-card-title">Référentiel</h2>
            <span class="dot-card-count">{{ fonctions|length }}</span>
        </div>

        <form method="post"
              action="{{ path('admin_fonctions_new') }}"
              class="dot-affect-form fonction-form"
              x-show="adding"
              x-cloak>
            <input type="hidden" name="_token" value="{{ csrf_token('fonction_nouvelle') }}">
            <input type="text" name="libelle" class="field-input" placeholder="Libellé (ex : Coordinateur général)" maxlength="120" required>
            <label class="fonction-checkbox">
                <input type="checkbox" name="porte_equipe" value="1">
                <span>Suivi du nom de l'équipe</span>
            </label>
            <button type="submit" class="btn btn-primary">Ajouter</button>
        </form>

        {% if fonctions is empty %}
            <p class="dot-empty">Aucune fonction.</p>
        {% else %}
            {% if fonctions|length > 1 %}
                <p class="triable-aide">{{ ui.icon('grip', 14) }} Glissez une fonction par sa poignée pour changer l'ordre d'affichage.</p>
            {% endif %}

            <form method="post"
                  action="{{ path('admin_fonctions_reorder') }}"
                  x-ref="formulaire"
                  data-ordre-initial="{{ fonctions|map(f => f.id)|join(',') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('fonctions_reorder') }}">
                <span x-ref="ordre"></span>
            </form>

            <ul class="dot-list triable-liste"
                x-ref="liste"
                @pointermove.window="deplacer($event)"
                @pointerup.window="terminer()"
                @pointercancel.window="terminer()">
                {% for fonction in fonctions %}
                    {% set portee = utilisations[fonction.id]|default(0) %}
                    <li class="dot-list-item triable-ligne" data-triable="{{ fonction.id }}">
                        <span class="triable-poignee"
                              title="Déplacer"
                              @pointerdown="saisir($event)"
                              aria-hidden="true">{{ ui.icon('grip', 16) }}</span>

                        <div x-show="editingId !== {{ fonction.id }}" class="dot-list-main">
                            <span class="dot-list-name">{{ fonction.libelle }}</span>
                            <span class="fonction-meta">
                                {% if fonction.porteEquipe %}
                                    <span class="fonction-badge-equipe">+ nom de l'équipe</span> ·
                                {% endif %}
                                {{ portee }} dirigeant{{ portee > 1 ? 's' }}
                            </span>
                        </div>
                        <div x-show="editingId !== {{ fonction.id }}" class="dot-list-actions">
                            <button type="button" class="btn btn-secondary btn-sm" @click="editingId = {{ fonction.id }}">Modifier</button>
                            {# Une fonction portée par quelqu'un ne se supprime plus : elle disparaîtrait
                               des fiches et du récapitulatif remis à la mairie. Le bouton reste, il dit
                               pourquoi c'est refusé. #}
                            {% if portee > 0 %}
                                <span class="btn btn-danger btn-sm fonction-btn-disabled"
                                      title="{{ portee }} dirigeant(s) la porte(nt) — suppression impossible">Supprimer</span>
                            {% else %}
                                {% include 'components/_form_suppression.html.twig' with {
                                    action: path('admin_fonctions_delete', {id: fonction.id}),
                                    jeton: 'fonction_supprimer_' ~ fonction.id,
                                    message: 'Supprimer la fonction ' ~ fonction.libelle ~ ' ?',
                                } only %}
                            {% endif %}
                        </div>

                        <form x-show="editingId === {{ fonction.id }}" x-cloak method="post"
                              action="{{ path('admin_fonctions_edit', {id: fonction.id}) }}" class="dot-affect-form fonction-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('fonction_modifier_' ~ fonction.id) }}">
                            <input type="text" name="libelle" class="field-input" value="{{ fonction.libelle }}" maxlength="120" required>
                            <label class="fonction-checkbox">
                                <input type="checkbox" name="porte_equipe" value="1" {{ fonction.porteEquipe ? 'checked' }}>
                                <span>Suivi du nom de l'équipe</span>
                            </label>
                            <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>
                            <button type="button" class="btn btn-ghost btn-sm" @click="editingId = null">Annuler</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

</div>
{% endblock %}
