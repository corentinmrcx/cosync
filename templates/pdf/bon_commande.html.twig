{# Le bon que le club envoie au fournisseur, et qu'il a sous les yeux au téléphone.

   Il ne fait qu'une chose : éviter de lister les quantités à la main. C'est le fournisseur
   qui éditera le devis — pas de coordonnées, pas de prix, pas de mentions : tout ça se
   retrouve sur son devis, et l'écrire ici ne ferait que le contredire.

   Un article, sa référence, sa quantité, les tailles dessous — même forme que l'écran qui
   l'a produit. À plat, le même carton y revenait six fois. #}
{% extends 'pdf/_layout.html.twig' %}

{% block titre %}Bon de commande{% endblock %}
{% block sous_titre %}{{ club_nom }}{% endblock %}

{% block styles %}
        .infos { margin-bottom: 8mm; font-size: 12px; }
        .infos p { margin: 0 0 1.5mm; }
        .infos strong { display: inline-block; width: 28mm; color: #555; font-weight: normal; }

        table.lignes { width: 100%; border-collapse: collapse; }
        table.lignes th {
            background: #f3f4f6;
            text-align: left;
            padding: 6px 8px;
            font-size: 11px;
            border-bottom: 1px solid #d1d5db;
        }
        table.lignes td { padding: 6px 8px; font-size: 11px; }

        /* La référence se recopie chez le fournisseur : lisible, mais elle ne prend pas le
           pas sur la désignation, qui reste ce qui identifie l'article. */
        .col-ref { width: 30mm; color: #6b7280; }
        .col-qte { width: 18mm; text-align: right; }
        table.lignes th.col-qte { text-align: right; }

        /* La ligne d'article ouvre le bloc ; le filet ne tombe qu'entre deux articles. */
        tr.article td { border-top: 1px solid #e5e7eb; padding-bottom: 2px; font-weight: 700; }
        tbody.groupe:first-of-type tr.article td { border-top: none; }
        tr.article .col-ref { font-weight: normal; }

        /* Les tailles : décalées sous leur article, la quantité au même fer. */
        tr.taille td { padding-top: 0; padding-bottom: 2px; }
        tr.taille td:first-child { padding-left: 10mm; }
        tr.groupe-fin td { padding-bottom: 6px; }

        tr.total td {
            background: #f3f4f6;
            font-weight: 700;
            border-top: 1px solid #d1d5db;
        }

        .edite { margin-top: 8mm; font-size: 10px; color: #777; }
{% endblock %}

{% block corps %}

<div class="infos">
    <p><strong>Fournisseur</strong> {{ commande.fournisseurLabel }}</p>
    <p><strong>Saison</strong> {{ commande.season.label }}</p>
    <p><strong>Référence</strong> CMD-{{ commande.id }}</p>
    <p><strong>Date</strong> {{ (commande.dateCommande ?? generatedAt)|date('d/m/Y') }}</p>
</div>

<table class="lignes">
    <thead>
        <tr>
            <th>Article</th>
            <th class="col-ref">Référence</th>
            <th class="col-qte">Quantité</th>
        </tr>
    </thead>
    {# Un tbody par article : DomPDF ne tient pas compte de `page-break-inside` sur un tbody,
       mais l'en-tête du tableau se répète et le détail reste lisible sous ses colonnes. #}
    {% for article in articles %}
        <tbody class="groupe">
            <tr class="article {{ article.detaille ? '' : 'groupe-fin' }}">
                <td>
                    {{ article.article.designation }}
                    {# Une seule déclinaison : sa taille se lit au ras du nom plutôt que sur
                       une ligne qui répéterait la même quantité. #}
                    {% if article.tailleUnique %} — {{ article.tailleUnique }}{% endif %}
                </td>
                <td class="col-ref">{{ article.article.refCatalogue ?: '—' }}</td>
                <td class="col-qte">{{ article.quantite }}</td>
            </tr>
            {% if article.detaille %}
                {% for taille in article.tailles %}
                    <tr class="taille {{ loop.last ? 'groupe-fin' : '' }}">
                        <td>{{ taille.etiquette }}</td>
                        <td class="col-ref"></td>
                        <td class="col-qte">{{ taille.quantite }}</td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    {% endfor %}
    <tbody>
        <tr class="total">
            <td>Total</td>
            <td class="col-ref"></td>
            <td class="col-qte">{{ commande.quantiteTotale }} pièces</td>
        </tr>
    </tbody>
</table>

<p class="edite">Document généré le {{ generatedAt|date('d/m/Y à H:i') }} — {{ club_nom }}.</p>

{% endblock %}
