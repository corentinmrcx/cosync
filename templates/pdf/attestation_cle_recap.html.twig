{% extends 'pdf/_layout.html.twig' %}

{% block titre %}Détenteurs des clés du local{% endblock %}
{% block sous_titre %}{{ club_nom }} — Saison {{ saisonLabel }}{% endblock %}

{% block styles %}
        table.lignes { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
        table.lignes th {
            background: #f3f4f6;
            text-align: left;
            padding: 6px 8px;
            font-size: 11px;
            border-bottom: 1px solid #d1d5db;
        }
        table.lignes td { padding: 6px 8px; border-bottom: 1px solid #e5e7eb; font-size: 11px; }

        .col-detenteur { width: 26%; }
        .col-fonction { width: 34%; }
        .col-cles { width: 8%; text-align: center; font-weight: 700; }
        .col-date { width: 16%; text-align: center; }
        .col-signe { width: 16%; text-align: center; font-weight: 700; }

        /* `table.lignes th` l'emporte en spécificité sur les classes de colonne : sans ces
           trois-là, les en-têtes restent à gauche au-dessus de valeurs centrées. */
        table.lignes th.col-cles,
        table.lignes th.col-date,
        table.lignes th.col-signe { text-align: center; }

        .oui { color: #15803d; }
        .non { color: #b91c1c; }
        .renouveler { color: #b45309; }
        .vide { padding: 14px 8px; color: #9aa1aa; font-style: italic; }
        .totaux { font-size: 11px; color: #555; }
        /* La date d'édition ferme le document : elle date ce qui précède, elle ne l'annonce pas. */
        .recap-edite { margin-top: 4mm; font-size: 10px; color: #777; }
{% endblock %}

{% block corps %}
    <table class="lignes">
        <thead>
            <tr>
                <th class="col-detenteur">Détenteur</th>
                <th class="col-fonction">Fonction dans le club</th>
                <th class="col-cles">Clés</th>
                <th class="col-date">Signée le</th>
                <th class="col-signe">Signée</th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="col-detenteur">{{ row.nom }} {{ row.prenom }}</td>
                    <td class="col-fonction">{{ row.fonction }}</td>
                    <td class="col-cles">{{ row.nbCles }}</td>
                    <td class="col-date">{{ row.signedAt ? row.signedAt|date('d/m/Y') : '—' }}</td>
                    <td class="col-signe {{ row.statutClass }}">{{ row.statutLabel }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="vide">Aucune clé n'est actuellement détenue pour cette saison.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if rows|length > 0 %}
        <p class="totaux">
            {{ rows|length }} détenteur{{ rows|length > 1 ? 's' }} ·
            {% set totalCles = 0 %}{% for row in rows %}{% set totalCles = totalCles + row.nbCles %}{% endfor %}
            {{ totalCles }} clé{{ totalCles > 1 ? 's' }} en circulation ·
            {% set signees = rows|filter(r => r.isSigned and not r.aRenouveler)|length %}
            {{ signees }} attestation{{ signees > 1 ? 's' }} signée{{ signees > 1 ? 's' }} et à jour
        </p>
    {% endif %}

    <p class="recap-edite">Édité le {{ generatedAt|date('d/m/Y à H:i') }}</p>
{% endblock %}
