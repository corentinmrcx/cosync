{% extends 'pdf/_layout.html.twig' %}

{% block titre %}Attestation de remise de clés{% endblock %}
{% block sous_titre %}Clés du local — {{ club_nom }} — Saison {{ season.label }}{% endblock %}

{% block styles %}
        .statement {
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 8mm;
            page-break-inside: avoid;
        }

        .statement .highlight { color: #ff0033; font-weight: 700; }
{% endblock %}

{% block entete %}
    {% if previewMode|default(false) %}{% include 'pdf/_bandeau_apercu.html.twig' %}{% endif %}
    {{ parent() }}
{% endblock %}

{% block corps %}
    {# Même ordre que l'écran de signature : l'engagement rédigé par le club se lit
       d'abord, la formule reprise du registre le conclut juste avant la signature. #}
    {% if season.attestationCleText %}
        <div class="content">
            {{ season.attestationCleText|raw }}
        </div>
    {% endif %}

    <p class="statement">
        Je soussigné·e <span class="highlight">{{ prenom }} {{ nom }}</span>, reconnais avoir reçu
        <span class="highlight">{{ nbCles }}</span> clé{{ nbCles > 1 ? 's' }} du local du
        {{ club_nom }}{% if remiseLe %} le <span class="highlight">{{ remiseLe|date('d/m/Y') }}</span>{% endif %},
        pour la saison <span class="highlight">{{ season.label }}</span>.
    </p>

    <div class="footer">
        <p class="footer-date">Soudron, le {{ signedAt|date('d/m/Y') }}</p>
        <div class="sign-label">Signature :</div>
        {% if previewMode|default(false) %}
            <p style="font-size:11px;color:#888;font-style:italic;">(Emplacement de la signature)</p>
        {% else %}
            <img class="sign-img" src="{{ signatureDataUrl }}" alt="Signature">
        {% endif %}
    </div>
{% endblock %}
