<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoSync — Connexion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    {{ encore_entry_link_tags('app') }}
</head>
<body>

<div class="login-page">

    <main class="login-main">
        <div class="login-card">

            <div class="login-card-header">
                <p class="login-card-title">CoSync</p>
            </div>

            <div class="login-card-body">

                {% if error %}
                    <div class="login-error">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('security_login') }}">

                    <div class="login-field">
                        <label for="email" class="login-label">Adresse e-mail</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="{{ last_username }}"
                            required
                            autofocus
                            autocomplete="email"
                            class="login-input"
                        >
                    </div>

                    <div class="login-field login-field--last">
                        <label for="password" class="login-label">Mot de passe</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            autocomplete="current-password"
                            class="login-input"
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="login-submit">
                        Se connecter
                    </button>

                </form>
            </div>

        </div>
    </main>

    <footer class="login-footer">
        <img src="{{ asset('images/logo/logo.png') }}"
             alt="Logo du club"
             class="login-footer-logo"
             onerror="this.style.display='none'">
    </footer>

</div>

</body>
</html>
