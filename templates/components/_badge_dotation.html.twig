{# Badge synthétique de l'état de la dotation d'un licencié.
   `dotation` = App\DTO\DotationAvancement ou null. #}
{% if dotation is not null %}
    <span class="badge-status badge-status-{{ dotation.statut.badgeVariant }}">
        <span class="badge-status-dot"></span>
        {{ dotation.label }}
    </span>
{% endif %}
