{#
  Composant combobox texte : suggestions depuis des valeurs existantes + saisie libre.

  Paramètres :
    name         (string)       Nom de l'input (soumis dans le form)
    label        (string)       Label affiché au-dessus
    suggestions  (array)        Valeurs proposées : soit des chaînes, soit des { value, label }
    current      (string|null)  Valeur pré-remplie (édition) — la value, pas le label
    placeholder  (string)       Placeholder de l'input
    required     (bool)         Rend le champ requis (défaut : false)
    allow_create (bool)         Autorise une valeur hors liste (défaut : true).
                                À false, le champ devient un select cherchable : ni « + Créer »,
                                ni suppression de suggestion, ni valeur libre.
#}
{% set combobox_allow_create = allow_create is not defined or allow_create %}

{# Le composant porte lui-même .field : le libellé et le champ s'espacent comme
   partout ailleurs, que l'appelant l'enveloppe ou non dans un .field. #}
<div class="field"
     x-data="textCombobox(
         {{ suggestions|json_encode }},
         {{ current is not null ? current|json_encode : 'null' }},
         {{ combobox_allow_create ? 'true' : 'false' }}
     )"
     @click.outside="close()">

    <label class="field-label">{{ label }}</label>

    <input type="hidden" name="{{ name }}" :value="value">

    <div class="combobox">
        <div class="combobox-input-wrap">
            <input type="text"
                   class="field-input combobox-input"
                   placeholder="{{ placeholder ?? '' }}"
                   x-model="query"
                   @focus="open = true"
                   @input="open = true"
                   autocomplete="off"
                   {% if required is defined and required %}required{% endif %}>
            <button type="button"
                    class="combobox-clear"
                    x-show="query !== ''"
                    @click="clear()"
                    tabindex="-1"
                    title="Effacer">×</button>
        </div>

        <div class="combobox-dropdown" x-show="open && (filtered.length > 0 || showCreate || showEmpty)" x-cloak>
            <template x-for="option in filtered" :key="option.value">
                <div class="combobox-option-row">
                    <button type="button"
                            class="combobox-option"
                            :class="value === option.value ? 'combobox-option-selected' : ''"
                            @mousedown.prevent="select(option)"
                            x-text="option.label">
                    </button>
                    <button type="button"
                            class="combobox-option-delete"
                            x-show="allowCreate"
                            @mousedown.prevent="removeSuggestion(option)"
                            title="Supprimer cette suggestion">×</button>
                </div>
            </template>
            <template x-if="showEmpty">
                <div class="combobox-empty">Aucun résultat</div>
            </template>
            <template x-if="showCreate">
                <button type="button"
                        class="combobox-create"
                        @mousedown.prevent="open = false">
                    + Créer « <span x-text="query.trim()"></span> »
                </button>
            </template>
        </div>
    </div>
</div>
