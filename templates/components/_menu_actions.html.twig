{#
  Menu « ⋯ » d'un en-tête : l'action du moment reste en clair à côté du titre, les gestes rares
  se rangent ici. Le balisage se relisait à deux endroits (fiche d'un licencié, registre des
  clés) et divergeait à chaque retouche — il n'existe plus qu'ici.

  S'emploie en `embed`, le contenu du panneau dans le bloc `items` :

      {% embed 'components/_menu_actions.html.twig' with { label: 'Autres sorties' } %}
          {% block items %}
              <a href="…" class="fiche-menu-item">…</a>
          {% endblock %}
      {% endembed %}

  Ne couvre pas le menu d'une ligne de tableau : celui-là s'ancre en position fixe pour
  échapper à l'`overflow-x` du `.table-wrapper` et porte son propre `menuLigne()`
  (`admin/dotations/_menu_ligne.html.twig`).

  `label` (string) — ce que lit un lecteur d'écran sur le déclencheur.
#}
<div class="fiche-menu"
     x-data="{ ouvert: false }"
     @click.outside="ouvert = false"
     @keydown.escape.window="ouvert = false">
    {# Voile du panneau en bas d'écran (téléphone) : sans lui, on ne saurait pas comment
       refermer la feuille autrement qu'en visant le bouton. Invisible au-dessus de 640 px,
       où le menu reste un simple déroulant. #}
    <div class="fiche-menu-voile"
         x-show="ouvert"
         x-transition.opacity
         @click="ouvert = false"
         x-cloak></div>

    <button type="button"
            class="btn btn-secondary fiche-menu-declencheur"
            @click="ouvert = !ouvert"
            :aria-expanded="ouvert"
            aria-haspopup="true"
            aria-label="{{ label|default('Autres actions') }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
        </svg>
    </button>

    <div class="fiche-menu-panneau"
         x-show="ouvert"
         x-transition:enter="fiche-menu-entre"
         x-transition:enter-start="fiche-menu-cache"
         x-transition:enter-end="fiche-menu-visible"
         x-transition:leave="fiche-menu-sort"
         x-transition:leave-start="fiche-menu-visible"
         x-transition:leave-end="fiche-menu-cache"
         x-cloak>
        {% block items %}{% endblock %}
    </div>
</div>
