{# Carte d'accès d'un tableau de bord.

   Trois formes selon ce qu'on lui passe :
     route       → un lien
     form_action → un bouton de formulaire POST (avec form_fields pour les champs cachés),
                   nécessaire quand ouvrir la carte change un état côté serveur
     ni l'un ni l'autre → une carte inerte (hub-card-disabled) #}

{% set contenu %}
    <span class="hub-card-icon">
        {% if icon == 'users' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="var(--color-text-base)">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
        {% elseif icon == 'box' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
        {% elseif icon == 'shirt' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 2a3 3 0 0 1-6 0L4 4 2 8l3.5 2v11h13V10L22 8l-2-4z"/>
            </svg>
        {% elseif icon == 'ruler' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0z"/>
                <path d="M8.5 6.5l2-2"/><path d="M11.5 9.5l2-2"/><path d="M14.5 12.5l2-2"/><path d="M17.5 15.5l2-2"/>
            </svg>
        {% elseif icon == 'import' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <polyline points="8 12 12 16 16 12"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
            </svg>
        {% elseif icon == 'wallet' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <path d="M16 13a1 1 0 1 0 2 0 1 1 0 0 0-2 0"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
        {% elseif icon == 'shield' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
        {% elseif icon == 'book' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
        {% elseif icon == 'key' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3"/>
            </svg>
        {% elseif icon == 'calendar' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
        {% elseif icon == 'bank' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 10l9-6 9 6"/><path d="M4 10v10"/><path d="M20 10v10"/>
                <path d="M8 20v-6"/><path d="M12 20v-6"/><path d="M16 20v-6"/>
                <line x1="2" y1="20" x2="22" y2="20"/>
            </svg>
        {% elseif icon == 'tag' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
        {% elseif icon == 'plus' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
        {% elseif icon == 'cart' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
                <path d="M2 3h2.5l2.6 12.1a1.5 1.5 0 0 0 1.47 1.19h8.96a1.5 1.5 0 0 0 1.47-1.19L21 7H5.2"/>
            </svg>
        {% elseif icon == 'gear' %}
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-base)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        {% endif %}
    </span>

    <span class="hub-card-label">{{ label }}</span>
    {% if badge is defined and badge %}<span class="hub-card-badge">{{ badge }}</span>{% endif %}
    {% if sub is defined and sub %}<span class="hub-card-sub">{{ sub }}</span>{% endif %}
{% endset %}

{% if form_action is defined and form_action %}
    <form method="post" action="{{ form_action }}" class="hub-card-form">
        {% for nom, valeur in form_fields ?? {} %}
            <input type="hidden" name="{{ nom }}" value="{{ valeur }}">
        {% endfor %}
        <button type="submit" class="hub-card{{ current is defined and current ? ' hub-card-current' : '' }}">{{ contenu }}</button>
    </form>
{% elseif route is defined and route %}
    <a href="{{ path(route, route_params ?? {}) }}" class="hub-card">{{ contenu }}</a>
{% else %}
    <div class="hub-card hub-card-disabled">{{ contenu }}</div>
{% endif %}
