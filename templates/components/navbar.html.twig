<header class="navbar">

    <a href="{{ path('admin_dashboard') }}" class="navbar-brand">
        <span class="navbar-brand-name">CoSync</span>
    </a>

    <div class="navbar-hamburger" x-data="{ open: false }" @click.outside="open = false">

        <button class="navbar-hamburger-btn" @click="open = !open" type="button" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="3" y1="6"  x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>

        <div class="navbar-dropdown" x-show="open" x-cloak>

            <div class="navbar-dropdown-section">
                <p class="navbar-dropdown-label">Saison</p>
                <div class="navbar-season-select-wrap">
                    <select class="navbar-season-select"
                            @change="window.location.href = $event.target.value">
                        {% for season in navbar_seasons %}
                            <option value="{{ path('admin_seasons_switch', {id: season.id}) }}"
                                    {{ navbar_current_season and season.id == navbar_current_season.id ? 'selected' : '' }}>
                                {{ season.label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <a href="{{ path('admin_seasons_new') }}" class="navbar-dropdown-item navbar-dropdown-item-new-season">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    Nouvelle saison
                </a>
            </div>

            <div class="navbar-dropdown-divider"></div>

            <div class="navbar-dropdown-section">
                <p class="navbar-dropdown-label">Gestion</p>
                <a href="{{ path('admin_licencies_list') }}" class="navbar-dropdown-item">Licenciés</a>
                <a href="{{ path('admin_dirigeants_list') }}" class="navbar-dropdown-item">Dirigeants</a>
            </div>

            <div class="navbar-dropdown-divider"></div>

            <div class="navbar-dropdown-section">
                <p class="navbar-dropdown-label">Administration</p>
                <a href="{{ path('admin_users_list') }}" class="navbar-dropdown-item">Utilisateurs</a>
                <a href="{{ path('admin_diag_index') }}" class="navbar-dropdown-item">Diagnostic</a>
                <span class="navbar-dropdown-item navbar-dropdown-item-disabled">Catégories FFF</span>
            </div>

            <div class="navbar-dropdown-divider"></div>

            <div class="navbar-dropdown-section">
                <a href="{{ path('admin_profile') }}" class="navbar-dropdown-item">Mon profil</a>
                <a href="{{ path('security_logout') }}" class="navbar-dropdown-item navbar-dropdown-item-danger">
                    Déconnexion
                </a>
            </div>

        </div>
    </div>

</header>
