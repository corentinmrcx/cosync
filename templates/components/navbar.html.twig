<header class="navbar">

    <a href="{{ path('admin_dashboard') }}" class="navbar-brand">
        <span class="navbar-brand-name">CoSync</span>
    </a>

    {# La saison de travail est rappelée par le fil d'Ariane de chaque page de saison :
       la répéter ici la ferait aussi apparaître sur les écrans du club, où aucune saison
       ne s'applique. #}

    <div class="navbar-hamburger" x-data="{ open: false }" @click.outside="open = false">

        <button class="navbar-hamburger-btn" @click="open = !open" type="button" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="3" y1="6"  x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>

        <div class="navbar-dropdown" x-show="open" x-cloak>

            <div class="navbar-dropdown-section">
                <a href="{{ path('admin_seasons_index') }}" class="navbar-dropdown-item">Saisons</a>
                {% if is_granted('club.configurer') or is_granted('utilisateur.gerer') %}
                    <a href="{{ path('admin_club_index') }}" class="navbar-dropdown-item">Le club</a>
                {% endif %}
            </div>

            <div class="navbar-dropdown-divider"></div>

            <div class="navbar-dropdown-section">
                {% if is_granted('diagnostic.acceder') %}
                    <a href="{{ path('admin_diag_index') }}" class="navbar-dropdown-item">Diagnostic</a>
                {% endif %}
                <a href="{{ path('admin_documentation') }}" class="navbar-dropdown-item">Documentation</a>
            </div>

            <div class="navbar-dropdown-divider"></div>

            <div class="navbar-dropdown-section">
                <a href="{{ path('admin_profile') }}" class="navbar-dropdown-item">Mon profil</a>
                <a href="{{ path('security_logout') }}" class="navbar-dropdown-item navbar-dropdown-item-danger">
                    Déconnexion
                </a>
            </div>

        </div>
    </div>

</header>
