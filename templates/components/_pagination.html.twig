{#
  Pagination d'une liste — un seul balisage pour tous les écrans qui paginent.

  Trois listes en avaient chacune le sien, avec trois tailles de bouton et deux façons
  de marquer la page courante : la même mécanique se relisait à trois endroits et
  divergeait à chaque retouche.

  Au-delà de quelques pages, les numéros sont **fenêtrés** (1 … 7 8 [9] 10 11 … 42) :
  tout afficher débordait de la largeur du téléphone dès la vingtième page.

  Paramètres attendus :
    route (string)  — la route de la liste
    page (int)      — page courante, 1-indexée
    pages (int)     — nombre total de pages
    params (hash)   — paramètres à conserver dans les liens (filtres, recherche).
                      Défaut : la query string courante.
#}
{% if pages > 1 %}
    {% set params = params ?? app.request.query.all %}
    {% set fenetre = 2 %}
    {% set debut = max(1, page - fenetre) %}
    {% set fin = min(pages, page + fenetre) %}

    <nav class="pagination" aria-label="Pagination">
        {% if page > 1 %}
            <a href="{{ path(route, params|merge({page: page - 1})) }}"
               class="pagination-lien" rel="prev" aria-label="Page précédente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </a>
        {% endif %}

        {% if debut > 1 %}
            <a href="{{ path(route, params|merge({page: 1})) }}" class="pagination-lien">1</a>
            {% if debut > 2 %}<span class="pagination-ellipse">…</span>{% endif %}
        {% endif %}

        {% for p in debut..fin %}
            {% if p == page %}
                <span class="pagination-lien pagination-lien-actif" aria-current="page">{{ p }}</span>
            {% else %}
                <a href="{{ path(route, params|merge({page: p})) }}" class="pagination-lien">{{ p }}</a>
            {% endif %}
        {% endfor %}

        {% if fin < pages %}
            {% if fin < pages - 1 %}<span class="pagination-ellipse">…</span>{% endif %}
            <a href="{{ path(route, params|merge({page: pages})) }}" class="pagination-lien">{{ pages }}</a>
        {% endif %}

        {% if page < pages %}
            <a href="{{ path(route, params|merge({page: page + 1})) }}"
               class="pagination-lien" rel="next" aria-label="Page suivante">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
        {% endif %}
    </nav>
{% endif %}
