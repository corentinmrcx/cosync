{% extends 'email/_layout.html.twig' %}

{% block sujet %}Votre cotisation reste à régler — {{ club_nom }}{% endblock %}

{% block corps %}
    {% set intentionValues = intentions|map(m => m.value) %}
    {% set aRemettreAuLocal = intentionValues|filter(v => v in ['cheque', 'especes', 'pass_sport', 'autre', 'caf', 'ancv']) %}
    {% set titulaire = club_rib.titulaireCompte|default(club_nom) %}

    <tr>
        <td style="padding: 44px 40px 8px;" class="px">
            <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                Cotisation · Saison {{ licencie.season.label }}
            </p>
            <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                Il reste la cotisation
            </h1>
            <p style="margin: 0 0 14px; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                {% if licencie.category.isJeune %}
                    Le dossier de <strong style="color: {{ c.texteFort }};">{{ licencie.prenom }}</strong> est complet,
                    documents signés compris. Merci !
                {% else %}
                    Votre dossier est complet, documents signés compris. Merci !
                {% endif %}
                Le club n'a en revanche pas encore enregistré le règlement de la cotisation.
            </p>
        </td>
    </tr>

    {# — Montant dû — #}
    <tr>
        <td style="padding: 8px 40px 0;" class="px">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                   style="background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb;">
                <tr>
                    <td style="padding: 18px 24px;">
                        <p style="margin: 0; font-size: 13px; color: #6b7280;">Montant de la cotisation</p>
                        <p style="margin: 4px 0 0; font-size: 26px; font-weight: 800; color: {{ c.texteFort }};">{{ montant }} €</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>

    {# — Instructions reprises du mode déclaré à l'inscription : la relance rappelle ce que
         la personne avait choisi, elle ne lui redemande pas de choisir. — #}
    {% if 'virement' in intentionValues and club_rib.accepteVirement %}
        <tr>
            <td style="padding: 20px 40px 0;" class="px">
                <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: {{ c.texteFort }};">Régler par virement</p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe;">
                    <tr>
                        <td style="padding: 18px 24px; font-size: 14px; line-height: 1.8; color: {{ c.texteCourant }};">
                            IBAN : <strong style="color: {{ c.texteFort }};">{{ club_rib.iban }}</strong><br>
                            {% if club_rib.bic %}
                                BIC : <strong style="color: {{ c.texteFort }};">{{ club_rib.bic }}</strong><br>
                            {% endif %}
                            Titulaire : <strong style="color: {{ c.texteFort }};">{{ titulaire }}</strong><br>
                            Libellé à indiquer : <strong style="color: {{ c.texteFort }};">{{ libelleVirement }}</strong>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    {% endif %}

    {% if aRemettreAuLocal is not empty %}
        <tr>
            <td style="padding: 20px 40px 0;" class="px">
                <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: {{ c.texteFort }};">
                    {{ intentions|filter(m => m.value in aRemettreAuLocal)|map(m => m.label())|join(', ') }}
                    {%- if 'autre' in aRemettreAuLocal and precisionAutre %} ({{ precisionAutre }}){% endif %}
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background: #fffbeb; border-radius: 10px; border: 1px solid #fde68a;">
                    <tr>
                        <td style="padding: 18px 24px; font-size: 14px; line-height: 1.7; color: {{ c.texteCourant }};">
                            À remettre à un dirigeant du club ou lors d'une permanence.
                            {% if 'cheque' in intentionValues %}
                                <br>Chèque à l'ordre de <strong style="color: {{ c.texteFort }};">{{ titulaire }}</strong>.
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    {% endif %}

    {# CTA vers la page de confirmation, qui porte le bouton de paiement en ligne.
       Jamais vers checkout_start : cette route GET crée une intention chez HelloAsso,
       qu'un client mail préchargeant les liens déclencherait à vide.

       Le libellé annonce ce que le clic fait vraiment — un paiement par carte — et non
       l'intention générale : qui règle par chèque n'a rien à faire de ce bouton, il a ses
       instructions au-dessus. #}
    {% include 'email/_bouton.html.twig' with {
        url: url,
        libelle: 'Payer en ligne →',
        note: 'Paiement par carte, traité par HelloAsso. Aucune donnée bancaire ne transite par le club.',
    } %}

    {# Un paiement remis au local peut n'avoir pas encore été saisi : le mail ne doit jamais
       accuser quelqu'un d'avoir oublié de payer. #}
    <tr>
        <td style="padding: 8px 40px 36px;" class="px">
            <p style="margin: 0; font-size: 15px; line-height: 1.7; color: {{ c.texteCourant }};">
                Si vous avez déjà réglé, ce message a pu se croiser avec l'enregistrement de
                votre paiement : merci de ne pas en tenir compte, ou de nous répondre pour
                qu'on vérifie.<br>
                <strong style="color: {{ c.texteFort }};">L'équipe du {{ club_nom }}</strong>
            </p>
        </td>
    </tr>
{% endblock %}
