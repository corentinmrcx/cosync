{% extends 'email/_layout.html.twig' %}

{% block sujet %}Un document à signer — {{ club_nom }}{% endblock %}

{% block corps %}
    <tr>
        <td style="padding: 44px 40px 8px;" class="px">
            <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                Dossier · Saison {{ licencie.season.label }}
            </p>
            <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                Bonjour, un document à signer
            </h1>
            <p style="margin: 0 0 14px; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                {% if licencie.category.isJeune %}
                    Le dossier de {{ licencie.prenom }} est complet, mais le club a ajouté un document
                    depuis son inscription.
                {% else %}
                    Votre dossier est complet, mais le club a ajouté un document depuis votre inscription.
                {% endif %}
                Il reste à en prendre connaissance et à le signer.
            </p>
        </td>
    </tr>

    {% include 'email/_bouton.html.twig' with {
        url: url,
        libelle: 'Lire et signer →',
        note: 'Lien personnel — valable 30 jours, ne le partagez pas.',
    } %}
{% endblock %}
