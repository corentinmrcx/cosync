{# Bouton d'action d'un mail. `url` et `libelle` requis, `note` affichée en dessous. #}
<tr>
    <td align="center" style="padding: 32px 40px 8px;" class="px">
        <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
                <td style="border-radius: 9px; background: {{ c.primaire }};">
                    <a href="{{ url }}" class="btn-cta"
                       style="display: inline-block; background: {{ c.primaire }}; color: {{ c.texteInverse }}; font-size: 16px; font-weight: 800; padding: 16px 28px; border-radius: 9px; letter-spacing: .3px; white-space: nowrap;">
                        {{ libelle }}
                    </a>
                </td>
            </tr>
        </table>
        {% if note is defined %}
            <p style="margin: 16px 0 0; font-size: 13px; color: {{ c.texteDiscret }};">{{ note }}</p>
        {% endif %}
    </td>
</tr>
<tr>
    <td style="padding: 24px 40px 36px;" class="px">
        <p style="margin: 0; font-size: 13px; line-height: 1.6; color: {{ c.texteDiscret }};">
            Le bouton ne fonctionne pas ? Copiez ce lien dans votre navigateur :<br>
            <a href="{{ url }}" style="color: {{ c.primaire }}; font-weight: 600; word-break: break-all;">{{ url }}</a>
        </p>
    </td>
</tr>
