{#
    Accusé de réception du formulaire d'inscription.

    Le bloc d'instructions dépend du/des mode(s) de paiement déclarés. Les coordonnées
    bancaires viennent de la saison (jamais codées en dur) ; seule la présentation est
    dupliquée depuis components/_coordonnees_bancaires.html.twig, les clients mail
    exigeant des styles inline.
#}
{% set intentionValues = intentions|map(m => m.value) %}
{% set aRemettreAuLocal = intentionValues|filter(v => v in ['cheque', 'especes', 'pass_sport', 'caf', 'ancv']) %}
{% set titulaire = licencie.season.titulaireCompte|default('Foyer de Soudron') %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Inscription bien reçue — Foyer de Soudron</title>
    <style>
        body { margin: 0; padding: 0; background: #ebedf0; -webkit-font-smoothing: antialiased; }
        a { text-decoration: none; }
        @media (max-width: 620px) {
            .container { width: 100% !important; }
            .px { padding-left: 28px !important; padding-right: 28px !important; }
            .h1 { font-size: 25px !important; }
        }
    </style>
</head>
<body>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #ebedf0; font-family: Arial, sans-serif;">
    <tr>
        <td align="center" style="padding: 40px 16px;">

            <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0"
                   style="width: 600px; max-width: 600px; background: #ffffff; border-radius: 14px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,.08);">

                {# — Bandeau rouge — #}
                <tr>
                    <td style="background: #ff3131; padding: 30px 40px;" class="px">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="vertical-align: middle;">
                                    <span style="color: #ffffff; font-size: 22px; font-weight: 900; letter-spacing: 2px;">CoSync</span>
                                </td>
                                <td align="right" style="vertical-align: middle;">
                                    <img src="{{ absolute_url(asset('images/logo/logo.png')) }}"
                                         alt="Foyer de Soudron"
                                         width="48" height="48"
                                         style="display: block; width: 48px; height: 48px; object-fit: contain;">
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                {# — Hero — #}
                <tr>
                    <td style="padding: 44px 40px 8px;" class="px">
                        <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #ff3131;">
                            Inscription · Saison {{ licencie.season.label }}
                        </p>
                        {% if licencie.category.isJeune %}
                            <h1 class="h1" style="margin: 0 0 6px; font-size: 30px; line-height: 1.2; font-weight: 800; color: #1f1f1f;">
                                Merci !
                            </h1>
                            <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #374151;">
                                Le dossier d'inscription de <strong style="color: #1f1f1f;">{{ licencie.prenom }}</strong>
                                a bien été enregistré, documents signés compris.
                            </p>
                        {% else %}
                            <h1 class="h1" style="margin: 0 0 6px; font-size: 30px; line-height: 1.2; font-weight: 800; color: #1f1f1f;">
                                Merci {{ licencie.prenom }} !
                            </h1>
                            <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #374151;">
                                Votre dossier d'inscription a bien été enregistré, documents signés compris.
                            </p>
                        {% endif %}
                    </td>
                </tr>

                {# — Montant dû — #}
                <tr>
                    <td style="padding: 28px 40px 0;" class="px">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                               style="background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb;">
                            <tr>
                                <td style="padding: 18px 24px;">
                                    <p style="margin: 0; font-size: 13px; color: #6b7280;">Montant de la cotisation</p>
                                    <p style="margin: 4px 0 0; font-size: 26px; font-weight: 800; color: #1f1f1f;">{{ montant }} €</p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                {# — Instructions de paiement, selon le mode déclaré — #}
                {% if 'virement' in intentionValues and licencie.season.accepteVirement %}
                    <tr>
                        <td style="padding: 20px 40px 0;" class="px">
                            <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: #1f1f1f;">Régler par virement</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                   style="background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe;">
                                <tr>
                                    <td style="padding: 18px 24px; font-size: 14px; line-height: 1.8; color: #374151;">
                                        IBAN : <strong style="color: #1f1f1f;">{{ licencie.season.iban }}</strong><br>
                                        {% if licencie.season.bic %}
                                            BIC : <strong style="color: #1f1f1f;">{{ licencie.season.bic }}</strong><br>
                                        {% endif %}
                                        Titulaire : <strong style="color: #1f1f1f;">{{ titulaire }}</strong><br>
                                        Libellé à indiquer : <strong style="color: #1f1f1f;">{{ libelleVirement }}</strong>
                                    </td>
                                </tr>
                            </table>
                            <p style="margin: 10px 0 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
                                Le libellé nous permet de rattacher votre virement à votre dossier : merci de le reprendre à l'identique.
                            </p>
                        </td>
                    </tr>
                {% endif %}

                {% if aRemettreAuLocal is not empty %}
                    <tr>
                        <td style="padding: 20px 40px 0;" class="px">
                            <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: #1f1f1f;">
                                {{ intentions|filter(m => m.value in aRemettreAuLocal)|map(m => m.label())|join(', ') }}
                            </p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                   style="background: #fffbeb; border-radius: 10px; border: 1px solid #fde68a;">
                                <tr>
                                    <td style="padding: 18px 24px; font-size: 14px; line-height: 1.7; color: #374151;">
                                        À remettre à un dirigeant du club ou lors d'une permanence.
                                        {% if 'cheque' in intentionValues %}
                                            <br>Chèque à l'ordre de <strong style="color: #1f1f1f;">{{ titulaire }}</strong>.
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                {% endif %}

                {% if 'cb_online' in intentionValues %}
                    <tr>
                        <td style="padding: 20px 40px 0;" class="px">
                            <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: #1f1f1f;">Paiement par carte</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                                   style="background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb;">
                                <tr>
                                    <td style="padding: 18px 24px; font-size: 14px; line-height: 1.7; color: #374151;">
                                        Si vous n'avez pas finalisé le paiement en ligne, vous pouvez le reprendre à tout
                                        moment depuis le bouton ci-dessous. Aucune donnée bancaire ne transite par le club :
                                        le paiement est traité par HelloAsso.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                {% endif %}

                {# — CTA : la page de confirmation, qui porte le bouton de paiement.
                     Surtout pas un lien vers checkout_start : cette route GET crée une intention
                     de paiement chez HelloAsso, qu'un client mail préchargeant les liens
                     déclencherait à vide. — #}
                <tr>
                    <td style="padding: 28px 40px 0;" class="px">
                        <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                                <td style="background: #ff3131; border-radius: 8px;">
                                    <a href="{{ url }}" style="display: inline-block; padding: 14px 28px; font-size: 15px; font-weight: 700; color: #ffffff;">
                                        Voir mon inscription
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                {# — Règle absolue du projet : jamais de licence annoncée payée sans encaissement — #}
                <tr>
                    <td style="padding: 24px 40px 8px;" class="px">
                        <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #374151;">
                            <strong style="color: #1f1f1f;">Votre inscription ne sera définitivement validée qu'à réception du paiement.</strong>
                            Vous recevrez un second mail de confirmation dès que ce sera le cas.
                        </p>
                    </td>
                </tr>

                {% if documentsJoints > 0 %}
                    <tr>
                        <td style="padding: 12px 40px 0;" class="px">
                            <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #6b7280;">
                                {{ documentsJoints > 1
                                    ? 'Vos documents signés sont joints à ce mail.'
                                    : 'Votre document signé est joint à ce mail.' }}
                                Une copie est archivée par le club.
                            </p>
                        </td>
                    </tr>
                {% endif %}

                <tr>
                    <td style="padding: 24px 40px 36px;" class="px">
                        <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #374151;">
                            À très bientôt sur les terrains !<br>
                            <strong style="color: #1f1f1f;">L'équipe du Foyer de Soudron</strong>
                        </p>
                    </td>
                </tr>

                {# — Pied de page sombre — #}
                <tr>
                    <td style="background: #1f1f1f; padding: 28px 40px;" class="px">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td>
                                    <p style="margin: 0 0 4px; font-size: 15px; font-weight: 800; color: #ffffff;">Foyer de Soudron</p>
                                    <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #9aa1aa;">
                                        Stade municipal · 51320 Soudron
                                    </p>
                                </td>
                                <td align="right" style="vertical-align: bottom;">
                                    <p style="margin: 0; font-size: 11px; color: #5b6068;">Propulsé par <a href="https://codepp.fr/" style="color: #ff3131; font-weight: 700; text-decoration: none;">Codepp</a></p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

            </table>

            {# — Sous-pied de page — #}
            <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width: 600px; max-width: 600px;">
                <tr>
                    <td align="center" style="padding: 20px 40px;">
                        <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #9aa1aa;">
                            Vous recevez cet email suite à votre inscription au Foyer de Soudron.<br>
                            Pour toute question, contactez le club directement.
                        </p>
                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>

</body>
</html>
