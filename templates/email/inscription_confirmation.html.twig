{% extends 'email/_layout.html.twig' %}

{% block sujet %}Inscription bien reçue — {{ club_nom }}{% endblock %}

{% block corps %}
    {% set intentionValues = intentions|map(m => m.value) %}
    {% set aRemettreAuLocal = intentionValues|filter(v => v in ['cheque', 'especes', 'pass_sport', 'caf', 'ancv']) %}
    {% set titulaire = licencie.season.titulaireCompte|default(club_nom) %}

    {# — Hero — #}
        <tr>
            <td style="padding: 44px 40px 8px;" class="px">
                <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                    Inscription · Saison {{ licencie.season.label }}
                </p>
                {% if licencie.category.isJeune %}
                    <h1 class="h1" style="margin: 0 0 6px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                        Merci !
                    </h1>
                    <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                        Le dossier d'inscription de <strong style="color: {{ c.texteFort }};">{{ licencie.prenom }}</strong>
                        a bien été enregistré, documents signés compris.
                    </p>
                {% else %}
                    <h1 class="h1" style="margin: 0 0 6px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                        Merci {{ licencie.prenom }} !
                    </h1>
                    <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                        Votre dossier d'inscription a bien été enregistré, documents signés compris.
                    </p>
                {% endif %}
            </td>
        </tr>

        {# — Montant dû — #}
        <tr>
            <td style="padding: 28px 40px 0;" class="px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb;">
                    <tr>
                        <td style="padding: 18px 24px;">
                            <p style="margin: 0; font-size: 13px; color: #6b7280;">Montant de la cotisation</p>
                            <p style="margin: 4px 0 0; font-size: 26px; font-weight: 800; color: {{ c.texteFort }};">{{ montant }} €</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        {# — Instructions de paiement, selon le mode déclaré — #}
        {% if 'virement' in intentionValues and licencie.season.accepteVirement %}
            <tr>
                <td style="padding: 20px 40px 0;" class="px">
                    <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: {{ c.texteFort }};">Régler par virement</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                           style="background: #eff6ff; border-radius: 10px; border: 1px solid #bfdbfe;">
                        <tr>
                            <td style="padding: 18px 24px; font-size: 14px; line-height: 1.8; color: {{ c.texteCourant }};">
                                IBAN : <strong style="color: {{ c.texteFort }};">{{ licencie.season.iban }}</strong><br>
                                {% if licencie.season.bic %}
                                    BIC : <strong style="color: {{ c.texteFort }};">{{ licencie.season.bic }}</strong><br>
                                {% endif %}
                                Titulaire : <strong style="color: {{ c.texteFort }};">{{ titulaire }}</strong><br>
                                Libellé à indiquer : <strong style="color: {{ c.texteFort }};">{{ libelleVirement }}</strong>
                            </td>
                        </tr>
                    </table>
                    <p style="margin: 10px 0 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
                        Le libellé nous permet de rattacher votre virement à votre dossier : merci de le reprendre à l'identique.
                    </p>
                </td>
            </tr>
        {% endif %}

        {% if aRemettreAuLocal is not empty %}
            <tr>
                <td style="padding: 20px 40px 0;" class="px">
                    <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: {{ c.texteFort }};">
                        {{ intentions|filter(m => m.value in aRemettreAuLocal)|map(m => m.label())|join(', ') }}
                    </p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                           style="background: #fffbeb; border-radius: 10px; border: 1px solid #fde68a;">
                        <tr>
                            <td style="padding: 18px 24px; font-size: 14px; line-height: 1.7; color: {{ c.texteCourant }};">
                                À remettre à un dirigeant du club ou lors d'une permanence.
                                {% if 'cheque' in intentionValues %}
                                    <br>Chèque à l'ordre de <strong style="color: {{ c.texteFort }};">{{ titulaire }}</strong>.
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        {% endif %}

        {% if 'cb_online' in intentionValues %}
            <tr>
                <td style="padding: 20px 40px 0;" class="px">
                    <p style="margin: 0 0 10px; font-size: 15px; font-weight: 700; color: {{ c.texteFort }};">Paiement par carte</p>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                           style="background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb;">
                        <tr>
                            <td style="padding: 18px 24px; font-size: 14px; line-height: 1.7; color: {{ c.texteCourant }};">
                                Si vous n'avez pas finalisé le paiement en ligne, vous pouvez le reprendre à tout
                                moment depuis le bouton ci-dessous. Aucune donnée bancaire ne transite par le club :
                                le paiement est traité par HelloAsso.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        {% endif %}

        {# — CTA : la page de confirmation, qui porte le bouton de paiement.
             Surtout pas un lien vers checkout_start : cette route GET crée une intention
             de paiement chez HelloAsso, qu'un client mail préchargeant les liens
             déclencherait à vide. — #}
        <tr>
            <td style="padding: 28px 40px 0;" class="px">
                <table role="presentation" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="background: {{ c.primaire }}; border-radius: 8px;">
                            <a href="{{ url }}" style="display: inline-block; padding: 14px 28px; font-size: 15px; font-weight: 700; color: {{ c.texteInverse }};">
                                Voir mon inscription
                            </a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        {# — Règle absolue du projet : jamais de licence annoncée payée sans encaissement — #}
        <tr>
            <td style="padding: 24px 40px 8px;" class="px">
                <p style="margin: 0; font-size: 15px; line-height: 1.7; color: {{ c.texteCourant }};">
                    <strong style="color: {{ c.texteFort }};">Votre inscription ne sera définitivement validée qu'à réception du paiement.</strong>
                    Vous recevrez un second mail de confirmation dès que ce sera le cas.
                </p>
            </td>
        </tr>

        {% if documentsJoints > 0 %}
            <tr>
                <td style="padding: 12px 40px 0;" class="px">
                    <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #6b7280;">
                        {{ documentsJoints > 1
                            ? 'Vos documents signés sont joints à ce mail.'
                            : 'Votre document signé est joint à ce mail.' }}
                        Une copie est archivée par le club.
                    </p>
                </td>
            </tr>
        {% endif %}

        <tr>
            <td style="padding: 24px 40px 36px;" class="px">
                <p style="margin: 0; font-size: 15px; line-height: 1.7; color: {{ c.texteCourant }};">
                    À très bientôt sur les terrains !<br>
                    <strong style="color: {{ c.texteFort }};">L'équipe du {{ club_nom }}</strong>
                </p>
            </td>
        </tr>
{% endblock %}
