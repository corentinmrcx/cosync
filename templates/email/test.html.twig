{% extends 'email/_layout.html.twig' %}

{% block sujet %}Test d'envoi — {{ club_nom }}{% endblock %}

{% block mention_legale %}Ce message est un test envoyé depuis l'espace de diagnostic.{% endblock %}

{% block corps %}
    <tr>
        <td style="padding: 44px 40px 36px;" class="px">
            <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                La configuration mail fonctionne
            </h1>
            <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                Si vous lisez ce message, CoSync sait envoyer des mails depuis cet environnement.
            </p>
        </td>
    </tr>
{% endblock %}
