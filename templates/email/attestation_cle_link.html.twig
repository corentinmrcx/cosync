{% extends 'email/_layout.html.twig' %}

{% block sujet %}Attestation de remise de clés à signer — {{ club_nom }}{% endblock %}

{% block mention_legale %}Vous recevez cet email car vous détenez des clés du local du {{ club_nom }}.{% endblock %}

{% block corps %}
    <tr>
        <td style="padding: 44px 40px 8px;" class="px">
            <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                Clés du club house · Saison {{ dirigeant.season.label }}
            </p>
            <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                Bonjour {{ dirigeant.prenom }},<br>attestez de la remise de vos clés
            </h1>
            <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                Vous détenez une ou plusieurs <strong style="color: {{ c.texteFort }};">clés du local communal</strong>.
                Le club vous demande de le confirmer par une signature électronique.
                Cela prend <strong style="color: {{ c.texteFort }};">moins d'une minute</strong>.
            </p>
        </td>
    </tr>

    {% include 'email/_bouton.html.twig' with {
        url: url,
        libelle: 'Signer l\'attestation →',
        note: 'Lien personnel — valable 30 jours, ne le partagez pas.',
    } %}
{% endblock %}
