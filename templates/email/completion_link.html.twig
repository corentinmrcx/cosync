{% extends 'email/_layout.html.twig' %}

{% block sujet %}Une précision à apporter à votre dossier — {{ club_nom }}{% endblock %}

{% block corps %}
    <tr>
        <td style="padding: 44px 40px 8px;" class="px">
            <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                Dossier · Saison {{ licencie.season.label }}
            </p>
            <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                Bonjour, une précision à apporter
            </h1>
            <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                {% if licencie.category.isJeune %}
                    Le dossier de {{ licencie.prenom }} est presque complet : il reste
                    quelques autorisations à confirmer.
                {% else %}
                    Votre dossier est presque complet : il reste quelques autorisations à confirmer.
                {% endif %}
                Cela prend <strong style="color: {{ c.texteFort }};">moins d'une minute</strong> — vous n'avez
                que les champs manquants à remplir.
            </p>
        </td>
    </tr>

    {% include 'email/_bouton.html.twig' with {
        url: url,
        libelle: 'Compléter les autorisations →',
        note: 'Lien personnel — valable 30 jours, ne le partagez pas.',
    } %}
{% endblock %}
