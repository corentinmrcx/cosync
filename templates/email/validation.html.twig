{% extends 'email/_layout.html.twig' %}

{% block sujet %}{% if licencie.category.isJeune %}Licence de {{ licencie.prenom }} validée{% else %}Votre licence est validée{% endif %} — {{ club_nom }}{% endblock %}

{% block corps %}
    {# — Hero — #}
        <tr>
            <td style="padding: 44px 40px 8px;" class="px">
                <p style="margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: {{ c.primaire }};">
                    Validation · Saison {{ licencie.season.label }}
                </p>
                {% if licencie.category.isJeune %}
                <h1 class="h1" style="margin: 0 0 6px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                    Bonjour,
                </h1>
                <p style="margin: 0 0 18px; font-size: 18px; font-weight: 700; color: {{ c.texteCourant }};">
                    Licence de {{ licencie.prenom }} validée !
                </p>
                <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                    Nous avons bien reçu le paiement de la cotisation de <strong style="color: {{ c.texteFort }};">{{ licencie.prenom }} {{ licencie.nom }}</strong>.
                    L'inscription au {{ club_nom }} pour la saison <strong style="color: {{ c.texteFort }};">{{ licencie.season.label }}</strong> est désormais <strong style="color: #22c55e;">complète et validée</strong>.
                </p>
                {% else %}
                <h1 class="h1" style="margin: 0 0 18px; font-size: 30px; line-height: 1.2; font-weight: 800; color: {{ c.texteFort }};">
                    Bonjour {{ licencie.prenom }},<br>votre licence est validée !
                </h1>
                <p style="margin: 0; font-size: 16px; line-height: 1.65; color: {{ c.texteCourant }};">
                    Nous avons bien reçu votre paiement. Votre inscription au {{ club_nom }} pour la saison <strong style="color: {{ c.texteFort }};">{{ licencie.season.label }}</strong> est désormais <strong style="color: #22c55e;">complète et validée</strong>.
                </p>
                {% endif %}
            </td>
        </tr>

        {# — Bloc confirmation visuelle — #}
        <tr>
            <td style="padding: 32px 40px 8px;" class="px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background: {{ c.succesBg }}; border-radius: 10px; border: 1px solid #bbf7d0;">
                    <tr>
                        <td style="padding: 20px 24px;">
                            <p style="margin: 0; font-size: 15px; font-weight: 700; color: #15803d;">✓ Dossier complet</p>
                            <p style="margin: 6px 0 0; font-size: 14px; color: #166534; line-height: 1.5;">
                                Formulaire rempli · Règlement signé · Paiement confirmé
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        {# — Message final — #}
        <tr>
            <td style="padding: 24px 40px 36px;" class="px">
                <p style="margin: 0; font-size: 15px; line-height: 1.7; color: {{ c.texteCourant }};">
                    À très bientôt sur les terrains !<br>
                    <strong style="color: {{ c.texteFort }};">L'équipe du {{ club_nom }}</strong>
                </p>
            </td>
        </tr>
{% endblock %}
